---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ProductCard from '../../components/ProductCard.astro';
import { productGroups, products } from '../../data/products';
---

<Base title="Все продукты · 3K Studio">
  <Nav />
  <PageHeader eyebrow="продукты" title="Все продукты" lead="Полная линейка форматов: сайты, Telegram, интеграции и поддержка." />
  <main class="products-page" data-bg="paper">
    <div class="wrap groups">
      {productGroups.map((group) => {
        const items = products.filter((product) => product.group === group.id);
        return (
          <section class="group" data-reveal>
            <div class="group-head">
              <h2 class="mono">{group.title}</h2>
              <p>{group.summary}</p>
            </div>
            <div class="grid">
              {items.map((item) => <ProductCard product={item} />)}
            </div>
          </section>
        );
      })}
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .products-page {
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 80px 0 100px;
  }

  .groups {
    display: grid;
    gap: 70px;
  }

  .group {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 34px;
    border-top: 2px solid rgb(23 21 15 / 0.2);
    padding-top: 30px;
  }

  .group-head {
    position: sticky;
    top: 34px;
    align-self: start;
  }

  .group-head h2.mono {
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .group-head p {
    margin: 16px 0 0;
    color: rgb(23 21 15 / 0.62);
    font-size: 15px;
    line-height: 1.55;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 900px) {
    .group,
    .grid {
      grid-template-columns: 1fr;
    }

    .group-head {
      position: static;
    }
  }
</style>
