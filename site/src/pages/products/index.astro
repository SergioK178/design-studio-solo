---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { briefHref, productGroups, products } from '../../data/products';

const groupNumber = (index: number) => String(index + 1).padStart(2, '0');
---

<Base title="Все решения · 3K Studio">
  <Nav />
  <PageHeader eyebrow="решения" title="Выберите задачу" lead="Сайты, приложения и рабочие системы — с понятным результатом, сроком и диапазоном цены." />
  <main class="products-page" data-bg="paper">
    <nav class="catalog-index wrap" aria-label="Разделы каталога" data-reveal>
      {productGroups.map((group, groupIndex) => (
        <a href={`#${group.id}`}><span aria-hidden="true">{groupNumber(groupIndex)}</span>{group.title}</a>
      ))}
    </nav>
    {productGroups.map((group, groupIndex) => {
      const items = products.filter((product) => product.group === group.id);
      const dark = group.id === 'apps';
      return (
        <section id={group.id} class:list={['band', { 'band-dark': dark }]} data-bg={dark ? 'ink' : undefined}>
          <div class="wrap group" data-reveal>
            <header class="group-head">
              <span class="group-number" aria-hidden="true" data-value={groupNumber(groupIndex)}>{groupNumber(groupIndex)}</span>
              <h2>{group.title}</h2>
              <p>{group.summary}</p>
            </header>
            <div class="product-list">
              {items.map((item) => {
                const fixed = item.price.endsWith(' фикс');
                const priceValue = fixed ? item.price.slice(0, -' фикс'.length) : item.price;
                return (
                  <a class="product-row" href={item.status === 'published' && item.detail ? `/products/${item.slug}/` : briefHref(item)}>
                    <div class="product-copy"><h3>{item.name}</h3><p>{item.summary}</p></div>
                    <div class="product-meta"><b>{priceValue}{fixed && <em>фикс</em>}</b><span>{item.term}</span></div>
                    <span class="product-arrow" aria-hidden="true">↗</span>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      );
    })}
  </main>
  <SiteFooter />
</Base>

<style>
  .products-page{background:var(--color-paper);color:var(--color-ink);padding:56px 0 110px}
  .catalog-index{display:flex;flex-wrap:wrap;gap:12px 36px;padding-bottom:70px}.catalog-index a{display:inline-flex;align-items:baseline;gap:9px;color:rgb(23 21 15/.62);font-weight:650;text-decoration:none;transition:color .25s}.catalog-index a>span{font-family:var(--font-display);font-size:13px;font-weight:800;color:var(--color-blue)}.catalog-index a:hover{color:var(--color-ink);text-decoration:underline;text-decoration-color:var(--color-gold);text-decoration-thickness:2px;text-underline-offset:6px}
  .band{scroll-margin-top:40px}.band+.band{margin-top:90px}.band-dark{margin:96px 0;background:var(--color-ink);color:var(--color-paper);padding:76px 0 84px}
  .group{display:grid;grid-template-columns:300px 1fr;gap:50px;border-top:2px solid var(--color-ink);padding-top:28px}.band-dark .group{border-top-color:rgb(244 242 236/.35)}
  .group-head{position:sticky;top:34px;align-self:start}.group-head h2{margin:20px 0 0;font-family:var(--font-display);font-size:clamp(24px,2.5vw,34px);line-height:1.15}.group-head p{margin:16px 0 0;color:rgb(23 21 15/.6);line-height:1.55}.band-dark .group-head p{color:rgb(244 242 236/.6)}
  .band{--band-bg:var(--color-paper)}.band-dark{--band-bg:var(--color-ink)}
  .group-number{display:block;position:relative;font-family:var(--font-display);font-size:clamp(44px,5vw,72px);font-weight:800;line-height:.9;color:rgb(23 21 15/.28)}.band-dark .group-number{color:rgb(244 242 236/.32)}
  /* Контур двумя слоями: у Unbounded глифы из перекрывающихся форм, и голый text-stroke
     рисует внутренние швы. Снизу непрозрачная обводка 3px, сверху та же цифра цветом фона
     полосы — она прячет внутреннюю половину обводки вместе со швами. */
  @supports (-webkit-text-stroke:1px black){.group-number{color:transparent;-webkit-text-stroke:3px color-mix(in srgb,var(--color-ink) 42%,var(--color-paper))}.group-number::after{content:attr(data-value);position:absolute;inset:0;color:var(--band-bg);-webkit-text-stroke:0}.band-dark .group-number{-webkit-text-stroke-color:color-mix(in srgb,var(--color-paper) 46%,var(--color-ink))}}
  .product-list{border-top:1px solid rgb(23 21 15/.2)}.band-dark .product-list{border-top-color:rgb(244 242 236/.25)}
  .product-row{--row-muted:rgb(23 21 15/.6);display:grid;grid-template-columns:1fr 200px 24px;gap:28px;align-items:start;padding:25px 4px;border-bottom:1px solid rgb(23 21 15/.2);color:inherit;text-decoration:none;transition:padding .3s var(--ease-site),background .35s var(--ease-site),color .25s}.product-row:hover{--row-muted:rgb(244 242 236/.62);padding-left:16px;padding-right:16px;background:var(--color-ink);color:var(--color-paper)}
  .band-dark .product-row{--row-muted:rgb(244 242 236/.6);border-bottom-color:rgb(244 242 236/.25)}.band-dark .product-row:hover{--row-muted:rgb(23 21 15/.62);background:var(--color-paper);color:var(--color-ink)}
  .product-copy h3{margin:0;font-family:var(--font-display);font-size:20px;line-height:1.25}.product-copy p{max-width:560px;margin:9px 0 0;color:var(--row-muted);line-height:1.48;transition:color .25s}
  .product-meta{display:grid;gap:6px;align-content:start}.product-meta b{display:flex;flex-wrap:wrap;align-items:baseline;gap:9px;font-family:var(--font-display);font-size:clamp(16px,1.4vw,19px);font-weight:700;line-height:1.3}.product-meta em{font-style:normal;font-family:var(--font-text);font-size:12.5px;font-weight:700;letter-spacing:.03em;padding:2px 7px 3px;background:var(--color-gold);color:var(--color-ink)}.product-meta>span{color:var(--row-muted);font-size:14px;transition:color .25s}
  .product-arrow{font-size:22px;line-height:1.1;transition:transform .35s var(--ease-site),color .25s}.product-row:hover .product-arrow{transform:translate(5px,-5px);color:var(--color-gold)}
  @media(max-width:900px){.group{grid-template-columns:1fr;gap:28px}.group-head{position:static}.product-row{grid-template-columns:1fr 170px 20px}}
  @media(max-width:620px){.products-page{padding-top:40px}.catalog-index{gap:8px 24px;padding-bottom:54px}.band+.band{margin-top:64px}.band-dark{margin:70px 0;padding:56px 0 62px}.product-row{grid-template-columns:1fr 20px;gap:12px 14px}.product-copy{grid-column:1}.product-meta{grid-column:1;grid-template-columns:auto 1fr;align-items:baseline;gap:14px}.product-arrow{grid-column:2;grid-row:1;font-size:19px}}
</style>
