---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { briefHref, productGroups, products } from '../../data/products';
---

<Base title="Все продукты · 3K Studio">
  <Nav />
  <PageHeader eyebrow="продукты" title="Все продукты" lead="Полная линейка форматов: сайты, Telegram, интеграции и поддержка." />
  <main class="products-page" data-bg="paper">
    <div class="wrap groups">
      {productGroups.map((group) => {
        const items = products.filter((product) => product.group === group.id);
        return (
          <section class="group" data-reveal>
            <div class="group-head">
              <span class="mono">{group.title}</span>
              <p>{group.summary}</p>
            </div>
            <div class="grid">
              {items.map((item) => (
                <article>
                  <div>
                    <span class:list={['status', item.status]}>{item.status === 'published' ? 'детальная страница' : 'по задаче'}</span>
                    <h2>{item.name}</h2>
                    <p>{item.summary}</p>
                  </div>
                  <div class="meta">
                    <strong>{item.price}</strong>
                    <span>{item.term}</span>
                  </div>
                  <a href={item.status === 'published' ? `/products/${item.slug}/` : briefHref(item)}>
                    {item.status === 'published' ? 'Подробнее →' : 'Собрать в конструкторе →'}
                  </a>
                </article>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .products-page {
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 80px 0 100px;
  }

  .groups {
    display: grid;
    gap: 70px;
  }

  .group {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 34px;
    border-top: 2px solid rgb(23 21 15 / 0.2);
    padding-top: 30px;
  }

  .group-head {
    position: sticky;
    top: 34px;
    align-self: start;
  }

  .mono {
    color: var(--color-blue);
  }

  .group-head p {
    margin: 16px 0 0;
    color: rgb(23 21 15 / 0.62);
    font-size: 15px;
    line-height: 1.55;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  article {
    display: grid;
    min-height: 270px;
    box-sizing: border-box;
    border: 1.5px solid rgb(23 21 15 / 0.18);
    background: white;
    padding: 24px;
  }

  .status {
    display: inline-block;
    color: var(--color-blue);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status.planned {
    color: var(--color-ochre);
  }

  h2 {
    margin: 14px 0 0;
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.14;
  }

  article p {
    margin: 16px 0 0;
    color: rgb(23 21 15 / 0.7);
    font-size: 15px;
    line-height: 1.6;
  }

  .meta {
    display: grid;
    align-self: end;
    gap: 6px;
    margin-top: 28px;
  }

  .meta strong {
    color: var(--color-blue);
    font-size: 18px;
  }

  .meta span {
    color: rgb(23 21 15 / 0.52);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
  }

  article a {
    margin-top: 22px;
    color: var(--color-ochre);
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .group,
    .grid {
      grid-template-columns: 1fr;
    }

    .group-head {
      position: static;
    }
  }
</style>
