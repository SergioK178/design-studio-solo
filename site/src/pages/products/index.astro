---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { extensionPrices, productGroups, productPriceLabel, productTermLabel, products } from '../../data/products';

const groupNumber = (index: number) => String(index + 1).padStart(2, '0');
---

<Base title="Все решения · 3D Studio">
  <Nav />
  <PageHeader eyebrow="решения" title="Выберите задачу" lead="Сайты, приложения и рабочие системы — с понятным результатом, сроком и диапазоном цены." />
  <main class="products-page" data-bg="paper">
    <nav class="catalog-index wrap" aria-label="Разделы каталога" data-reveal>
      {productGroups.map((group, groupIndex) => (
        <a href={`#${group.id}`}>
          <span class="idx-num" aria-hidden="true">{groupNumber(groupIndex)}</span>
          <strong>{group.title}</strong>
          <small>{group.summary}</small>
        </a>
      ))}
    </nav>
    {productGroups.map((group, groupIndex) => {
      const items = products.filter((product) => product.group === group.id);
      const dark = group.id === 'apps';
      return (
        <section id={group.id} class:list={['band', { 'band-dark': dark }]} data-bg={dark ? 'ink' : undefined}>
          <div class="wrap group" data-reveal>
            <header class="group-head">
              <span class="group-number" aria-hidden="true" data-value={groupNumber(groupIndex)}>{groupNumber(groupIndex)}</span>
              <h2>{group.title}</h2>
            </header>
            <div class="product-list rule">
              {items.map((item) => {
                return (
                  <a class="product-row rule-end" href={`/products/${item.slug}/`}>
                    <div class="product-copy"><h3>{item.name}</h3><p>{item.summary}</p></div>
                    <div class="product-meta"><b>{productPriceLabel(item)}</b><span>{productTermLabel(item)}</span></div>
                    <span class="product-arrow" aria-hidden="true">↗</span>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      );
    })}
    <section class="wrap delivery-note" aria-label="Как считаются сроки">
      <p><strong>Как считаются сроки.</strong> Они рассчитаны при согласованном scope, своевременно переданных материалах и доступах и обратной связи в течение 2 рабочих дней. Ожидание материалов, доступов, согласований или решений клиента сдвигает календарную дату и не входит в срок работы студии.</p>
    </section>
    <section class="wrap extras" data-reveal aria-labelledby="extras-title">
      <div>
        <h2 id="extras-title">Дополнения и развитие</h2>
        <p>К любому формату добавляются отдельные строки с ценой и сроком до старта: {extensionPrices.slice(0, 4).map((item) => item.name.toLowerCase()).join(', ')} и другое.</p>
      </div>
      <a class="extras-link" href="/price/">Смотреть дополнения →</a>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .products-page{background:var(--color-paper);color:var(--color-ink);padding:56px 0 110px}
  .catalog-index{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:0;padding-bottom:70px}.catalog-index a{display:grid;align-content:start;gap:8px;border-top:2px solid var(--color-ink);padding:16px 18px 6px 0;color:inherit;text-decoration:none}.catalog-index .idx-num{font-family:var(--font-display);font-size:13px;font-weight:800;color:var(--color-blue-legacy)}.catalog-index strong{font-family:var(--font-display);font-size:16px;line-height:1.25;transition:color .25s}.catalog-index small{color:rgb(23 21 15/.6);font-size:13.5px;line-height:1.45}.catalog-index a:hover strong{text-decoration:underline;text-decoration-color:var(--color-gold);text-decoration-thickness:2px;text-underline-offset:5px}
  .band{scroll-margin-top:40px}.band+.band{margin-top:90px}.band-dark{margin:96px 0;background:var(--color-ink);color:var(--color-paper);padding:76px 0 84px}
  .group{display:grid;grid-template-columns:300px 1fr;gap:50px;border-top:2px solid var(--color-ink);padding-top:28px}.band-dark .group{border-top-color:rgb(244 242 236/.35)}
  .group-head{position:sticky;top:34px;align-self:start}.group-head h2{margin:20px 0 0;font-family:var(--font-display);font-size:clamp(24px,2.5vw,34px);line-height:1.15}.group-head p{margin:16px 0 0;color:rgb(23 21 15/.6);line-height:1.55}.band-dark .group-head p{color:rgb(244 242 236/.6)}
  .band{--band-bg:var(--color-paper)}.band-dark{--band-bg:var(--color-ink)}
  .group-number{display:block;position:relative;font-family:var(--font-display);font-size:clamp(44px,5vw,72px);font-weight:800;line-height:.9;color:rgb(23 21 15/.28)}.band-dark .group-number{color:rgb(244 242 236/.32)}
  /* Контур двумя слоями: у Unbounded глифы из перекрывающихся форм, и голый text-stroke
     рисует внутренние швы. Снизу непрозрачная обводка 3px, сверху та же цифра цветом фона
     полосы — она прячет внутреннюю половину обводки вместе со швами. */
  @supports (-webkit-text-stroke:1px black){.group-number{color:transparent;-webkit-text-stroke:3px color-mix(in srgb,var(--color-ink) 42%,var(--color-paper))}.group-number::after{content:attr(data-value);position:absolute;inset:0;color:var(--band-bg);-webkit-text-stroke:0}.band-dark .group-number{-webkit-text-stroke-color:color-mix(in srgb,var(--color-paper) 46%,var(--color-ink))}}
    .product-row{--row-muted:rgb(23 21 15/.6);display:grid;grid-template-columns:1fr 200px 24px;gap:28px;align-items:start;padding:25px 4px;color:inherit;text-decoration:none;transition:padding .3s var(--ease-site),background .35s var(--ease-site),color .25s}.product-row:hover{--row-muted:rgb(244 242 236/.62);padding-left:16px;padding-right:16px;background:var(--color-ink);color:var(--color-paper)}
  .band-dark .product-row{--row-muted:rgb(244 242 236/.6)}.band-dark .product-row:hover{--row-muted:rgb(23 21 15/.62);background:var(--color-paper);color:var(--color-ink)}
  .product-copy h3{margin:0;font-family:var(--font-display);font-size:20px;line-height:1.25}.product-copy p{max-width:560px;margin:9px 0 0;color:var(--row-muted);line-height:1.48;transition:color .25s}
  .product-meta{display:grid;gap:6px;align-content:start}.product-meta b{display:flex;flex-wrap:wrap;align-items:baseline;gap:9px;font-family:var(--font-display);font-size:clamp(16px,1.4vw,19px);font-weight:700;line-height:1.3}.product-meta em{font-style:normal;font-family:var(--font-text);font-size:12.5px;font-weight:700;letter-spacing:.03em;padding:2px 7px 3px;background:var(--color-gold);color:var(--color-ink)}.product-meta>span{color:var(--row-muted);font-size:14px;transition:color .25s}
  .product-arrow{font-size:22px;line-height:1.1;transition:transform .35s var(--ease-site),color .25s}.product-row:hover .product-arrow{transform:translate(5px,-5px);color:var(--color-gold)}
  .extras{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:90px;border-top:2px solid var(--color-ink);padding-top:28px}.extras h2{margin:0;font-family:var(--font-display);font-size:clamp(22px,2.2vw,30px)}.extras p{max-width:640px;margin:12px 0 0;color:rgb(23 21 15/.62);line-height:1.55}.extras-link{flex:none;color:var(--color-ink);font-weight:700;text-decoration:underline;text-decoration-color:var(--color-gold);text-decoration-thickness:2px;text-underline-offset:6px}
  .delivery-note{margin-top:72px;border-top:1px solid rgb(23 21 15/.2);padding-top:20px}.delivery-note p{max-width:760px;margin:0;color:rgb(23 21 15/.62);line-height:1.55}.delivery-note strong{color:var(--color-ink)}
  @media(max-width:1100px){.catalog-index{grid-template-columns:repeat(3,minmax(0,1fr));row-gap:22px}}
  @media(max-width:900px){.group{grid-template-columns:1fr;gap:28px}.group-head{position:static}.product-row{grid-template-columns:1fr 170px 20px}}
  @media(max-width:620px){.products-page{padding-top:40px}.catalog-index{grid-template-columns:1fr 1fr;padding-bottom:54px}.catalog-index a{padding-right:12px}.catalog-index small{display:none}.extras{flex-direction:column;align-items:flex-start;gap:16px;margin-top:64px}.band+.band{margin-top:64px}.band-dark{margin:70px 0;padding:56px 0 62px}.product-row{grid-template-columns:1fr 20px;gap:12px 14px}.product-copy{grid-column:1}.product-meta{grid-column:1;grid-template-columns:auto 1fr;align-items:baseline;gap:14px}.product-arrow{grid-column:2;grid-row:1;font-size:19px}}
</style>
