---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { briefHref, productGroups, products } from '../../data/products';
---

<Base title="Все решения · 3K Studio">
  <Nav />
  <PageHeader eyebrow="решения" title="Выберите задачу" lead="Сайты, приложения и рабочие системы — с понятным результатом, сроком и диапазоном цены." />
  <main class="products-page" data-bg="paper">
    <div class="wrap groups">
      {productGroups.map((group, groupIndex) => {
        const items = products.filter((product) => product.group === group.id);
        return (
          <section id={group.id} class="group" data-reveal>
            <header class="group-head">
              <span>{String(groupIndex + 1).padStart(2, '0')}</span>
              <h2>{group.title}</h2>
              <p>{group.summary}</p>
            </header>
            <div class="product-list">
              {items.map((item) => (
                <article>
                  <div class="product-copy"><h3>{item.name}</h3><p>{item.summary}</p></div>
                  <div class="product-meta"><strong>{item.price}</strong><span>{item.term}</span></div>
                  <a href={item.status === 'published' && item.detail ? `/products/${item.slug}/` : briefHref(item)} aria-label={`${item.name}: подробнее`}>Подробнее <span aria-hidden="true">↗</span></a>
                </article>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .products-page{background:var(--color-paper);color:var(--color-ink);padding:80px 0 110px}.groups{display:grid;gap:90px}.group{display:grid;grid-template-columns:300px 1fr;gap:50px;border-top:2px solid var(--color-ink);padding-top:28px;scroll-margin-top:40px}.group-head{position:sticky;top:34px;align-self:start}.group-head>span{color:var(--color-blue);font-variant-numeric:tabular-nums;font-weight:700}.group-head h2{margin:18px 0 0;font-family:var(--font-display);font-size:clamp(24px,2.5vw,34px);line-height:1.15}.group-head p{margin:16px 0 0;color:rgb(23 21 15/.6);line-height:1.55}.product-list{border-top:1px solid rgb(23 21 15/.2)}article{display:grid;grid-template-columns:1fr 180px 100px;gap:28px;align-items:start;padding:25px 0;border-bottom:1px solid rgb(23 21 15/.2)}.product-copy h3{margin:0;font-family:var(--font-display);font-size:20px;line-height:1.25}.product-copy p{max-width:560px;margin:9px 0 0;color:rgb(23 21 15/.6);line-height:1.48}.product-meta{display:grid;gap:5px}.product-meta span{color:rgb(23 21 15/.55);font-size:14px}article>a{color:var(--color-ochre);font-weight:700;text-align:right;text-decoration:none}article>a span{display:inline-block;margin-left:4px}
  @media(max-width:900px){.group{grid-template-columns:1fr;gap:28px}.group-head{position:static}article{grid-template-columns:1fr 160px 90px}}
  @media(max-width:620px){.products-page{padding-top:60px}.groups{gap:68px}article{grid-template-columns:1fr}.product-meta{grid-template-columns:auto 1fr;align-items:baseline}article>a{text-align:left}}
</style>
