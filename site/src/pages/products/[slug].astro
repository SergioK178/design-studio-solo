---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ProofModule from '../../components/ProofModule.astro';
import { briefHref, detailedProducts, extensionPrices } from '../../data/products';
import { site } from '../../data/site';

export function getStaticPaths() {
  return detailedProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const detail = product.detail;
const proof = product.proof;
const recommended = extensionPrices.filter((extension) => product.recommendedExtensions?.includes(extension.id)).slice(0, 6);
---

<Base title={`${product.name} · 3K Studio`}>
  <Nav />
  <PageHeader eyebrow={`${product.term} · ${product.price}`} title={product.name} lead={product.summary} tone="gold" />
  <main class="product" data-bg="paper">
    {proof && <ProofModule proof={proof} />}

    <section class="wrap grid" data-reveal-group>
      <article>
        <span class="mono">кому подходит</span>
        <p>{detail.audience}</p>
      </article>
      <article>
        <span class="mono">что входит</span>
        <ul>{detail.includes.map((item) => <li>{item}</li>)}</ul>
      </article>
      <article>
        <span class="mono">что не входит</span>
        <ul>{detail.excludes.map((item) => <li>{item}</li>)}</ul>
      </article>
      <article class="note">
        <span class="mono">граница</span>
        <p>{detail.note}</p>
      </article>
    </section>

    <section class="wrap options" data-reveal>
      <div class="options-head">
        <div>
          <span class="mono">опции</span>
          <h2>Расширения к этому формату</h2>
        </div>
        <a href="/price/">Весь прайс →</a>
      </div>
      <div class="options-grid">
        {recommended.map((item) => (
          <article>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
            <div>
              <strong>{item.price}</strong>
              <span>{item.term}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="wrap cta" data-reveal>
      <h2>Проверим, попадает ли задача в этот формат?</h2>
      <a class="btn-gold" href={briefHref(product)} data-magnetic>Разобрать задачу в брифе</a>
      <a class="outline" href={site.telegramUrl} data-magnetic>Написать {site.telegram}</a>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .product {
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 80px 0 100px;
  }

  .options h2,
  .cta h2 {
    margin: 12px 0 0;
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.12;
  }

  .options-head a {
    display: inline-block;
    margin-top: 22px;
    color: var(--color-ochre);
    font-weight: 700;
    text-decoration: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  article {
    border-top: 2px solid rgb(23 21 15 / 0.2);
    padding-top: 24px;
  }

  .mono {
    color: var(--color-blue);
  }

  p,
  li {
    color: rgb(23 21 15 / 0.72);
    font-size: 17px;
    line-height: 1.65;
  }

  ul {
    margin: 18px 0 0;
    padding-left: 22px;
  }

  .options {
    margin-top: 74px;
  }

  .options-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .options-grid article {
    display: grid;
    min-height: 230px;
    border: 1.5px solid rgb(23 21 15 / 0.18);
    background: white;
    padding: 22px;
  }

  .options-grid h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.2;
  }

  .options-grid p {
    margin: 14px 0 0;
    font-size: 15px;
  }

  .options-grid div {
    display: grid;
    gap: 6px;
    align-self: end;
    margin-top: 22px;
  }

  .options-grid strong {
    color: var(--color-blue);
    font-size: 18px;
  }

  .options-grid span {
    color: rgb(23 21 15 / 0.52);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
  }

  .cta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 70px;
  }

  .cta h2 {
    flex-basis: 100%;
    margin-bottom: 10px;
  }

  .outline {
    border: 1.5px solid rgb(23 21 15 / 0.3);
    padding: 17.5px 26px;
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .grid,
    .options-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .options-head {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
