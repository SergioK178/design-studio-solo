---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ProofModule from '../../components/ProofModule.astro';
import { briefHref, detailedProducts, extensionPrices, productPriceLabel, productTermLabel, projectSteps } from '../../data/products';
import { site } from '../../data/site';

export function getStaticPaths() {
  return detailedProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const detail = product.detail;
const proof = product.proof;
const steps = projectSteps(product);
const recommended = extensionPrices.filter((extension) => product.recommendedExtensions?.includes(extension.id)).slice(0, 6);
---

<Base title={`${product.name} · 3D Studio`}>
  <Nav />
  <PageHeader eyebrow={`${productTermLabel(product)} · ${productPriceLabel(product)}`} title={product.name} lead={product.summary} tone="gold" />
  <main class="product" data-bg="paper">
    {proof && <ProofModule proof={proof} briefHref={briefHref(product)} />}

    <section class="wrap gains" data-reveal>
      <span class="mono">результат</span>
      <h2>Что вы получаете</h2>
      <ul>{detail.includes.map((item) => <li>{item}</li>)}</ul>
    </section>

    <section class="wrap steps" data-reveal>
      <span class="mono">процесс</span>
      <h2>Как пройдёт проект</h2>
      <ol>
        {steps.map((step, index) => (
          <li>
            <b>{String(index + 1).padStart(2, '0')}</b>
            <strong>{step.title}</strong>
            <p>{step.note}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap fit" data-reveal-group>
      <article>
        <span class="mono">кому подходит</span>
        <p>{detail.audience}</p>
        <p class="fit-note">{detail.note}</p>
      </article>
      <article>
        <span class="mono">что не входит</span>
        <ul>{detail.excludes.map((item) => <li>{item}</li>)}</ul>
      </article>
    </section>

    <section class="wrap options" data-reveal>
      <div class="options-head">
        <div>
          <span class="mono">опции</span>
          <h2>Расширения к этому формату</h2>
        </div>
        <a href="/price/">Весь прайс →</a>
      </div>
      <div class="options-grid">
        {recommended.map((item) => (
          <article>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
            <div>
              <strong>{item.price}</strong>
              <span>{item.term}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    {product.cta === 'discuss' ? (
      <section class="wrap cta" data-reveal>
        <h2>Такие проекты начинаются с разговора</h2>
        <a class="btn-gold" href={site.telegramUrl} data-magnetic>Обсудить проект ↗</a>
        <a class="text-action" href={briefHref(product)}>Или пройти бриф <span class="arrow" aria-hidden="true">→</span></a>
      </section>
    ) : (
      <section class="wrap cta" data-reveal>
        <h2>Проверим, попадает ли задача в этот формат?</h2>
        <a class="btn-gold" href={briefHref(product)} data-magnetic>Пройти бриф →</a>
        <a class="btn-outline" href={site.telegramUrl} data-magnetic>Обсудить проект ↗</a>
      </section>
    )}
  </main>
  <SiteFooter />
</Base>

<style>
  .product {
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 80px 0 100px;
  }

  .gains h2,
  .steps h2,
  .options h2,
  .cta h2 {
    margin: 12px 0 0;
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.12;
  }

  .options-head a {
    display: inline-block;
    margin-top: 22px;
    color: var(--color-ochre);
    font-weight: 700;
    text-decoration: none;
  }

  .mono {
    color: var(--color-blue-legacy);
  }

  p,
  li {
    color: rgb(23 21 15 / 0.72);
    font-size: 17px;
    line-height: 1.65;
  }

  .gains,
  .steps,
  .fit {
    border-top: 2px solid rgb(23 21 15 / 0.2);
    padding-top: 24px;
  }

  .steps,
  .fit {
    margin-top: 74px;
  }

  .gains ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 40px;
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
  }

  .gains li {
    position: relative;
    padding-left: 30px;
    font-size: 18px;
    color: var(--color-ink);
  }

  .gains li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-ochre);
    font-weight: 800;
  }

  .steps ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
  }

  .steps li b {
    display: block;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
    color: var(--color-blue-legacy);
  }

  .steps li strong {
    display: block;
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: 19px;
    line-height: 1.2;
  }

  .steps li p {
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.55;
  }

  .fit {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
  }

  .fit-note {
    margin-top: 14px;
    color: rgb(23 21 15 / 0.55);
    font-size: 15px;
  }

  .fit ul {
    margin: 18px 0 0;
    padding-left: 22px;
  }

  .options {
    margin-top: 74px;
  }

  .options-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .options-grid article {
    display: grid;
    min-height: 230px;
    border: 1.5px solid rgb(23 21 15 / 0.18);
    background: white;
    padding: 22px;
  }

  .options-grid h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.2;
  }

  .options-grid p {
    margin: 14px 0 0;
    font-size: 15px;
  }

  .options-grid div {
    display: grid;
    gap: 6px;
    align-self: end;
    margin-top: 22px;
  }

  .options-grid strong {
    color: var(--color-blue-legacy);
    font-size: 18px;
  }

  .options-grid span {
    color: rgb(23 21 15 / 0.52);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
  }

  .cta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 70px;
  }

  .cta h2 {
    flex-basis: 100%;
    margin-bottom: 10px;
  }

  @media (max-width: 900px) {
    .gains ul,
    .fit,
    .options-grid {
      grid-template-columns: 1fr;
    }

    .steps ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
    }
  }

  @media (max-width: 620px) {
    .steps ol {
      grid-template-columns: 1fr;
    }

    .options-head {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
