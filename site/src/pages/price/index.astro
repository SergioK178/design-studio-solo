---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PriceTable from '../../components/PriceTable.astro';
import { extensionPrices } from '../../data/products';
---

<Base title="Прайс расширений · 3K Studio">
  <Nav />
  <PageHeader eyebrow="прайс" title="Прайс расширений" lead="Расширения не появляются из воздуха: если задача выходит за рамки формата, считаем её отдельной строкой." />
  <main class="price-page" data-bg="paper">
    <div class="wrap">
      <PriceTable items={extensionPrices} />
      <section class="note" data-reveal>
        <h2>Как это применяется</h2>
        <p>Базовый формат фиксирует рамки проекта. Всё, что не входит в рамки, добавляется как расширение с отдельной ценой и сроком до старта работ.</p>
        <a class="btn-gold" href="/brief/">Разобрать задачу →</a>
      </section>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .price-page {
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 80px 0 100px;
  }

  .note {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 30px;
    align-items: center;
    margin-top: 60px;
    border-top: 2px solid rgb(23 21 15 / 0.22);
    padding-top: 30px;
  }

  .note h2 {
    font-size: clamp(28px, 4vw, 44px);
  }

  .note p {
    max-width: 680px;
    margin-top: 14px;
    font-size: 17px;
  }

  @media (max-width: 860px) {
    .note {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
