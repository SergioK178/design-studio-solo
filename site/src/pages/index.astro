---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import HeroWall from '../components/HeroWall.astro';
import ProcessChat from '../components/ProcessChat.astro';
import ApproachInfographics from '../components/ApproachInfographics.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CasePreview from '../components/CasePreview.astro';
import { faqs, team } from '../data/home';
import { productGroups } from '../data/products';
import { site } from '../data/site';
import { works } from '../data/works';
---

<Base title="Сайты и рабочие системы своей командой · 3D Studio">
  <Nav />
  <HeroWall />

  <main>
    <section id="products" class="paper-section directions-section" data-bg="paper">
      <div class="wrap section-wrap">
        <header class="section-head" data-reveal>
          <div><span class="eyebrow">Направления</span><h2>Выберите тип задачи</h2></div>
          <p>Состав, цену и срок фиксируем до старта. Все форматы и цены — в каталоге.</p>
        </header>
        <ol class="direction-list rule rule-major" data-reveal-group>
          {productGroups.map((group, index) => (
            <li class="rule-end">
              <a href={`/products/#${group.id}`}>
                <span class="direction-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <strong class="direction-title">{group.title}</strong>
                <span class="direction-summary">{group.summary}</span>
                <span class="direction-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
        <a class="catalog-link" href="/products/">Все форматы и цены →</a>
      </div>
    </section>

    <section id="works" class="paper-section works-section" data-bg="paper">
      <div class="wrap section-wrap">
        <header class="section-head" data-reveal>
          <div><span class="eyebrow">Работы</span><h2>Проекты, которые уже работают</h2></div>
          <p>В каждом проекте — своя логика, объём и путь к нужному действию.</p>
        </header>
        <div class="works-grid" data-reveal-group>
          {works.filter((item) => item.status === 'published' && item.homeFeatured).map((item) => <CasePreview work={item} variant="home" />)}
        </div>
      </div>
    </section>

    <section id="approach" class="dark-section approach-section" data-bg="ink">
      <div class="wrap section-wrap">
        <header class="section-head light-head" data-reveal><div><span class="eyebrow light">Гарантии</span><h2>Понятные правила до начала работы</h2></div><p>Формат проекта меняется, но коммерческая безопасность остаётся.</p></header>
        <ApproachInfographics />
      </div>
    </section>

    <ProcessChat />

    <section id="team" class="dark-section team-section" data-bg="ink" aria-labelledby="team-title">
      <div class="wrap section-wrap">
        <header class="section-head light-head" data-reveal><div><span class="eyebrow light">Команда</span><h2 id="team-title">Отвечают те, кто делает</h2></div><p>Без менеджера-посредника: стратегия, дизайн и разработка представлены в рабочем чате напрямую.</p></header>
        <div class="team-list" data-reveal-group>{team.map((person, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{person.name}</h3><strong>{person.role}</strong><p>{person.fact}</p></article>)}</div>
      </div>
    </section>

    <section id="brief" class="paper-section brief-section" data-bg="paper"><div class="wrap brief-grid" data-reveal-group><div><span class="eyebrow">Бриф</span><h2>Понять формат, срок и бюджет</h2><p>Ответьте на несколько вопросов — получите подходящий формат и предварительную оценку срока и бюджета до отправки контактов.</p></div><div class="brief-actions"><a class="btn-gold btn-lg" href="/brief/" data-magnetic>Пройти бриф →</a><a class="btn-outline btn-lg" href={site.telegramUrl} data-magnetic>Обсудить проект</a></div></div></section>

    <section id="faq" class="paper-section" data-bg="paper"><div class="wrap section-wrap"><header class="section-head" data-reveal><div><span class="eyebrow">Вопросы</span><h2>Коротко о важном</h2></div></header><div class="faq-list" data-reveal-group>{faqs.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div></section>

  </main>
  <SiteFooter />
</Base>

<style>
  .paper-section{background:var(--color-paper);color:var(--color-ink)}.dark-section{background:var(--color-ink);color:var(--color-paper)}
  .section-wrap{padding-top:72px;padding-bottom:80px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:32px;margin-bottom:46px}.section-head>div{max-width:760px}.section-head h2,.brief-section h2{margin:10px 0 0;font-family:var(--font-display);font-size:clamp(34px,4vw,48px);font-weight:800;line-height:1.1}.section-head p{max-width:420px;margin:0;color:rgb(23 21 15/.62);font-size:16px;line-height:1.55}.light-head p{color:rgb(244 242 236/.62)}.eyebrow{color:var(--color-blue-legacy);font-size:13px;font-weight:650}.eyebrow.light{color:var(--color-gold)}.eyebrow.muted{color:rgb(23 21 15/.6)}
  .works-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-6)}
  .works-section .section-head{margin-bottom:var(--space-12)}.works-section .eyebrow{color:var(--color-blue);font-size:12px;font-weight:600;line-height:1.25;letter-spacing:.04em}.works-section .section-head h2{font-size:clamp(30px,3.6vw,40px);font-weight:700;line-height:1.1;letter-spacing:-.01em}
  .approach-section .section-head{margin-bottom:var(--space-12)}.approach-section .eyebrow.light{font-size:12px;font-weight:600;line-height:1.25;letter-spacing:.04em}.approach-section .section-head h2{font-size:clamp(30px,3.6vw,40px);font-weight:700;line-height:1.1;letter-spacing:-.01em}.approach-section .section-head p{color:var(--text-on-ink-secondary)}
  .directions-section .section-head{margin-bottom:var(--space-12)}.directions-section .eyebrow{color:var(--color-blue);font-size:12px;font-weight:600;line-height:1.25;letter-spacing:.04em}.directions-section .section-head h2{font-size:clamp(30px,3.6vw,40px);font-weight:700;line-height:1.1;letter-spacing:-.01em}.directions-section .catalog-link{margin-top:var(--space-8)}
  .direction-list{margin:0;padding:0;list-style:none}.direction-list a{--row-muted:var(--text-muted);display:grid;grid-template-columns:clamp(48px,5vw,72px) minmax(240px,1.1fr) minmax(0,1.9fr) 24px;column-gap:var(--space-6);align-items:baseline;padding:var(--space-6) var(--space-1);color:inherit;text-decoration:none;transition:background var(--dur-standard) var(--ease-site),color var(--dur-feedback) var(--ease-site)}
  .direction-number{font-size:12px;font-weight:600;line-height:1.25;letter-spacing:.04em;color:var(--text-muted);transition:color var(--dur-feedback) var(--ease-site),transform var(--dur-standard) var(--ease-site)}.direction-title{min-width:0;font-family:var(--font-display);font-size:20px;font-weight:700;line-height:1.2;letter-spacing:-.01em;overflow-wrap:break-word;transition:transform var(--dur-standard) var(--ease-site)}.direction-summary{min-width:0;color:var(--row-muted);font-size:16px;line-height:1.55;transition:color var(--dur-feedback) var(--ease-site),transform var(--dur-standard) var(--ease-site)}.direction-arrow{font-size:20px;line-height:1.2;transition:color var(--dur-feedback) var(--ease-site),transform var(--dur-standard) var(--ease-site)}
  @media(min-width:769px){.direction-list a:hover,.direction-list a:focus-visible{--row-muted:var(--text-on-ink-secondary);background:var(--color-ink);color:var(--color-paper)}.direction-list a:focus-visible{outline-offset:-2px}.direction-list a:hover :is(.direction-number,.direction-arrow),.direction-list a:focus-visible :is(.direction-number,.direction-arrow){color:var(--color-gold)}.direction-list a:hover :is(.direction-number,.direction-title,.direction-summary),.direction-list a:focus-visible :is(.direction-number,.direction-title,.direction-summary){transform:translateX(var(--space-3))}.direction-list a:hover .direction-arrow,.direction-list a:focus-visible .direction-arrow{transform:translateX(var(--space-1))}}
  @media(prefers-reduced-motion:reduce){.direction-list a,.direction-list a *{transition:none!important;transform:none!important}}
  .catalog-link{display:inline-block;margin-top:28px;color:var(--color-ochre);font-weight:700;text-decoration:none}
  .team-section .section-head{margin-bottom:var(--space-12)}.team-section .eyebrow.light{font-size:12px;font-weight:600;line-height:1.25;letter-spacing:.04em}.team-section .section-head h2{font-size:clamp(30px,3.6vw,40px);font-weight:700;line-height:1.1;letter-spacing:-.01em}
  .team-list{border-top:1px solid var(--border-on-ink-default);border-bottom:1px solid var(--border-on-ink-default)}.team-list article{display:grid;grid-template-columns:54px 180px 250px 1fr;gap:var(--space-6);align-items:start;padding:var(--space-6) 0}.team-list article+article{border-top:1px solid var(--border-on-ink-subtle)}.team-list span{font-family:var(--font-text);font-size:12px;font-weight:600;line-height:1.25;letter-spacing:.04em;color:var(--text-on-ink-muted)}.team-list h3{margin:0;font-family:var(--font-text);font-size:clamp(22px,19.33px + 0.42vw,24px);font-weight:600;line-height:1.25}.team-list strong{font-family:var(--font-text);font-size:16px;font-weight:600;line-height:1.55;color:var(--text-on-ink-secondary)}.team-list p{margin:0;font-family:var(--font-text);color:var(--text-on-ink-muted);line-height:1.55}
  .brief-grid{display:grid;grid-template-columns:1fr auto;gap:48px;align-items:center;padding-top:80px;padding-bottom:80px}.brief-section h2{max-width:720px}.brief-section p{max-width:520px;color:rgb(23 21 15/.62);line-height:1.55}.brief-actions{display:grid;gap:12px}
  .faq-list{display:grid;grid-template-columns:repeat(2,1fr);gap:0;border-top:1px solid rgb(23 21 15/.25);border-left:1px solid rgb(23 21 15/.25)}details{border-right:1px solid rgb(23 21 15/.25);border-bottom:1px solid rgb(23 21 15/.25);padding:24px;background:rgb(255 255 255/.5)}summary{cursor:pointer;font-family:var(--font-display);font-size:17px;font-weight:700;line-height:1.35}details p{color:rgb(23 21 15/.68);line-height:1.55}
  @media(max-width:820px){.section-head{align-items:start;flex-direction:column}.brief-grid{grid-template-columns:1fr}.brief-actions{width:100%}}
  @media(max-width:620px){.section-wrap{padding-top:48px;padding-bottom:52px}.section-head{margin-bottom:28px}.section-head p{display:none}.faq-list{grid-template-columns:1fr}}
  @media(max-width:768px){.works-grid{grid-template-columns:1fr;gap:var(--space-8)}.direction-list a{grid-template-columns:32px minmax(0,1fr) 24px;gap:var(--space-2) var(--space-3);padding:var(--space-5) 0}.direction-number{grid-area:1/1}.direction-title{grid-area:1/2}.direction-arrow{grid-area:1/3;justify-self:end}.direction-summary{grid-area:2/2/3/4}}
  /* Team-specific exception: fixed 180px+250px name/role columns leave <160px for the fact column below ~800px content width, wrapping it to 5-6 narrow lines. Canonical 768 breaks this; kept at 820. */
  @media(max-width:820px){.team-list article{grid-template-columns:40px 1fr}.team-list strong,.team-list p{grid-column:2}}
  @media(max-width:640px){.approach-section .section-head{margin-bottom:var(--space-8)}.approach-section .section-head h2{font-size:30px}.works-section .section-head{margin-bottom:var(--space-8)}.works-section .section-head h2{font-size:30px}.directions-section .section-wrap{padding-top:48px;padding-bottom:52px}.directions-section .section-head{margin-bottom:var(--space-8)}.directions-section .section-head p{display:none}.directions-section .section-head h2{font-size:30px}.direction-list a{padding:var(--space-4) 0}.direction-title{font-size:18px}.direction-summary{font-size:14px;line-height:1.5}.team-section .section-head{margin-bottom:var(--space-8)}.team-section .section-head h2{font-size:30px}.team-list article{grid-template-columns:32px 1fr}}
</style>
