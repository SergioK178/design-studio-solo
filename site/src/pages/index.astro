---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import HeroWall from '../components/HeroWall.astro';
import ProcessChat from '../components/ProcessChat.astro';
import ApproachInfographics from '../components/ApproachInfographics.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CasePreview from '../components/CasePreview.astro';
import AssetSlot from '../components/AssetSlot.astro';
import { faqs, team } from '../data/home';
import { homeSolutions } from '../data/products';
import { site } from '../data/site';
import { works } from '../data/works';
---

<Base title="Сайт под вашу задачу — первый запуск от недели · 3K Studio">
  <Nav />
  <HeroWall />

  <main>
    <section id="works" class="paper-section" data-bg="paper">
      <div class="wrap section-wrap">
        <header class="section-head" data-reveal>
          <div><span class="eyebrow">Работы</span><h2>Задачи, которые уже работают</h2></div>
          <p>В каждом проекте — своя логика, объём и путь к нужному действию.</p>
        </header>
        <div class="works-grid" data-reveal-group>
          {works.filter((item) => item.status === 'planned' || item.homeFeatured).map((item) => <CasePreview work={item} />)}
        </div>
        <p class="section-transition" data-reveal>Формат зависит не от количества страниц, а от задачи, которую должен решать продукт.</p>
      </div>
    </section>

    <section id="products" class="paper-section solutions-section" data-bg="paper">
      <div class="wrap section-wrap">
        <header class="section-head" data-reveal>
          <div><span class="eyebrow">Основные решения</span><h2>Выберите задачу, а не технологию</h2></div>
          <p>Сначала определяем результат для бизнеса. Состав, цену и срок фиксируем до старта.</p>
        </header>
        <ol class="solution-list" data-reveal-group>
          {homeSolutions.map((item) => (
            <li>
              <a href={item.href} data-cursor-preview>
                <span class="solution-number" aria-hidden="true" data-value={item.number}>{item.number}</span>
                <span class="solution-copy"><strong>{item.title}</strong><span class="solution-format">{item.format}</span><span>{item.summary}</span></span>
                <span class="solution-meta">
                  {item.prices.map((price) => (
                    <span class="solution-price">{price.label && <em>{price.label}</em>}<b><small>{price.prefix}</small>{price.value}</b></span>
                  ))}
                  <span class="solution-term">{item.term}</span>
                </span>
                <span class="solution-arrow" aria-hidden="true">↗</span>
                <div class="solution-preview" aria-hidden="true"><div class="preview-inner"><AssetSlot label={item.previewAsset} frame="browser" /></div></div>
              </a>
            </li>
          ))}
        </ol>
        <a class="catalog-link" href="/products/">Посмотреть все варианты →</a>
      </div>
    </section>

    <section class="special-section" data-bg="ink" aria-labelledby="special-title">
      <div class="wrap special-grid">
        <article class="special-primary" data-reveal>
          <div class="special-copy">
            <span class="eyebrow light">Отдельный продукт</span>
            <h2 id="special-title">Приложение внутри Telegram</h2>
            <p>Запись, заказы, программа лояльности, личный кабинет или рабочий инструмент открываются прямо в Telegram.</p>
            <div class="special-footer"><span class="special-price"><small>от</small>120 000 ₽</span><a href="/products/#apps">Подробнее →</a></div>
          </div>
          <div class="special-visual">
            <AssetSlot label="ui/telegram-mini-app" tone="dark" frame="telegram" />
          </div>
        </article>
        <article class="special-secondary" data-reveal>
          <span class="eyebrow light">Для внутренних задач</span>
          <h3>Убрать повторяющуюся работу</h3>
          <p>Связываем сайт, таблицы, почту и системы компании, чтобы заявки, документы и отчёты не переносились вручную.</p>
          <dl><div><dt>Разбор задачи</dt><dd>30–60 тыс. ₽</dd></div><div><dt>Реализация</dt><dd>от 100 000 ₽</dd></div></dl>
          <a href="/products/#automation">Посмотреть варианты →</a>
        </article>
      </div>
    </section>

    <section class="capabilities-section" data-bg="paper">
      <div class="wrap">
        <a class="development-line" href="/products/#development" data-reveal><strong>Уже есть сайт или сервис?</strong><span>Переработаем структуру и дизайн, перенесём данные, ускорим работу или добавим нужный раздел.</span><b>Подробнее →</b></a>
        <div class="capabilities" data-reveal>
          <h2>Подключаем только то, что действительно нужно задаче</h2>
          <p>Управление сайтом <i>·</i> учёт заявок <i>·</i> аналитика <i>·</i> онлайн-оплата <i>·</i> обмен с 1С <i>·</i> уведомления <i>·</i> личный кабинет <i>·</i> обновление каталога <i>·</i> обработка данных с помощью ИИ</p>
        </div>
        <a class="telegram-help" href={site.telegramUrl} target="_blank" rel="noopener" data-reveal><span><strong>Не знаете, с чего начать?</strong><small>Опишите задачу своими словами — поможем выбрать решение.</small></span><b>Написать в Telegram →</b></a>
      </div>
    </section>

    <section class="method-section" data-bg="paper" aria-labelledby="method-title">
      <div class="wrap section-wrap">
        <header class="section-head" data-reveal><div><span class="eyebrow">Принцип работы</span><h2 id="method-title">Один продукт — три связанных уровня</h2></div><p>Мы проектируем не только экран, но и то, как компания управляет продуктом и получает результат.</p></header>
        <ol class="method-line" data-reveal-group>
          <li><span>1</span><strong>Интерфейс</strong><p>Что видит клиент или сотрудник.</p></li>
          <li><span>2</span><strong>Управление</strong><p>Где компания меняет содержимое и контролирует работу.</p></li>
          <li><span>3</span><strong>Действие</strong><p>Что происходит после заявки, оплаты или обновления данных.</p></li>
        </ol>
      </div>
    </section>

    <section id="approach" class="dark-section" data-bg="ink">
      <div class="wrap section-wrap">
        <header class="section-head light-head" data-reveal><div><span class="eyebrow light">Гарантии</span><h2>Понятные правила до начала работы</h2></div><p>Формат проекта меняется, но коммерческая безопасность остаётся.</p></header>
        <ApproachInfographics />
      </div>
    </section>

    <ProcessChat />

    <section id="team" class="dark-section team-section" data-bg="ink" aria-labelledby="team-title">
      <div class="wrap section-wrap">
        <header class="section-head light-head" data-reveal><div><span class="eyebrow light">Команда</span><h2 id="team-title">Отвечают те, кто делает</h2></div><p>Без менеджера-посредника: стратегия, дизайн и разработка представлены в рабочем чате напрямую.</p></header>
        <div class="team-list" data-reveal-group>{team.map((person, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{person.name}</h3><strong>{person.role}</strong><p>{person.fact}</p></article>)}</div>
      </div>
    </section>

    <section id="brief" class="brief-section" data-bg="gold"><div class="wrap brief-grid" data-reveal-group><div><span class="eyebrow muted">Бриф</span><h2>Расскажите, что должно заработать</h2><p>3–5 минут. Предложим формат и ориентир — точную цену и срок фиксируем в договоре.</p></div><div class="brief-actions"><a class="brief-primary" href="/brief/" data-magnetic>Пройти бриф →</a><a class="brief-secondary" href={site.telegramUrl} data-magnetic>Написать в Telegram</a></div></div></section>

    <section id="faq" class="paper-section" data-bg="paper"><div class="wrap section-wrap"><header class="section-head" data-reveal><div><span class="eyebrow">Вопросы</span><h2>Коротко о важном</h2></div></header><div class="faq-list" data-reveal-group>{faqs.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div></section>

    <section id="final-cta" class="final-cta-section" data-bg="ink"><div class="wrap final-cta-inner" data-reveal><h2>Готовы обсудить задачу?</h2><div><a class="btn-gold" href="/brief/" data-magnetic>Разобрать задачу →</a><a class="btn-outline" href={site.telegramUrl} data-magnetic>Написать в Telegram</a></div></div></section>
  </main>
  <SiteFooter />
</Base>

<style>
  .paper-section,.capabilities-section,.method-section{background:var(--color-paper);color:var(--color-ink)}.dark-section,.special-section,.final-cta-section{background:var(--color-ink);color:var(--color-paper)}
  .section-wrap{padding-top:90px;padding-bottom:100px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:32px;margin-bottom:46px}.section-head>div{max-width:760px}.section-head h2,.capabilities h2,.special-section h2,.special-section h3,.brief-section h2,.final-cta-section h2{margin:10px 0 0;font-family:var(--font-display);font-size:clamp(34px,4vw,48px);font-weight:800;line-height:1.1}.section-head p{max-width:420px;margin:0;color:rgb(23 21 15/.62);font-size:16px;line-height:1.55}.light-head p{color:rgb(244 242 236/.62)}.eyebrow{color:var(--color-blue);font-size:13px;font-weight:650}.eyebrow.light{color:var(--color-gold)}.eyebrow.muted{color:rgb(23 21 15/.6)}
  .works-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:18px}.works-grid :global(.case-preview){grid-column:span 3}.section-transition{max-width:720px;margin:52px 0 0 50%;padding-left:18px;border-left:3px solid var(--color-gold);font-size:19px;line-height:1.5}
  .solutions-section .section-wrap{padding-top:30px}.solution-list{margin:0;padding:0;border-top:2px solid var(--color-ink);list-style:none}.solution-list li{border-bottom:1px solid rgb(23 21 15/.25)}.solution-list a{--row-muted:rgb(23 21 15/.58);position:relative;display:grid;grid-template-columns:clamp(64px,7vw,96px) 1.4fr 1fr 24px;gap:24px;align-items:start;padding:30px 4px;color:inherit;text-decoration:none;transition:padding .3s var(--ease-site),background .35s var(--ease-site),color .25s}.solution-list a:hover{--row-muted:rgb(244 242 236/.62);padding-left:16px;padding-right:16px;background:var(--color-ink);color:var(--color-paper)}.method-line>li>span,.team-list article>span{color:var(--color-blue);font-weight:650}
  .solution-number{position:relative;font-family:var(--font-display);font-size:clamp(34px,4.2vw,58px);font-weight:800;line-height:.92;color:rgb(23 21 15/.3);transition:color .25s,-webkit-text-stroke-color .25s}.solution-list a:hover .solution-number{color:var(--color-gold)}
  /* Контур двумя слоями (как у номеров групп в каталоге): голый text-stroke рисует
     внутренние швы перекрывающихся форм Unbounded, верхний слой цветом фона их прячет. */
  @supports (-webkit-text-stroke:1px black){.solution-number{color:transparent;-webkit-text-stroke:3px color-mix(in srgb,var(--color-ink) 46%,var(--color-paper))}.solution-number::after{content:attr(data-value);position:absolute;inset:0;color:var(--color-paper);-webkit-text-stroke:0;transition:color .25s}.solution-list a:hover .solution-number{-webkit-text-stroke-color:transparent}.solution-list a:hover .solution-number::after{color:var(--color-gold)}}
  .solution-copy{display:grid;gap:8px}.solution-copy strong{font-family:var(--font-display);font-size:clamp(22px,2.5vw,32px);line-height:1.15}.solution-copy>span:last-child,.solution-term,.solution-price em,.solution-price small{color:var(--row-muted);transition:color .25s}.solution-copy>span:last-child{line-height:1.45}.solution-format{font-weight:700}
  .solution-meta{display:grid;gap:7px;align-content:start}.solution-price{display:flex;align-items:baseline;gap:10px}.solution-price em{min-width:62px;font-style:normal;font-size:14px}.solution-price b{display:flex;align-items:baseline;gap:7px;font-family:var(--font-display);font-size:clamp(17px,1.8vw,21px);font-weight:700;line-height:1.2}.solution-price small{font-family:var(--font-text);font-size:13px;font-weight:600}.solution-term{margin-top:5px;font-size:14px;line-height:1.45}
  .solution-arrow{font-size:24px;transition:transform .35s var(--ease-site),color .25s}.solution-list a:hover .solution-arrow{transform:translate(5px,-5px);color:var(--color-gold)}
  .solution-preview{display:none;position:absolute;left:0;top:0;z-index:5;width:min(320px,26vw);margin:-115px 0 0 -160px;color:var(--color-ink);pointer-events:none;will-change:transform}.solution-list a.preview-armed .solution-preview{display:block}.preview-inner{opacity:0;transform:scale(.85) rotate(-3deg);transition:opacity .3s,transform .5s var(--ease-site)}.solution-list a:hover .preview-inner{opacity:1;transform:scale(1) rotate(0deg)}
  .catalog-link{display:inline-block;margin-top:30px;color:var(--color-ochre);font-weight:700;text-decoration:none}
  .special-section{background:radial-gradient(110% 130% at 76% -20%,var(--color-ink-soft) 0%,var(--color-ink) 58%)}.special-grid{display:grid;grid-template-columns:1.2fr .8fr;padding-top:92px;padding-bottom:92px}.special-grid article{min-height:390px;box-sizing:border-box}.special-primary{display:grid;grid-template-columns:1fr clamp(190px,21vw,250px);gap:clamp(30px,4.5vw,60px);padding:10px 70px 10px 0;border-right:1px solid rgb(244 242 236/.22)}.special-copy{display:flex;flex-direction:column}.special-visual{align-self:center}.special-secondary{display:flex;flex-direction:column;padding:10px 0 10px 54px}.special-section h3{font-size:clamp(28px,3vw,38px)}.special-section p{max-width:650px;color:rgb(244 242 236/.64);font-size:17px;line-height:1.55}.special-footer{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-top:auto;border-top:1px solid rgb(244 242 236/.15);padding-top:26px}.special-price{font-family:var(--font-display);font-size:clamp(22px,2.4vw,30px);font-weight:800;line-height:1}.special-price small{margin-right:8px;color:rgb(244 242 236/.6);font-family:var(--font-text);font-size:14px;font-weight:600}.special-section a{color:var(--color-gold);font-weight:700;text-decoration:none}.special-secondary dl{margin:auto 0 28px}.special-secondary dl div{display:flex;justify-content:space-between;gap:20px;padding:12px 0;border-bottom:1px solid rgb(244 242 236/.15)}.special-secondary dt{color:rgb(244 242 236/.6)}.special-secondary dd{margin:0;font-weight:700}
  .capabilities-section .wrap{padding-top:0;padding-bottom:90px}.development-line{display:grid;grid-template-columns:230px 1fr auto;gap:30px;align-items:center;border-bottom:1px solid rgb(23 21 15/.22);padding:30px 0;color:inherit;text-decoration:none}.development-line span{color:rgb(23 21 15/.62);line-height:1.5}.development-line b{color:var(--color-ochre)}.capabilities{display:grid;grid-template-columns:1fr 1.5fr;gap:50px;padding:80px 0}.capabilities h2{font-size:clamp(26px,3vw,38px)}.capabilities p{margin:0;font-size:clamp(18px,2.1vw,27px);line-height:1.6}.capabilities i{color:var(--color-gold);font-style:normal}.telegram-help{display:flex;align-items:center;justify-content:space-between;gap:28px;border-top:1px solid rgb(23 21 15/.22);border-bottom:1px solid rgb(23 21 15/.22);padding:24px 0;color:inherit;text-decoration:none}.telegram-help span{display:grid;gap:4px}.telegram-help small{color:rgb(23 21 15/.58);font-size:14px}.telegram-help>b{color:var(--color-ochre)}
  .method-section .section-wrap{padding-top:20px}.method-line{position:relative;display:grid;grid-template-columns:repeat(3,1fr);margin:0;padding:0;border-top:2px solid var(--color-ink);list-style:none}.method-line:before{content:'';position:absolute;top:-5px;left:0;width:9px;height:9px;border-radius:50%;background:var(--color-gold)}.method-line li{padding:30px 36px 8px 0}.method-line li+li{padding-left:36px;border-left:1px solid rgb(23 21 15/.2)}.method-line strong{display:block;margin-top:42px;font-family:var(--font-display);font-size:24px}.method-line p{margin:12px 0 0;color:rgb(23 21 15/.62);line-height:1.5}
  .team-list{border-top:1px solid rgb(244 242 236/.3);border-bottom:1px solid rgb(244 242 236/.3)}.team-list article{display:grid;grid-template-columns:54px 180px 250px 1fr;gap:24px;align-items:start;padding:27px 0}.team-list article+article{border-top:1px solid rgb(244 242 236/.16)}.team-list h3{margin:0;font-family:var(--font-display);font-size:25px}.team-list strong{color:var(--color-gold)}.team-list p{margin:0;color:rgb(244 242 236/.62);line-height:1.5}
  .brief-section{background:var(--color-gold);color:var(--color-ink)}.brief-grid{display:grid;grid-template-columns:1fr auto;gap:48px;align-items:center;padding-top:80px;padding-bottom:80px}.brief-section h2{max-width:720px}.brief-section p{max-width:520px;color:rgb(23 21 15/.7);line-height:1.55}.brief-actions{display:grid;gap:12px}.brief-actions a{padding:19px 30px;font-weight:650;text-align:center;text-decoration:none}.brief-primary{background:var(--color-ink);color:var(--color-paper)}.brief-secondary{border:1.5px solid rgb(23 21 15/.3)}
  .faq-list{display:grid;grid-template-columns:repeat(2,1fr);gap:0;border-top:1px solid rgb(23 21 15/.25);border-left:1px solid rgb(23 21 15/.25)}details{border-right:1px solid rgb(23 21 15/.25);border-bottom:1px solid rgb(23 21 15/.25);padding:24px;background:rgb(255 255 255/.5)}summary{cursor:pointer;font-family:var(--font-display);font-size:17px;font-weight:700;line-height:1.35}details p{color:rgb(23 21 15/.68);line-height:1.55}.final-cta-inner{display:flex;flex-direction:column;align-items:center;gap:30px;padding-top:90px;padding-bottom:90px;text-align:center}.final-cta-inner>div{display:flex;gap:14px}
  @media(max-width:820px){.section-head{align-items:start;flex-direction:column}.special-grid,.capabilities,.brief-grid{grid-template-columns:1fr}.special-primary{grid-template-columns:1fr;min-height:330px;padding:0 0 50px;border-right:0;border-bottom:1px solid rgb(244 242 236/.22)}.special-visual{align-self:start;width:min(230px,62vw);margin-top:38px}.special-secondary{min-height:340px;padding:50px 0 0}.development-line{grid-template-columns:1fr}.solution-list a{grid-template-columns:48px 1fr 20px}.solution-number{font-size:26px;line-height:1.15}.solution-meta{grid-column:2}.method-line{grid-template-columns:1fr}.method-line li+li{padding-left:0;border-left:0;border-top:1px solid rgb(23 21 15/.2)}.method-line strong{margin-top:20px}.team-list article{grid-template-columns:40px 1fr}.team-list strong,.team-list p{grid-column:2}.brief-actions{width:100%}}
  @media(max-width:620px){.section-wrap{padding-top:68px;padding-bottom:74px}.works-grid,.faq-list{grid-template-columns:1fr}.works-grid :global(.case-preview){grid-column:auto}.section-transition{margin-left:0}.solution-list a{gap:14px;padding:24px 0;grid-template-columns:36px 1fr 20px}.solution-number{font-size:20px}.solution-copy strong{font-size:21px}.solution-arrow{font-size:19px}.special-grid{padding-top:70px;padding-bottom:70px}.capabilities{padding:62px 0}.telegram-help{align-items:start;flex-direction:column}.team-list article{grid-template-columns:32px 1fr}.final-cta-inner>div{flex-direction:column;width:100%}.final-cta-inner a{box-sizing:border-box;width:100%}}
</style>
