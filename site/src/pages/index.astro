---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import HeroWall from '../components/HeroWall.astro';
import ProcessChat from '../components/ProcessChat.astro';
import ApproachInfographics from '../components/ApproachInfographics.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProductCard from '../components/ProductCard.astro';
import CasePreview from '../components/CasePreview.astro';
import { faqs, team } from '../data/home';
import { homeProducts } from '../data/products';
import { site } from '../data/site';
import { works } from '../data/works';
---

<Base title="Сайт под вашу задачу — за неделю · 3K Studio">
  <Nav />
  <HeroWall />

  <main>
    <section id="works" class="works-section" data-bg="paper">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <div>
            <span class="mono">работы</span>
            <h2>Работы</h2>
          </div>
          <p>Сначала — реальные задачи бизнеса. В каждом проекте своя логика, объём и путь к заявке.</p>
        </div>
        <div class="works-grid" data-reveal-group>
          {works.filter((item) => item.status === 'planned' || item.homeFeatured).map((item) => <CasePreview work={item} />)}
        </div>
      </div>
    </section>

    <section id="products" class="products-section" data-bg="paper">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <div>
            <span class="mono">форматы и цены</span>
            <h2>Выберите задачу, а не технологию</h2>
          </div>
          <p>Такие задачи собираем в четырёх основных форматах. Цена и срок фиксируются до старта.</p>
        </div>
        <div class="product-grid" data-reveal-group>
          {homeProducts.map((item) => <ProductCard product={item} showIcon />)}
        </div>
        <a class="integration-bridge" href="/products/#integrations" data-reveal>
          <span>
            <strong>Интеграции — внутри задачи</strong>
            <span>Подключим CRM, обновление каталога и внутренние процессы, если они нужны сайту.</span>
          </span>
          <span class="integration-action">Возможности автоматизации →</span>
        </a>
        <a class="tg-banner" href={site.telegramUrl} target="_blank" rel="noopener" data-reveal>
          <span class="tg-badge" aria-hidden="true">
            <img src="/assets/ui/products/telegram.webp" alt="" width="224" height="224" loading="lazy" />
          </span>
          <span class="tg-text">
            <strong>Не знаете, какой формат выбрать?</strong>
            <span>Напишите задачу своими словами — поможем определить подходящий вариант.</span>
          </span>
          <span class="tg-action">Написать в Telegram →</span>
        </a>
        <div class="products-links" data-reveal>
          <a href="/products/">Все форматы и нестандартные задачи →</a>
          <a href="/price/">Прайс расширений →</a>
        </div>
      </div>
    </section>

    <section id="approach" class="approach-section" data-bg="ink">
      <div class="wrap">
        <div class="section-head light" data-reveal>
          <div>
            <span class="mono">подход</span>
            <h2>Как мы считаем и работаем</h2>
          </div>
          <p>Формат проекта меняется, правила — нет: состав работ, права и расширения известны заранее.</p>
        </div>
        <ApproachInfographics />
      </div>
    </section>

    <ProcessChat />

    <section id="team" class="team-section" data-bg="ink" aria-labelledby="team-title">
      <div class="wrap">
        <div class="section-head light" data-reveal>
          <div>
            <span class="mono">команда</span>
            <h2 id="team-title">Отвечают те, кто делает</h2>
          </div>
          <p>Без менеджера-посредника: в рабочем чате стратегия, дизайн и разработка представлены напрямую.</p>
        </div>
        <div class="team-grid" data-reveal-group>
          {team.map((person) => (
            <article>
              <span class="team-role">{person.role}</span>
              <h3>{person.name}</h3>
              <p>{person.fact}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="brief" class="brief-section" data-bg="gold">
      <div class="wrap brief-grid" data-reveal-group>
        <div>
          <span class="mono">конструктор</span>
          <h2>Соберите проект и получите смету</h2>
          <p>3–5 минут. Смета — ориентир, точную цену и срок фиксируем в договоре.</p>
        </div>
        <div class="brief-actions">
          <a class="brief-primary" href="/brief/" data-magnetic>Собрать проект →</a>
          <a class="brief-secondary" href={site.telegramUrl} data-magnetic>Написать в Telegram</a>
        </div>
      </div>
    </section>

    <section id="faq" class="faq-section" data-bg="paper">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <div>
            <span class="mono">FAQ</span>
            <h2>Коротко о важном</h2>
          </div>
        </div>
        <div class="faq-list" data-reveal-group>
          {faqs.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="final-cta" class="final-cta-section" data-bg="ink">
      <div class="wrap final-cta-inner" data-reveal>
        <h2>Готовы обсудить задачу?</h2>
        <div class="final-cta-actions">
          <a class="btn-gold" href="/brief/" data-magnetic>Собрать проект →</a>
          <a class="btn-outline" href={site.telegramUrl} data-magnetic>Написать в Telegram</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .products-section,
  .works-section,
  .faq-section {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .approach-section,
  .team-section {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .wrap {
    padding-top: 90px;
    padding-bottom: 100px;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 46px;
  }

  .section-head > div {
    max-width: 720px;
  }

  .mono {
    color: var(--color-blue);
  }

  .light .mono {
    color: var(--color-gold);
  }

  h2,
  h3,
  p {
    margin: 0;
  }

  h2 {
    margin-top: 12px;
    overflow-wrap: break-word;
    font-family: var(--font-display);
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 800;
    line-height: 1.12;
  }

  .section-head p {
    max-width: 420px;
    color: rgb(23 21 15 / 0.65);
    font-size: 16px;
    line-height: 1.55;
  }

  .light p {
    color: rgb(244 242 236 / 0.62);
  }

  .product-grid,
  .works-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .tg-banner {
    display: flex;
    align-items: center;
    gap: 18px;
    box-sizing: border-box;
    margin-top: 18px;
    border: 1.5px solid rgb(23 21 15 / 0.18);
    background: white;
    padding: 16px 24px;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      box-shadow 0.25s var(--ease-site),
      transform 0.25s var(--ease-site);
  }

  .tg-banner:hover {
    box-shadow: 8px 8px 0 var(--color-gold);
    transform: translate(-2px, -2px);
  }

  .tg-badge {
    display: grid;
    flex: none;
    width: 52px;
    height: 52px;
    place-items: center;
    border-radius: 50%;
    background: rgb(23 21 15 / 0.05);
  }

  .tg-badge img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .tg-text {
    display: grid;
    gap: 3px;
  }

  .tg-text strong {
    font-family: var(--font-display);
    font-size: 19px;
  }

  .tg-text span {
    color: rgb(23 21 15 / 0.6);
    font-size: 14px;
  }

  .tg-action {
    margin-left: auto;
    color: var(--color-ochre);
    font-weight: 700;
    white-space: nowrap;
  }

  .integration-bridge {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-top: 18px;
    border: 1.5px solid rgb(23 21 15 / 0.18);
    padding: 20px 24px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .integration-bridge > span:first-child {
    display: grid;
    gap: 5px;
  }

  .integration-bridge strong {
    font-size: 16px;
  }

  .integration-bridge > span > span {
    color: rgb(23 21 15 / 0.62);
    font-size: 14px;
    line-height: 1.45;
  }

  .integration-action {
    flex: none;
    color: var(--color-ochre);
    font-weight: 700;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .approach-grid article,
  details {
    box-sizing: border-box;
    border: 1.5px solid rgb(23 21 15 / 0.18);
    background: white;
  }

  .approach-grid h3 {
    font-family: var(--font-display);
    font-size: clamp(19px, 2vw, 25px);
    line-height: 1.15;
  }

  .approach-grid p,
  details p {
    color: rgb(23 21 15 / 0.7);
    font-size: 15px;
    line-height: 1.55;
  }

  .approach-grid h3 + p {
    margin-top: 12px;
  }

  .products-links a {
    color: var(--color-ochre);
    font-weight: 700;
    text-decoration: none;
  }

  .products-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 26px;
    margin-top: 34px;
  }

  .approach-grid article {
    display: grid;
    gap: 20px;
    border-color: rgb(244 242 236 / 0.18);
    background: var(--color-ink-soft);
    padding: 18px;
  }

  .approach-grid p {
    color: rgb(244 242 236 / 0.68);
  }

  .works-grid {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .works-grid :global(.case-preview) {
    grid-column: span 3;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .team-grid article {
    min-height: 230px;
    box-sizing: border-box;
    border: 1.5px solid rgb(244 242 236 / 0.18);
    border-color: rgb(244 242 236 / 0.18);
    background: var(--color-ink-soft);
    padding: 24px;
  }

  .team-role {
    color: var(--color-gold);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  .team-grid h3 {
    margin-top: 28px;
    font-family: var(--font-display);
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1.1;
  }

  .team-grid p {
    margin-top: 18px;
    color: rgb(244 242 236 / 0.66);
    font-size: 15px;
    line-height: 1.55;
  }

  .brief-section {
    background: var(--color-gold);
    color: var(--color-ink);
  }

  .brief-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px;
    align-items: center;
  }

  .brief-grid .mono {
    color: rgb(23 21 15 / 0.58);
  }

  .brief-grid h2 {
    max-width: 720px;
    font-size: clamp(36px, 4.8vw, 56px);
  }

  .brief-grid p {
    max-width: 520px;
    margin-top: 18px;
    color: rgb(23 21 15 / 0.72);
    font-size: 16px;
    line-height: 1.55;
  }

  .brief-actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .brief-actions a {
    padding: 20px 34px;
    font-size: 17px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
  }

  .brief-primary {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .brief-secondary {
    border: 1.5px solid rgb(23 21 15 / 0.3);
  }

  .faq-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  details {
    padding: 24px;
  }

  summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
  }

  details p {
    margin-top: 16px;
  }

  .final-cta-section {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .final-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    text-align: center;
    padding-top: 90px;
    padding-bottom: 90px;
  }

  .final-cta-inner h2 {
    margin-top: 0;
    max-width: 620px;
  }

  .final-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }

  .final-cta-actions .btn-outline {
    border-color: rgb(244 242 236 / 0.4);
    color: var(--color-paper);
  }

  @media (max-width: 1020px) {
    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }

  @media (max-width: 760px) {
    .tg-banner {
      flex-wrap: wrap;
      gap: 12px 16px;
      padding: 16px 18px;
    }

    .tg-action {
      margin-left: 70px;
    }

    .integration-bridge {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
      padding: 18px;
    }

    .wrap {
      padding-top: 70px;
      padding-bottom: 78px;
    }

    .section-head,
    .brief-grid {
      align-items: start;
      grid-template-columns: 1fr;
    }

    .section-head {
      flex-direction: column;
    }

    .product-grid,
    .approach-grid,
    .works-grid,
    .team-grid,
    .faq-list {
      grid-template-columns: 1fr;
    }

    .work-card,
    .work-card:nth-child(n + 4) {
      grid-column: auto;
    }

    .brief-actions,
    .brief-actions a {
      width: 100%;
      box-sizing: border-box;
    }
  }
</style>
