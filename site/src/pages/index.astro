---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import HeroWall from '../components/HeroWall.astro';
import ProcessChat from '../components/ProcessChat.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AssetSlot from '../components/AssetSlot.astro';
import ProductCard from '../components/ProductCard.astro';
import CasePreview from '../components/CasePreview.astro';
import { approach, automationExamples, faqs } from '../data/home';
import { briefHref, featuredProducts } from '../data/products';
import { site } from '../data/site';
import { works } from '../data/works';
---

<Base title="Сайт под вашу задачу — за неделю · 3K Studio">
  <Nav />
  <HeroWall />

  <main>
    <section id="works" class="works-section" data-bg="paper">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <div>
            <span class="mono">работы</span>
            <h2>Работы</h2>
          </div>
          <p>Разные форматы, разные ниши, один подход к смете и срокам.</p>
        </div>
        <div class="works-grid" data-reveal-group>
          {works.filter((item) => item.status === 'planned' || item.homeFeatured).map((item) => <CasePreview work={item} />)}
        </div>
      </div>
    </section>

    <section id="products" class="products-section" data-bg="paper">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <div>
            <span class="mono">форматы и цены</span>
            <h2>Выберите задачу, а не технологию</h2>
          </div>
          <p>Цена и срок фиксируются до старта. Расширения считаем отдельно и заранее.</p>
        </div>
        <div class="product-grid" data-reveal-group>
          {featuredProducts.map((item) => <ProductCard product={item} showIcon />)}
        </div>
        <div class="products-links" data-reveal>
          <a href="/products/">Все продукты →</a>
          <a href="/price/">Прайс расширений →</a>
        </div>
      </div>
    </section>

    <section id="approach" class="approach-section" data-bg="ink">
      <div class="wrap">
        <div class="section-head light" data-reveal>
          <div>
            <span class="mono">подход</span>
            <h2>Как мы считаем и работаем</h2>
          </div>
          <p>Без манифестов: устройство работы видно в смете, доступах и процессе.</p>
        </div>
        <div class="approach-grid" data-reveal-group>
          {approach.map((item, index) => (
            <article>
              <AssetSlot label={['ui/estimate-fragment', 'ui/ownership-schema', 'ui/extensions-widget'][index]} tone="dark" />
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <ProcessChat />

    <section id="automation" class="automation-section" data-bg="ink">
      <div class="wrap automation-grid">
        <div data-reveal>
          <span class="mono">интеграции</span>
          <h2>Автоматизация под процесс</h2>
          <p>Убираем ручную рутину: то, что сейчас копируется руками, начинает происходить само.</p>
          <a class="btn-gold" href={briefHref('automation')} data-magnetic>Описать процесс →</a>
        </div>
        <div class="automation-list" data-reveal-group>
          {automationExamples.map((item, index) => (
            <article>
              <span class="mono">пример 0{index + 1}</span>
              <p>{item}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="brief" class="brief-section" data-bg="gold">
      <div class="wrap brief-grid" data-reveal-group>
        <div>
          <span class="mono">конструктор</span>
          <h2>Соберите проект и получите смету</h2>
          <p>3–5 минут. Смета — ориентир, точную цену и срок фиксируем в договоре.</p>
        </div>
        <div class="brief-actions">
          <a class="brief-primary" href="/brief/" data-magnetic>Собрать проект →</a>
          <a class="brief-secondary" href={site.telegramUrl} data-magnetic>Написать в Telegram</a>
        </div>
      </div>
    </section>

    <section id="faq" class="faq-section" data-bg="paper">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <div>
            <span class="mono">FAQ</span>
            <h2>Коротко о важном</h2>
          </div>
        </div>
        <div class="faq-list" data-reveal-group>
          {faqs.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="final-cta" class="final-cta-section" data-bg="ink">
      <div class="wrap final-cta-inner" data-reveal>
        <h2>Готовы обсудить задачу?</h2>
        <div class="final-cta-actions">
          <a class="btn-gold" href="/brief/" data-magnetic>Собрать проект →</a>
          <a class="btn-outline" href={site.telegramUrl} data-magnetic>Написать в Telegram</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .products-section,
  .works-section,
  .faq-section {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .approach-section,
  .automation-section {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .wrap {
    padding-top: 90px;
    padding-bottom: 100px;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 46px;
  }

  .section-head > div {
    max-width: 720px;
  }

  .mono {
    color: var(--color-blue);
  }

  .light .mono,
  .automation-section .mono {
    color: var(--color-gold);
  }

  h2,
  h3,
  p {
    margin: 0;
  }

  h2 {
    margin-top: 12px;
    overflow-wrap: break-word;
    font-family: var(--font-display);
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 800;
    line-height: 1.12;
  }

  .section-head p {
    max-width: 420px;
    color: rgb(23 21 15 / 0.65);
    font-size: 16px;
    line-height: 1.55;
  }

  .light p {
    color: rgb(244 242 236 / 0.62);
  }

  .product-grid,
  .works-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .approach-grid article,
  .automation-list article,
  details {
    box-sizing: border-box;
    border: 1.5px solid rgb(23 21 15 / 0.18);
    background: white;
  }

  .approach-grid h3 {
    font-family: var(--font-display);
    font-size: clamp(19px, 2vw, 25px);
    line-height: 1.15;
  }

  .approach-grid p,
  .automation-section p,
  details p {
    color: rgb(23 21 15 / 0.7);
    font-size: 15px;
    line-height: 1.55;
  }

  .approach-grid h3 + p {
    margin-top: 12px;
  }

  .products-links a {
    color: var(--color-ochre);
    font-weight: 700;
    text-decoration: none;
  }

  .products-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 26px;
    margin-top: 34px;
  }

  .approach-grid article {
    display: grid;
    gap: 20px;
    border-color: rgb(244 242 236 / 0.18);
    background: var(--color-ink-soft);
    padding: 18px;
  }

  .approach-grid p {
    color: rgb(244 242 236 / 0.68);
  }

  .works-grid {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .works-grid :global(.case-preview) {
    grid-column: span 3;
  }

  .automation-grid {
    display: grid;
    grid-template-columns: 390px minmax(0, 1fr);
    gap: 52px;
  }

  .automation-section h2 {
    margin-top: 12px;
  }

  .automation-section p {
    margin-top: 20px;
    color: rgb(244 242 236 / 0.66);
  }

  .automation-section .btn-gold {
    margin-top: 30px;
  }

  .automation-list {
    display: grid;
    gap: 16px;
  }

  .automation-list article {
    border-color: rgb(244 242 236 / 0.18);
    background: var(--color-ink-soft);
    padding: 24px;
  }

  .brief-section {
    background: var(--color-gold);
    color: var(--color-ink);
  }

  .brief-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px;
    align-items: center;
  }

  .brief-grid .mono {
    color: rgb(23 21 15 / 0.58);
  }

  .brief-grid h2 {
    max-width: 720px;
    font-size: clamp(36px, 4.8vw, 56px);
  }

  .brief-grid p {
    max-width: 520px;
    margin-top: 18px;
    color: rgb(23 21 15 / 0.72);
    font-size: 16px;
    line-height: 1.55;
  }

  .brief-actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .brief-actions a {
    padding: 20px 34px;
    font-size: 17px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
  }

  .brief-primary {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .brief-secondary {
    border: 1.5px solid rgb(23 21 15 / 0.3);
  }

  .faq-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  details {
    padding: 24px;
  }

  summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
  }

  details p {
    margin-top: 16px;
  }

  .final-cta-section {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .final-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    text-align: center;
    padding-top: 90px;
    padding-bottom: 90px;
  }

  .final-cta-inner h2 {
    margin-top: 0;
    max-width: 620px;
  }

  .final-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }

  .final-cta-actions .btn-outline {
    border-color: rgb(244 242 236 / 0.4);
    color: var(--color-paper);
  }

  @media (max-width: 1020px) {
    .product-grid,
    .approach-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .automation-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .wrap {
      padding-top: 70px;
      padding-bottom: 78px;
    }

    .section-head,
    .brief-grid {
      align-items: start;
      grid-template-columns: 1fr;
    }

    .section-head {
      flex-direction: column;
    }

    .product-grid,
    .approach-grid,
    .works-grid,
    .faq-list {
      grid-template-columns: 1fr;
    }

    .work-card,
    .work-card:nth-child(n + 4) {
      grid-column: auto;
    }

    .brief-actions,
    .brief-actions a {
      width: 100%;
      box-sizing: border-box;
    }
  }
</style>
