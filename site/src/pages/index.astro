---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import HeroWall from '../components/HeroWall.astro';
import CaseBlock from '../components/CaseBlock.astro';
import PriceRow from '../components/PriceRow.astro';
import ProcessChat from '../components/ProcessChat.astro';
import TeamCol from '../components/TeamCol.astro';
import Marquee from '../components/Marquee.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { cases } from '../data/cases';
import { products, team } from '../data/home';
import { site } from '../data/site';
---

<Base title="Сайт под вашу задачу — за неделю · 3K Studio">
  <Nav />
  <HeroWall />

  <main>
    <section id="cases" class="cases-section" data-bg="paper">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <h2>Проекты, где задача была не только в дизайне</h2>
          <p class="mono">данные, CRM, запуск, управление контентом</p>
        </div>
        <div class="case-grid" data-reveal-group>
          {cases.map((item) => <CaseBlock item={item} />)}
        </div>
        <p class="note mono">имена клиентов не публикуем — кейсы подаём по отрасли</p>
      </div>
    </section>

    <section id="prices" class="prices-section" data-bg="ink">
      <div class="wrap">
        <div class="prices-head" data-reveal>
          <div>
            <h2>Цены — сразу</h2>
            <p>В каждой цене — один круг правок. Пишем и&nbsp;что не&nbsp;входит: так у&nbsp;нас не&nbsp;бывает споров на&nbsp;сдаче.</p>
          </div>
          <span class="mono">БЕЗ «ОСТАВЬТЕ ЗАЯВКУ, МЫ ПЕРЕЗВОНИМ»</span>
        </div>
        <div class="price-list" data-reveal-group>
          {products.map((item) => <PriceRow item={item} />)}
          <div class="line"></div>
        </div>
        <div class="price-cta" data-reveal>
          <a class="btn-gold" href="#brief" data-magnetic>Получить цену за 6 ответов →</a>
          <span>Магазины, записи и нестандартное — оцениваем по задаче, вилку скажем в тот же день.</span>
        </div>
      </div>
    </section>

    <ProcessChat />

    <section id="team" class="team-section" data-bg="ink">
      <div class="wrap">
        <h2 data-reveal="mask">Трое. Лично.</h2>
        <p class="team-lead" data-reveal>Стратегия, дизайн и&nbsp;инженерия — без менеджеров-посредников. В&nbsp;чате отвечает тот, кто делает.</p>
        <div class="team-grid" data-reveal-group>
          {team.map((person, index) => <TeamCol person={person} last={index === team.length - 1} />)}
        </div>
      </div>
    </section>

    <section id="brief" class="brief-section" data-bg="gold">
      <div class="wrap brief-grid" data-reveal-group>
        <div>
          <h2>6 вопросов — и&nbsp;вы видите цену и&nbsp;срок. Без звонка.</h2>
          <p>Бриф занимает три минуты. Вилка — ориентир, не&nbsp;оферта: точную цену зафиксируем в&nbsp;договоре.</p>
        </div>
        <div class="brief-actions">
          <a class="brief-primary" href="/brief/" data-magnetic>Заполнить бриф →</a>
          <a class="brief-secondary" href={site.telegramUrl} data-magnetic>Без формы: {site.telegram}</a>
        </div>
      </div>
      <Marquee />
      <SiteFooter />
    </section>
  </main>
</Base>

<style>
  .cases-section {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .cases-section .wrap {
    padding-top: 90px;
    padding-bottom: 100px;
  }

  .section-head,
  .prices-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 50px;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(34px, 4vw, 44px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .section-head p,
  .prices-head span {
    margin: 0;
    color: var(--color-gold);
  }

  .case-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 20px;
  }

  .case-grid :global(.case:nth-child(3)) {
    grid-column: span 1;
  }

  .note {
    margin: 28px 0 0;
    color: rgb(23 21 15 / 0.55);
  }

  .prices-section {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .prices-section .wrap {
    padding-top: 90px;
    padding-bottom: 100px;
  }

  .prices-head {
    margin-bottom: 14px;
  }

  .prices-head > div {
    max-width: 560px;
  }

  .prices-head p {
    margin: 22px 0 0;
    max-width: 520px;
    color: rgb(244 242 236 / 0.65);
    font-size: 16px;
    line-height: 1.5;
  }

  .price-list {
    margin-top: 50px;
  }

  .line {
    border-top: 2px solid rgb(244 242 236 / 0.25);
  }

  .price-cta {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 44px;
    flex-wrap: wrap;
  }

  .price-cta span {
    max-width: 560px;
    color: rgb(244 242 236 / 0.55);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .team-section {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .team-section .wrap {
    padding-top: 90px;
    padding-bottom: 100px;
  }

  .team-lead {
    margin: 14px 0 50px;
    max-width: 520px;
    color: rgb(244 242 236 / 0.65);
    font-size: 16px;
    line-height: 1.5;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 2px solid rgb(244 242 236 / 0.25);
  }

  .brief-section {
    background: var(--color-gold);
    color: var(--color-ink);
  }

  .brief-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 50px;
    align-items: center;
    padding-top: 90px;
    padding-bottom: 80px;
  }

  .brief-grid h2 {
    max-width: 640px;
    font-size: clamp(36px, 4.8vw, 52px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .brief-grid p {
    max-width: 460px;
    margin: 20px 0 0;
    color: rgb(23 21 15 / 0.75);
    font-size: 16px;
    line-height: 1.5;
  }

  .brief-actions {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 14px;
  }

  .brief-actions a {
    padding: 20px 34px;
    font-size: 17px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
  }

  .brief-primary {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .brief-primary:hover {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .brief-secondary {
    border: 2px solid var(--color-ink);
    color: var(--color-ink);
  }

  .brief-secondary:hover {
    background: var(--color-ink);
    color: var(--color-gold);
  }

  @media (max-width: 900px) {
    .section-head,
    .prices-head,
    .brief-grid {
      align-items: flex-start;
      grid-template-columns: 1fr;
      flex-direction: column;
    }

    .case-grid,
    .team-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .cases-section .wrap,
    .prices-section .wrap,
    .team-section .wrap,
    .brief-grid {
      padding-top: 64px;
      padding-bottom: 72px;
    }

    .brief-actions,
    .brief-actions a {
      width: 100%;
      box-sizing: border-box;
    }
  }
</style>
