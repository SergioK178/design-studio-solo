---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContentShell from '../../components/ContentShell.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Metrics from '../../components/Metrics.svelte';

export async function getStaticPaths() {
  const posts = await getCollection('lab');
  return posts.map((entry) => ({ params: { slug: entry.id.replace(/\.md$/, '') }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} · 3K Studio`}>
  <Nav />
  <PageHeader eyebrow={entry.data.date} title={entry.data.title} lead={entry.data.summary} />
  <ContentShell>
    <Content />
    <Metrics client:load />
  </ContentShell>
  <SiteFooter />
</Base>
