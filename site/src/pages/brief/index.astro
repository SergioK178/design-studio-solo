---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Brief from '../../components/Brief.svelte';
import SiteFooter from '../../components/SiteFooter.astro';
---

<Base title="Разбор задачи · 3K Studio">
  <Nav />
  <main class="brief-page" data-bg="ink">
    <div class="wrap">
      <section class="brief-panel" aria-label="Разбор задачи">
        <Brief client:load />
      </section>
      <noscript>
        <aside>
          <h2>Если JavaScript не загрузился</h2>
          <p>Напишите задачу свободным текстом — заявка уйдёт напрямую нам, без сторонних сервисов.</p>
          <form action="/api/lead" method="post">
            <label>
              <span class="mono">Что должно заработать?</span>
              <textarea name="answers[freeform]" rows="6" placeholder="Сайт, каталог, Telegram, автоматизация — опишите задачу как удобно"></textarea>
            </label>
            <input type="hidden" name="version" value="v2" />
            <input type="hidden" name="project" value="unknown" />
            <input type="text" name="hp" value="" style="display:none" tabindex="-1" autocomplete="off" />
            <input type="hidden" name="ts" value={Date.now()} />
            <button class="fallback-link" type="submit">Отправить заявку</button>
          </form>
        </aside>
      </noscript>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .brief-page {
    background: var(--color-ink);
    color: var(--color-paper);
    min-height: 720px;
    padding: 120px 0 110px;
  }

  .brief-panel {
    min-height: 560px;
  }

  aside {
    border: 1.5px solid rgb(244 242 236 / 0.28);
    padding: 22px;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.2;
  }

  p {
    color: rgb(244 242 236 / 0.68);
    line-height: 1.55;
  }

  form,
  label {
    display: grid;
    gap: 10px;
  }

  form {
    gap: 16px;
  }

  label span {
    color: var(--color-gold);
    font-size: 10px;
  }

  textarea {
    width: 100%;
    border: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 12px;
    font: 500 14px / 1.45 var(--font-text);
    resize: vertical;
  }

  .fallback-link {
    display: block;
    border: 0;
    background: var(--color-gold);
    color: var(--color-ink);
    padding: 14px 16px;
    font: 600 15px / 1.2 var(--font-text);
    text-align: center;
    cursor: pointer;
  }

  @media (max-width: 860px) {
    .brief-page {
      min-height: 640px;
      padding: 96px 0 72px;
    }

    .brief-panel {
      min-height: 500px;
    }
  }
</style>
