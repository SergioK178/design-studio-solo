---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CasePreview from '../../components/CasePreview.astro';
import { works } from '../../data/works';
---

<Base title="Работы · 3K Studio">
  <Nav />
  <PageHeader eyebrow="работы" title="Работы" lead="Разные форматы, разные ниши, один подход к смете и срокам." />
  <main class="works-list" data-bg="paper">
    <div class="wrap grid" data-reveal-group>
      {works.map((item) => <CasePreview work={item} titleTag="h2" />)}
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .works-list {
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 80px 0 100px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
