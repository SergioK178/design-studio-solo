---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import AssetSlot from '../../components/AssetSlot.astro';
import { works } from '../../data/works';
---

<Base title="Работы · 3K Studio">
  <Nav />
  <PageHeader eyebrow="работы" title="Работы" lead="Разные форматы, разные ниши, один подход к смете и срокам." />
  <main class="works-list" data-bg="paper">
    <div class="wrap grid" data-reveal-group>
      {works.map((item) => (
        <a class:list={['card', item.status === 'planned' && 'planned']} href={item.href} data-cursor={item.status === 'planned' ? 'Скоро' : 'Смотреть →'}>
          <AssetSlot label={item.assetKey} src={item.assetSrc} ratio="16 / 10" />
          <div>
            <span class="mono">{item.category}</span>
            <h2>{item.title}</h2>
            <p>{item.inside}</p>
            <strong>{item.status === 'planned' ? 'Место под будущий кейс' : 'Смотреть →'}</strong>
          </div>
        </a>
      ))}
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .works-list {
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 80px 0 100px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .card {
    display: grid;
    border: 1.5px solid rgb(23 21 15 / 0.22);
    background: white;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      box-shadow 0.35s var(--ease-site),
      transform 0.35s var(--ease-site);
  }

  .card:hover {
    box-shadow: 10px 10px 0 var(--color-gold);
    transform: translate(-3px, -3px);
  }

  .card.planned {
    opacity: 0.82;
  }

  .card > div {
    padding: 26px;
  }

  .mono {
    color: var(--color-blue);
  }

  h2 {
    margin: 12px 0 0;
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.15;
  }

  p {
    margin: 16px 0 0;
    color: rgb(23 21 15 / 0.72);
    font-size: 15px;
    line-height: 1.6;
  }

  strong {
    display: inline-block;
    margin-top: 22px;
    color: var(--color-ochre);
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
