---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import AssetSlot from '../../components/AssetSlot.astro';
import { site } from '../../data/site';
import { publishedWorks } from '../../data/works';

const featuresBySlug: Record<string, string[]> = {
  'guest-house': ['Переключатель «владелец/инвестор»', 'Галерея объекта', 'График сезонности', 'Подача цены', 'WhatsApp-заявка'],
  'car-rental': ['Фильтры по классам', 'Карточки авто', '5 шагов выбора', 'Форма заявки', 'Передача заявки менеджеру'],
  'catalog-med': ['Направления каталога', 'Карточки позиций', 'Корзина-заявка «Получить КП»', 'Прайс на скачивание', 'Предметные фото'],
};

export function getStaticPaths() {
  return publishedWorks.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

const { work } = Astro.props;
const features = featuresBySlug[work.slug] ?? [];
const screens = ['desktop-01', 'desktop-02', 'mobile-01', 'mobile-02'];
---

<Base title={`${work.title} · 3K Studio`}>
  <Nav />
  <PageHeader eyebrow={work.category} title={work.title} lead={work.inside} />

  <main class="work-body" data-bg="paper">
    <div class="wrap">
      <section class="hero-shot" data-reveal>
        <AssetSlot label={`${work.assetKey}/hero`} src={work.assetSrc} ratio="16 / 9" />
      </section>

      <section class="screen-grid" aria-label="Экраны проекта" data-reveal-group>
        {screens.map((screen, index) => (
          <AssetSlot label={`works/${work.slug}/${screen}`} ratio={index > 1 ? '9 / 14' : '16 / 10'} />
        ))}
      </section>

      <section class="assembled" data-reveal>
        <div>
          <span class="mono">из чего собрано</span>
          <h2>Функции без техжаргона</h2>
        </div>
        <ul>
          {features.map((feature) => <li>{feature}</li>)}
        </ul>
      </section>

      <section class="cta" data-reveal>
        <div>
          <span class="mono">похожая задача?</span>
          <h2>Соберите проект в конструкторе</h2>
          <p>Ответьте на несколько вопросов — получите ориентир по цене и сроку. Точную смету фиксируем после проверки деталей.</p>
        </div>
        <div class="actions">
          <a class="btn-gold" href="/brief/" data-magnetic>Собрать проект →</a>
          <a class="btn-outline dark" href={site.telegramUrl} data-magnetic>Написать в Telegram</a>
        </div>
      </section>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .work-body {
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 70px 0 100px;
  }

  .hero-shot {
    margin-bottom: 54px;
  }

  .screen-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .screen-grid :global(.asset-slot:nth-child(-n + 2)) {
    grid-column: span 2;
  }

  .assembled,
  .cta {
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    gap: 50px;
    margin-top: 70px;
    border-top: 2px solid rgb(23 21 15 / 0.18);
    padding-top: 34px;
  }

  .mono {
    color: var(--color-blue);
  }

  h2 {
    margin: 12px 0 0;
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 42px);
    line-height: 1.14;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border: 1.5px solid rgb(23 21 15 / 0.2);
    background: white;
    padding: 12px 14px;
    color: rgb(23 21 15 / 0.78);
    font-size: 14.5px;
  }

  .cta p {
    max-width: 560px;
    margin: 16px 0 0;
    color: rgb(23 21 15 / 0.72);
    font-size: 16px;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    align-items: start;
    flex-wrap: wrap;
    gap: 14px;
  }

  .btn-outline.dark {
    border-color: rgb(23 21 15 / 0.3);
    color: var(--color-ink);
  }

  @media (max-width: 860px) {
    .screen-grid,
    .assembled,
    .cta {
      grid-template-columns: 1fr;
    }

    .screen-grid :global(.asset-slot:nth-child(-n + 2)) {
      grid-column: auto;
    }
  }
</style>
