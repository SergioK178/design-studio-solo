---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import AssetSlot from '../../components/AssetSlot.astro';
import EditorialCase from '../../components/EditorialCase.astro';
import ShowroomCase from '../../components/ShowroomCase.astro';
import CaseDetail from '../../components/CaseDetail.astro';
import { site } from '../../data/site';
import { briefHref, products } from '../../data/products';

export async function getStaticPaths() {
  const entries = await getCollection('cases', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({ params: { slug: entry.id.replace(/\.md$/, '') }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const slug = entry.id.replace(/\.md$/, '');
const { Content } = await render(entry);
const product = products.find((item) => item.slug === data.productSlug);
---

<Base title={`${data.title} · 3K Studio`}>
  <Nav />
  {data.presentation?.variant === 'detail' ? (
    <CaseDetail
      slug={slug}
      title={data.title}
      category={data.category}
      client={data.client}
      audience={data.audience}
      task={data.task}
      constraints={data.constraints}
      solution={data.solution}
      screens={data.screens}
      role={data.role}
      result={data.result}
      stack={data.stack}
      presentation={data.presentation}
      productName={product?.name}
      productHref={product ? briefHref(product) : undefined}
    />
  ) : data.presentation?.variant === 'editorial' ? (
    <EditorialCase title={data.title} category={data.category} solution={data.solution} task={data.task} role={data.role} result={data.result} stack={data.stack} presentation={data.presentation} />
  ) : data.presentation?.variant === 'showroom' ? (
    <ShowroomCase
      slug={slug}
      title={data.title}
      category={data.category}
      client={data.client}
      audience={data.audience}
      task={data.task}
      constraints={data.constraints}
      solution={data.solution}
      screens={data.screens}
      role={data.role}
      result={data.result}
      stack={data.stack}
      presentation={data.presentation}
      productName={product?.name}
      productHref={product ? briefHref(product) : undefined}
    />
  ) : <>
  <PageHeader eyebrow={data.category} title={data.title} lead={data.solution} />

  <main class="work-body" data-bg="paper">
    <div class="wrap">
      <section class="context" data-reveal-group>
        <article>
          <span class="mono">клиент и аудитория</span>
          <p>{data.client}</p>
          <p>{data.audience}</p>
        </article>
        <article>
          <span class="mono">задача</span>
          <p>{data.task}</p>
        </article>
        <article class="constraints">
          <span class="mono">ограничения</span>
          <ul>{data.constraints.map((item) => <li>{item}</li>)}</ul>
        </article>
      </section>

      <section class="hero-shot" data-reveal>
        <div class="hero-pair">
          <AssetSlot label={`works/${slug}/cover-desktop`} frame="browser" />
          <AssetSlot label={`works/${slug}/cover-mobile`} frame="mobile" ratio="9 / 16" />
        </div>
      </section>

      <section class="screen-grid" aria-label="Экраны проекта" data-reveal-group>
        {data.screens.map((screen) => (
          <AssetSlot label={`works/${slug}/screens/${screen.id}`} caption={screen.caption} />
        ))}
      </section>

      <section class="technical" data-reveal>
        <span class="mono">техническая и операционная часть</span>
        <div class="prose">
          <Content />
        </div>
        <ul class="stack">
          {data.stack.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="role-result" data-reveal-group>
        <article>
          <span class="mono">роль 3K Studio</span>
          <p>{data.role}</p>
        </article>
        <article>
          <span class="mono">результат</span>
          <ul>{data.result.map((item) => <li>{item}</li>)}</ul>
        </article>
      </section>

      <section class="cta" data-reveal>
        <div>
          <span class="mono">похожая задача?</span>
          <h2>Разберите задачу в брифе</h2>
          <p>Ответьте на несколько вопросов — предложим формат и ориентир по цене и сроку. Точную смету фиксируем после проверки деталей.</p>
        </div>
        <div class="actions">
          {product && <a class="btn-gold" href={briefHref(product)} data-magnetic>Разобрать похожую задачу →</a>}
          <a class="btn-outline dark" href={site.telegramUrl} data-magnetic>Написать в Telegram</a>
        </div>
      </section>
    </div>
  </main>
  </>}
  <SiteFooter />
</Base>

<style>
  .work-body {
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 70px 0 100px;
  }

  .mono {
    color: var(--color-blue);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .context {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 54px;
  }

  .context article {
    border-top: 2px solid rgb(23 21 15 / 0.2);
    padding-top: 20px;
  }

  .context p,
  .role-result p,
  .technical .prose :global(p) {
    color: rgb(23 21 15 / 0.72);
    font-size: 16px;
    line-height: 1.6;
    margin: 10px 0 0;
  }

  .constraints ul,
  .role-result ul {
    margin: 10px 0 0;
    padding-left: 20px;
  }

  .constraints li,
  .role-result li {
    color: rgb(23 21 15 / 0.72);
    font-size: 15px;
    line-height: 1.55;
    margin-bottom: 6px;
  }

  .hero-shot {
    margin-bottom: 54px;
  }

  .hero-pair {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .screen-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .screen-grid :global(.asset-slot-figure:nth-child(-n + 2)) {
    grid-column: span 2;
  }

  .technical,
  .role-result,
  .cta {
    margin-top: 70px;
    border-top: 2px solid rgb(23 21 15 / 0.18);
    padding-top: 34px;
  }

  .technical .prose {
    max-width: 72ch;
    margin-top: 16px;
  }

  .technical .prose :global(h2) {
    margin: 28px 0 8px;
    font-family: var(--font-display);
    font-size: 22px;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    border: 1.5px solid rgb(23 21 15 / 0.2);
    background: white;
    padding: 8px 12px;
    color: rgb(23 21 15 / 0.7);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .role-result {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .cta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .cta h2 {
    margin: 12px 0 0;
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 42px);
    line-height: 1.14;
    flex-basis: 100%;
  }

  .cta p {
    max-width: 560px;
    margin: 16px 0 0;
    color: rgb(23 21 15 / 0.72);
    font-size: 16px;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    align-items: start;
    flex-wrap: wrap;
    gap: 14px;
  }

  .btn-outline.dark {
    border-color: rgb(23 21 15 / 0.3);
    color: var(--color-ink);
  }

  @media (max-width: 860px) {
    .context,
    .screen-grid,
    .hero-pair,
    .role-result {
      grid-template-columns: 1fr;
    }

    .screen-grid :global(.asset-slot-figure:nth-child(-n + 2)) {
      grid-column: auto;
    }
  }
</style>
