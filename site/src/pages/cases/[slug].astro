---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('cases');
  return entries.map((entry) => ({ params: { slug: entry.id.replace(/\.md$/, '') }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { tag, term, digit, productType, accent, flow } = entry.data;
---

<Base title={`${entry.data.title} · 3K Studio`}>
  <Nav />
  <PageHeader eyebrow={`${tag} · ${term}`} title={entry.data.title} lead={entry.data.summary} />

  <main class="case-body" data-bg="paper" style={`--case-accent: var(--color-${accent})`}>
    <div class="wrap">
      <figure class="frame" data-reveal>
        <figcaption class="chrome" aria-hidden="true">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="mono">{entry.data.title}</span>
        </figcaption>
        <div class="canvas" data-parallax>
          <div class="hatch"></div>
          <span class="mono holder">скриншоты проекта готовим к публикации</span>
        </div>
      </figure>

      <div class="layout">
        <aside class="rail">
          <div class="sticky">
            <dl>
              <dt class="mono">отрасль</dt>
              <dd>{tag}</dd>
              <dt class="mono">срок</dt>
              <dd>{term}</dd>
              <dt class="mono">формат</dt>
              <dd>{productType}</dd>
            </dl>
            <strong class="digit" data-countup>{digit}</strong>
          </div>
        </aside>

        <article class="content">
          {flow.length > 0 && (
            <div class="flow-block" data-reveal>
              <span class="mono">схема решения</span>
              <div class="flow" aria-label={flow.join(' → ')}>
                {flow.map((node, index) => (
                  <>
                    {index > 0 && <i class="link" aria-hidden="true"></i>}
                    <span class="node mono">{node}</span>
                  </>
                ))}
              </div>
            </div>
          )}

          <div class="prose">
            <Content />
          </div>

          <div class="cta" data-reveal>
            <h2>Похожа задача?</h2>
            <p>Опишите её в шести ответах. Мы покажем ориентир по цене и сроку без звонка.</p>
            <div>
              <a class="btn-gold" href="/brief/" data-magnetic>Заполнить бриф</a>
              <a class="btn-outline dark" href={site.telegramUrl} data-magnetic>Написать в Telegram</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .case-body {
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 70px 0 100px;
  }

  /* Рамка под будущие скриншоты: браузерный хром + штриховка в акценте кейса.
     Внутренности двигает параллакс (motion.ts, data-parallax). */
  .frame {
    margin: 0 0 70px;
    border: 1.5px solid rgb(23 21 15 / 0.3);
    background: white;
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 16px;
    border-bottom: 1.5px solid rgb(23 21 15 / 0.3);
    padding: 12px 16px;
  }

  .chrome .mono {
    color: rgb(23 21 15 / 0.5);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid rgb(23 21 15 / 0.4);
  }

  .canvas {
    position: relative;
    height: clamp(260px, 38vw, 460px);
    overflow: hidden;
  }

  .hatch {
    position: absolute;
    inset: -12% 0;
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--case-accent) 22%, transparent),
      color-mix(in srgb, var(--case-accent) 22%, transparent) 10px,
      color-mix(in srgb, var(--case-accent) 7%, transparent) 10px,
      color-mix(in srgb, var(--case-accent) 7%, transparent) 20px
    );
    will-change: transform;
  }

  .holder {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: var(--color-paper);
    border: 1.5px solid rgb(23 21 15 / 0.3);
    padding: 10px 16px;
    color: rgb(23 21 15 / 0.6);
  }

  .layout {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 70px;
    align-items: start;
  }

  .rail .sticky {
    position: sticky;
    top: 48px;
  }

  dl {
    margin: 0;
    border-top: 2px solid rgb(23 21 15 / 0.2);
  }

  dt {
    padding-top: 18px;
    color: var(--color-blue);
  }

  dd {
    margin: 6px 0 18px;
    border-bottom: 1.5px solid rgb(23 21 15 / 0.14);
    padding-bottom: 18px;
    font-weight: 600;
    font-size: 16.5px;
  }

  dd:last-of-type {
    border-bottom: 0;
  }

  .digit {
    display: block;
    margin-top: 26px;
    color: var(--case-accent);
    font-family: var(--font-display);
    font-size: clamp(44px, 4.6vw, 64px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* Схема решения: узлы + живые пунктирные связки. */
  .flow-block {
    margin-bottom: 56px;
    border-top: 2px solid rgb(23 21 15 / 0.2);
    padding-top: 22px;
  }

  .flow-block > .mono {
    color: var(--color-blue);
  }

  .flow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 0;
    margin-top: 18px;
  }

  .node {
    border: 1.5px solid rgb(23 21 15 / 0.4);
    background: white;
    padding: 12px 14px;
    color: var(--color-ink);
  }

  .link {
    position: relative;
    width: 34px;
    height: 1.5px;
    flex: none;
    background-image: repeating-linear-gradient(
      90deg,
      var(--case-accent) 0 6px,
      transparent 6px 12px
    );
    animation: flowDash 1.1s linear infinite;
  }

  .link::after {
    content: '';
    position: absolute;
    right: -1px;
    top: -3.25px;
    border-left: 6px solid var(--case-accent);
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
  }

  @keyframes flowDash {
    to {
      background-position: 12px 0;
    }
  }

  .prose :global(h2) {
    margin: 44px 0 16px;
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.16;
    letter-spacing: -0.01em;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(li) {
    color: rgb(23 21 15 / 0.78);
    font-size: 17px;
    line-height: 1.7;
  }

  .prose :global(ul) {
    margin: 18px 0 0;
    padding-left: 22px;
  }

  .cta {
    margin-top: 56px;
    border-top: 2px solid rgb(23 21 15 / 0.2);
    padding-top: 32px;
  }

  .cta h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 38px);
  }

  .cta p {
    margin: 14px 0 0;
    color: rgb(23 21 15 / 0.72);
  }

  .cta div {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 24px;
  }

  .dark {
    border-color: rgb(23 21 15 / 0.35);
    color: var(--color-ink);
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .rail .sticky {
      position: static;
    }

    .digit {
      margin-top: 18px;
    }
  }
</style>
