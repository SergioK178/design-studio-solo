---
/**
 * Иконка кейса из единого набора Phosphor.
 * Принимает имя глифа («barcode») либо путь к растровому файлу («/assets/ui/case/crm.webp») —
 * второй вариант нужен кейсам, где иконки ещё не переведены на SVG.
 */
import { caseIcons, type CaseIconName } from '../data/case-icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const isFile = name.startsWith('/');
const body = isFile ? null : caseIcons[name as CaseIconName];
---

{isFile ? (
  <img src={name} alt="" width={size} height={size} loading="lazy" class={className} />
) : body ? (
  <svg
    class={className}
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 256 256"
    width={size}
    height={size}
    fill="currentColor"
    aria-hidden="true"
    set:html={body}
  />
) : (
  <span class="cc-icon-pending" aria-hidden="true"></span>
)}
