---
// Подпись сайта (spec §10.5): штамп = живые метрики, одно целое.
// Живые значения помечены data-live — их обновит островок метрик.
import { site, stampLive } from '../data/site';

interface Props {
  sheet: string; // «01 · Главная»
  cells?: { lbl: string; val: string }[]; // замена двух живых ячеек на внутренних страницах
}
const { sheet, cells } = Astro.props;
---

<div class="stamp">
  <div class="cell id"><span class="lbl">Бренд</span><span class="val">{site.name}</span></div>
  <div class="cell"><span class="lbl">Раздел</span><span class="val">{sheet}</span></div>
  <div class="cell">
    <span class="lbl">Собрано</span>
    <span class="val" data-live="built">{stampLive.builtAt} · рев. {stampLive.rev}</span>
  </div>
  {
    cells ? (
      cells.map((c) => (
        <div class="cell">
          <span class="lbl">{c.lbl}</span>
          <span class="val">{c.val}</span>
        </div>
      ))
    ) : (
      <>
        <div class="cell">
          <span class="lbl">TTFB · живой</span>
          <span class="val live" data-live="ttfb">{stampLive.ttfbMs} мс</span>
        </div>
        <div class="cell">
          <span class="lbl">Вес страницы</span>
          <span class="val live" data-live="weight">{stampLive.weightKb} КБ</span>
        </div>
      </>
    )
  }
  <div class="cell">
    <span class="lbl">Telegram</span>
    <span class="val"><a href={site.telegramUrl}>{site.telegram}</a></span>
  </div>
</div>

<style>
  .stamp {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.5fr 1fr 1fr 1.2fr;
    border-bottom: 1px solid var(--color-ink);
  }
  .cell {
    padding: 10px 16px 12px;
    border-left: 1px solid var(--color-rule-soft);
    min-width: 0;
  }
  .cell:first-child {
    border-left: none;
  }
  .lbl {
    display: block;
    margin-bottom: 7px;
    white-space: nowrap;
  }
  .val {
    font: 400 clamp(13px, 1.25vw, 17px) / 1.25 var(--font-mono);
  }
  .val.live {
    color: var(--color-sign);
  }
  .cell.id .val {
    font-family: var(--font-display);
    font-weight: 800;
  }
  .val a {
    color: var(--color-sign);
    text-decoration: none;
  }
  .val a:hover {
    text-decoration: underline;
  }
  /* складывание штампа (проба r3): 900 → 3 колонки, 520 → 2 */
  @media (max-width: 900px) {
    .stamp {
      grid-template-columns: repeat(3, 1fr);
    }
    .cell:nth-child(n + 4) {
      border-top: 1px solid var(--color-rule-soft);
    }
    .cell:nth-child(4) {
      border-left: none;
    }
  }
  @media (max-width: 520px) {
    .stamp {
      grid-template-columns: 1fr 1fr;
    }
    .cell:nth-child(n + 3) {
      border-top: 1px solid var(--color-rule-soft);
    }
    .cell:nth-child(odd) {
      border-left: none;
    }
    .cell:nth-child(even) {
      border-left: 1px solid var(--color-rule-soft);
    }
  }
</style>
