---
import AssetSlot from './AssetSlot.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  category: string;
  solution: string;
  task: string;
  role: string;
  result: string[];
  stack: string[];
  presentation: any;
}

const { title, category, solution, task, role, result, stack, presentation } = Astro.props;
const [owner, investor] = presentation.scenarios;
const { artDirection, engineering } = presentation;
---

<main class="editorial-case" data-bg="paper">
  <section class="case-hero" data-bg="ink">
    <div class="wrap hero-grid" data-reveal-group>
      <div class="hero-copy">
        <p class="eyebrow">{title} · {category} · {presentation.year}</p>
        <h1>Сайт дома у моря<br />с двумя сценариями покупки</h1>
        <p class="place">{presentation.location}</p>
        <p class="lead">{solution}</p>
      </div>
      <div class="hero-side">
        <dl class="hero-meta">
          {presentation.facts.map((fact: any) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
        </dl>
        <a class="case-button case-button--hero" href={presentation.projectUrl} target="_blank" rel="noreferrer">Смотреть сайт <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <div class="wrap editorial-flow">
    <section class="cover" data-reveal>
      <AssetSlot label="Главный экран проекта" src="/assets/works/guest-house/screens/hero.webp" alt="Hero страницы «Приморская 22А» с переключателем «Владелец / Инвестор»" frame="plain" ratio="4 / 3" priority />
      <p class="caption">Главный экран — архитектура и факты об объекте, без рекламных обещаний.</p>
    </section>

    <section class="context" data-reveal-group>
      <article class="task">
        <span class="section-label">Задача</span><i class="rule-mark"></i>
        <h2>Продать дорогой частный дом без агентства</h2>
        <p>{task}</p>
      </article>
      <aside class="audience">
        <span class="section-label">Кому продаём</span><i class="rule-mark"></i>
        {presentation.scenarios.map((scenario: any) => <div><strong>{scenario.label}</strong><span>{scenario.title}</span></div>)}
      </aside>
    </section>

    <section class="metrics" aria-label="Коротко об объекте" data-reveal-group>
      {presentation.metrics.map((metric: any) => <article><strong>{metric.value}</strong><i class="rule-mark"></i><span>{metric.label}</span></article>)}
    </section>

    <section class="scenarios" data-reveal>
      <div class="section-heading">
        <span class="section-label">Ключевая идея</span><i class="rule-mark"></i>
        <h2>Один объект — два сценария покупки</h2>
        <p>Семье — пространство, приватность и жизнь у моря. Инвестору — доходность, сезонность и потенциал объекта.</p>
      </div>
      <div class="scenario-tabs" role="tablist" aria-label="Сценарии покупки">
        <button type="button" id={`tab-${owner.id}`} role="tab" aria-selected="true" aria-controls={`panel-${owner.id}`} data-scenario-tab={owner.id}>{owner.label}</button>
        <button type="button" id={`tab-${investor.id}`} role="tab" aria-selected="false" aria-controls={`panel-${investor.id}`} data-scenario-tab={investor.id}>{investor.label}</button>
      </div>
      <div class="scenario-panels" aria-label="Сравнение сценариев">
        {presentation.scenarios.map((scenario: any, index: number) => (
          <article id={`panel-${scenario.id}`} class:list={['scenario-panel', index === 0 && 'is-active']} aria-labelledby={`tab-${scenario.id}`} data-scenario-panel={scenario.id}>
            <AssetSlot
              label={scenario.label}
              src={`/assets/works/guest-house/screens/${scenario.id === 'owner' ? 'buyer' : 'investor'}.webp`}
              alt={`Экран сценария «${scenario.label}» — ${scenario.title}`}
              frame="plain"
              ratio="2400 / 1078"
            />
            <div class="scenario-copy"><h3>{scenario.title}</h3><p>{scenario.description}</p><span>{scenario.caption}</span></div>
          </article>
        ))}
      </div>
    </section>

    <section class="art-direction" data-reveal>
      <div class="section-heading">
        <span class="section-label">Арт-дирекшн</span><i class="rule-mark"></i>
        <h2>{artDirection.title}</h2>
        <p>{artDirection.description}</p>
      </div>
      <div class="art-sample" aria-label="Пример визуального языка">
        <span>Дом у моря<br />в Ольгинке</span>
        <p>Частный объект площадью 1 082 м² для жизни, отдыха и инвестиций.</p>
        <button type="button">Оставить заявку <span aria-hidden="true">→</span></button>
        <small>«Факты и архитектура — вместо обещаний»</small>
      </div>
      <div class="art-notes">
        <article><span>Шрифты</span><strong>{artDirection.typography}</strong></article>
        <article><span>Голос</span><strong>{artDirection.voice}</strong></article>
        <article class="art-palette">
          <span>Палитра</span>
          <div class="swatches">{artDirection.palette.map((color: string) => <i style={`--swatch: ${color}`}><b>{color}</b></i>)}</div>
        </article>
      </div>
    </section>

    <section class="interface" data-reveal-group>
      <div class="section-heading">
        <span class="section-label">Подача объекта</span><i class="rule-mark"></i>
        <h2>Дом продают цифры, а не эпитеты</h2>
        <p>То, о чём покупатель спросит первым, стоит на странице открытым текстом. Ни одного «уточните стоимость» и «уникальной локации».</p>
      </div>

      <div class="spec-row">
        <article class="spec-price">
          <span class="spec-kicker">Цена</span>
          <strong>94,9 млн ₽</strong>
          <em>87 700 ₽ за м² общей площади</em>
          <p>Цена стоит крупно и один раз, рядом — расчёт за метр. Семье это экономит звонок, инвестору даёт с чем сравнивать.</p>
        </article>
        <article class="spec-distance">
          <span class="spec-kicker">Расстояния</span>
          <dl>
            <div><dt>До пляжа</dt><dd>50 м</dd></div>
            <div><dt>Центр и набережная</dt><dd>5 мин</dd></div>
            <div><dt>Туапсе</dt><dd>~30 км</dd></div>
            <div><dt>Аэропорт Геленджик</dt><dd>~100 км</dd></div>
            <div><dt>Аэропорт Краснодар</dt><dd>~170 км</dd></div>
          </dl>
          <p>Место объяснено километрами и минутами, а не словом «рядом».</p>
        </article>
      </div>

      <div class="spec-notes">
        <article><h3>Факт впереди текста</h3><p>Площадь, комнаты и метры до моря идут сразу под первым экраном — дом читается по диагонали за несколько секунд.</p></article>
        <article><h3>Фотографии вместо рендеров</h3><p>Настоящий фасад, номера и вид на бухту. Дорогой объект не нуждается в приукрашивании, а покупатель всё равно сверит с реальностью.</p></article>
        <article><h3>Один клик до собственника</h3><p>Написать можно из любой точки страницы — телефон, WhatsApp и Telegram идут рядом с фактами, а не в конце.</p></article>
      </div>

      <div class="mobile-showcase">
        <div class="phone">
          <AssetSlot label="Мобильный экран: hero" src="/assets/works/guest-house/screens/mobile-hero.webp" alt="Мобильный hero с переключателем «Будущий владелец / Инвестор» и кнопкой «Посмотреть дом»" frame="plain" ratio="390 / 844" />
        </div>
        <p class="mobile-note">С телефона смотрят чаще всего — прямо в дороге или на пляже. Крупная типографика, тот же переключатель сценария и переход в мессенджер в один палец.</p>
        <div class="phone phone--raised">
          <AssetSlot label="Мобильный экран: заявка" src="/assets/works/guest-house/screens/mobile-view.webp" alt="Мобильный экран «Договоритесь о просмотре» с прямым телефоном собственника" frame="plain" ratio="390 / 844" />
        </div>
      </div>
    </section>

    <section class="engineering" data-reveal>
      <div class="section-heading">
        <span class="section-label">Как это работает</span><i class="rule-mark"></i>
        <h2>{engineering.title}</h2>
      </div>
      <div class="engineering-stats">
        {engineering.stats.map((stat: any) => <article><strong>{stat.value}</strong><span>{stat.label}</span></article>)}
      </div>
      <div class="engineering-points">
        {engineering.points.map((point: any) => <article><h3>{point.title}</h3><p>{point.text}</p></article>)}
      </div>
      <p class="tech-note">{engineering.techNote}<span class="tech-stack">{stack.slice(0, 6).join(' · ')}</span></p>
    </section>

    <section class="outcome" data-reveal-group>
      <article class="outcome-result">
        <span class="section-label">Результат</span><i class="rule-mark rule-mark--light"></i>
        <ul>{result.map((item) => <li>{item}</li>)}</ul>
      </article>
      <article class="outcome-role">
        <span class="section-label">Роль 3K Studio</span><i class="rule-mark rule-mark--light"></i>
        <h2>{role}</h2>
      </article>
    </section>

    <section class="case-cta" data-reveal>
      <div>
        <span class="section-label">Обсудить проект</span><i class="rule-mark"></i>
        <h2>Есть объект или продукт, которому нужна собственная логика продажи?</h2>
        <p>{presentation.cta.copy}</p>
      </div>
      <div class="cta-actions">
        <a class="case-button case-button--cta" href={site.telegramUrl} data-magnetic>Обсудить проект <span aria-hidden="true">→</span></a>
        <a class="telegram-link" href={site.telegramUrl}>Написать в Telegram ↗</a>
      </div>
    </section>
  </div>
</main>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-scenario-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-scenario-panel]'));
  const selectScenario = (id: string) => {
    tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.scenarioTab === id)));
    panels.forEach((panel) => panel.classList.toggle('is-active', panel.dataset.scenarioPanel === id));
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectScenario(tab.dataset.scenarioTab ?? ''));
    tab.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      tabs[next]?.focus(); selectScenario(tabs[next]?.dataset.scenarioTab ?? '');
    });
  });
</script>

<style>
  /* ─────────────────────────────────────────────────────────────
     Editorial-кейс: одна шкала типографики, один шаг отступов,
     одна 12-колоночная сетка. Правки вносим здесь, а не слоями. */
  .editorial-case {
    --font-hero: clamp(46px, 4.2vw, 64px);
    --font-section: clamp(34px, 3.2vw, 48px);
    --font-card-title: 23px;
    --font-lead: 18px;
    --font-body: 17px;
    --font-secondary: 16px;
    --font-caption: 14px;
    --font-label: 13px;
    --case-gap: 128px;
    --case-gap-cta: 160px;
    --col-gap: 24px;
    --line-ink: rgb(23 21 15 / .16);
    --text-soft: rgb(23 21 15 / .68);
    --text-soft-light: rgb(244 242 236 / .74);
    background: var(--color-paper);
    color: var(--color-ink);
    padding-bottom: 120px;
    overflow-x: clip;
  }

  /* Общие примитивы */
  .eyebrow, .section-label {
    display: block;
    color: var(--color-ochre);
    font-family: var(--font-text);
    font-size: var(--font-label);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .rule-mark { display: block; width: 28px; height: 1px; margin-top: 14px; background: rgb(23 21 15 / .3); }
  .rule-mark--light { background: rgb(244 242 236 / .34); }
  h1, h2, h3 { font-family: var(--font-display); letter-spacing: -.04em; text-wrap: balance; }
  .caption, figcaption { max-width: 62ch; color: var(--text-soft); font-size: var(--font-caption); line-height: 1.45; }

  .case-button {
    display: inline-flex; align-items: center; justify-content: space-between; gap: 24px;
    height: 52px; box-sizing: border-box; padding: 0 20px 0 24px;
    background: var(--color-gold); color: var(--color-ink);
    font-size: 15px; font-weight: 600; line-height: 1; text-decoration: none;
    transition: background-color .18s ease, transform .18s ease;
  }
  .case-button:hover { background: color-mix(in srgb, var(--color-gold) 86%, white); transform: translateY(-1px); }
  .case-button:focus-visible { outline-color: var(--color-paper); }
  .case-button--hero { min-width: 196px; }
  .case-button--cta { width: min(100%, 352px); height: 60px; padding-inline: 28px 24px; font-size: 17px; }

  /* Единая рамка для всех скриншотов сайта */
  .editorial-case :global(.asset-slot) { border: 1px solid var(--line-ink); }
  .cover :global(.asset-slot) { box-shadow: 0 18px 44px rgb(23 21 15 / .1); }

  /* ── Первый экран ── */
  .case-hero { min-height: 580px; box-sizing: border-box; background: var(--color-ink); color: var(--color-paper); padding: 120px 0 104px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 8.333%; align-items: end; }
  .hero-copy h1 { max-width: 800px; margin: 18px 0 0; font-size: var(--font-hero); line-height: .96; letter-spacing: -.045em; }
  .place { margin: 22px 0 0; color: var(--color-gold); font-size: 21px; }
  .lead { max-width: 600px; margin: 24px 0 0; color: var(--text-soft-light); font-size: var(--font-lead); line-height: 1.5; text-wrap: pretty; }
  .hero-side { align-self: end; margin-bottom: 16px; }
  .hero-meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin: 0 0 28px; border-block: 1px solid rgb(244 242 236 / .2); padding: 22px 0; }
  .hero-meta dt { margin-bottom: 7px; color: rgb(244 242 236 / .52); font-size: var(--font-label); }
  .hero-meta dd { margin: 0; font-size: 15px; line-height: 1.4; }

  /* ── Поток секций ── */
  .editorial-flow { display: grid; gap: var(--case-gap); }
  .cover { margin-top: -68px; }
  .caption { margin: 16px 0 0; }
  .editorial-flow > .case-cta { margin-top: calc(var(--case-gap-cta) - var(--case-gap)); }

  /* ── Задача ── */
  .context { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); }
  .task { grid-column: 1 / span 7; }
  .audience { grid-column: 9 / -1; }
  .task h2 { max-width: 640px; margin: 26px 0 0; font-size: clamp(30px, 2.6vw, 38px); line-height: 1; }
  .task p { max-width: 600px; margin: 24px 0 0; color: var(--text-soft); font-size: var(--font-body); line-height: 1.55; text-wrap: pretty; }
  .audience > div { margin-top: 22px; padding-top: 16px; border-top: 1px solid rgb(23 21 15 / .14); }
  .audience strong { display: block; font-size: var(--font-card-title); font-family: var(--font-display); letter-spacing: -.03em; }
  .audience span { display: block; margin-top: 8px; color: var(--text-soft); font-size: var(--font-secondary); line-height: 1.45; }

  /* ── Коротко об объекте ── */
  .metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--col-gap); }
  .metrics article { display: flex; flex-direction: column; border-top: 1px solid rgb(23 21 15 / .28); padding-top: 20px; }
  .metrics strong { font-family: var(--font-display); font-size: clamp(26px, 2.4vw, 34px); line-height: 1; letter-spacing: -.04em; }
  .metrics .rule-mark { width: 20px; margin: 20px 0 12px; }
  .metrics span { color: var(--text-soft); font-size: var(--font-caption); line-height: 1.45; }

  /* ── Заголовки секций ── */
  .section-heading { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); }
  .section-heading .section-label { grid-column: 1 / span 3; grid-row: 1; }
  .section-heading .rule-mark { grid-column: 1 / span 3; grid-row: 2; align-self: start; }
  .section-heading h2 { grid-column: 5 / -1; grid-row: 1 / span 2; max-width: 760px; margin: 0; font-size: var(--font-section); line-height: .98; letter-spacing: -.045em; }
  .section-heading p { grid-column: 5 / -1; grid-row: 3; max-width: 620px; margin: 24px 0 0; color: var(--text-soft); font-size: var(--font-body); line-height: 1.55; text-wrap: pretty; }

  /* ── Сценарии ── */
  .scenarios { display: grid; }
  .scenario-tabs { display: flex; width: 404px; height: 42px; margin: 36px 0 36px calc((100% + var(--col-gap)) / 12 * 4); border: 1px solid rgb(23 21 15 / .18); }
  .scenario-tabs button { flex: 1; border: 0; background: transparent; color: var(--text-soft); font: 600 14px var(--font-text); cursor: pointer; }
  .scenario-tabs button[aria-selected='true'] { background: var(--color-gold); color: var(--color-ink); }
  .scenario-panels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--col-gap); }
  .scenario-panel { opacity: .6; transition: opacity .2s ease; }
  .scenario-panel.is-active { opacity: 1; }
  .scenario-copy { padding-top: 18px; }
  .scenario-copy h3 { margin: 0; font-size: var(--font-card-title); }
  .scenario-copy p { max-width: 46ch; min-height: 4.5em; margin: 12px 0 0; color: var(--text-soft); font-size: var(--font-secondary); line-height: 1.5; }
  .scenario-copy span { display: block; margin-top: 12px; color: var(--color-ochre); font-size: var(--font-caption); }

  /* ── Арт-дирекшн ── */
  .art-direction { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); row-gap: 40px; }
  .art-direction .section-heading { grid-column: 1 / span 5; display: block; }
  .art-direction .section-heading h2 { max-width: 100%; margin-top: 18px; font-size: clamp(30px, 2.4vw, 36px); }
  .art-direction .section-heading p { max-width: 100%; margin-top: 22px; }
  .art-sample { grid-column: 7 / -1; grid-row: 1 / span 2; display: flex; flex-direction: column; aspect-ratio: 5 / 4; box-sizing: border-box; background: var(--color-ink); padding: clamp(28px, 3vw, 42px); color: var(--color-paper); }
  .art-sample > span { font: 700 clamp(32px, 3.2vw, 48px)/1 var(--font-display); letter-spacing: -.05em; }
  .art-sample p { max-width: 30ch; margin: 26px 0 auto; color: rgb(244 242 236 / .66); font-size: var(--font-secondary); line-height: 1.5; }
  .art-sample button { display: inline-flex; align-items: center; justify-content: space-between; width: 220px; height: 52px; box-sizing: border-box; border: 0; margin-top: auto; padding: 0 18px 0 22px; background: var(--color-gold); color: var(--color-ink); font: 600 14px/1 var(--font-text); cursor: pointer; }
  .art-sample button span { font: 400 22px/1 var(--font-text); }
  .art-sample small { display: block; margin-top: 16px; color: rgb(244 242 236 / .58); font-size: var(--font-caption); line-height: 1.35; }
  .art-notes { grid-column: 1 / span 5; grid-row: 2; align-self: start; border-top: 1px solid rgb(23 21 15 / .22); }
  .art-notes article { padding: 16px 0; }
  .art-notes article + article { border-top: 1px solid rgb(23 21 15 / .12); }
  .art-notes article > span { display: block; color: rgb(23 21 15 / .55); font-size: var(--font-label); }
  .art-notes strong { display: block; margin-top: 8px; font-size: var(--font-secondary); font-weight: 500; }
  .swatches { display: flex; gap: 12px; margin-top: 14px; }
  .swatches i { flex: 1; }
  .swatches i::before { content: ''; display: block; height: 44px; background: var(--swatch); border: 1px solid var(--line-ink); }
  .swatches b { display: block; margin-top: 8px; color: rgb(23 21 15 / .5); font: 400 11px var(--font-mono); }

  /* ── Подача объекта ── */
  /* Факты объекта нарисованы в типографике кейса, а не вставлены скриншотами:
     кадры чужого интерфейса во всю ширину читались как сам сайт, а не как рассказ о работе.
     Скриншоты остались там, где показывают именно работу: обложка, сценарии и телефоны. */
  .interface { display: grid; gap: 72px; }
  .spec-kicker { display: block; color: rgb(23 21 15 / .5); font-size: var(--font-label); letter-spacing: .06em; text-transform: uppercase; }

  .spec-row { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); align-items: start; }
  .spec-price { grid-column: 1 / span 6; box-sizing: border-box; background: var(--color-ink); padding: clamp(28px, 3vw, 44px); color: var(--color-paper); }
  .spec-price .spec-kicker { color: rgb(244 242 236 / .5); }
  .spec-price strong { display: block; margin-top: 22px; font: 700 clamp(44px, 5vw, 76px)/.92 var(--font-display); letter-spacing: -.05em; }
  .spec-price em { display: block; margin-top: 14px; color: var(--color-gold); font-size: var(--font-secondary); font-style: normal; }
  .spec-price p { max-width: 34ch; margin: 28px 0 0; color: rgb(244 242 236 / .66); font-size: var(--font-secondary); line-height: 1.5; }

  .spec-distance { grid-column: 8 / -1; }
  .spec-distance dl { margin: 18px 0 0; border-top: 1px solid rgb(23 21 15 / .28); }
