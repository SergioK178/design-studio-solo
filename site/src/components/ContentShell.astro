---
interface Props {
  tone?: 'dark' | 'paper';
}

const { tone = 'paper' } = Astro.props;
---

<article class:list={['content-shell', tone]} data-bg={tone === 'dark' ? 'ink' : 'paper'}>
  <div class="wrap prose">
    <slot />
  </div>
</article>

<style>
  .content-shell {
    padding: 70px 0 100px;
  }

  .paper {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .dark {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  /* Reading measure (§8.2): ~760px текста; .wrap — border-box, поэтому добавляем гаттеры. */
  .prose {
    max-width: calc(var(--measure-reading) + 2 * var(--page-gutter));
  }

  .prose :global(h2) {
    margin: 44px 0 16px;
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.16;
    letter-spacing: -0.01em;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(li) {
    color: currentColor;
    font-size: 17px;
    line-height: 1.7;
    opacity: 0.78;
  }

  .prose :global(ul) {
    margin: 18px 0 0;
    padding-left: 22px;
  }

  /* Inline-ссылка в чтении (DESIGN-SYSTEM-V1 §18.6): canonical blue + постоянное подчёркивание. */
  .prose :global(a) {
    color: var(--color-blue);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: var(--border-width);
    text-underline-offset: 3px;
    transition: text-decoration-thickness var(--dur-feedback) var(--ease-site);
  }

  .prose :global(a:hover) {
    text-decoration-thickness: var(--border-width-major);
  }
</style>
