---
import type { CaseTeaser } from '../data/cases';

interface Props {
  item: CaseTeaser;
}

const { item } = Astro.props;
---

<a class:list={['case', `bg-${item.bg}`]} href={item.href} data-cursor="Разбор →">
  <span class="meta mono">{item.tag} · {item.term}</span>
  <h3>{item.headline}</h3>
  <p>{item.body}</p>
  <div class="bottom">
    <strong>{item.digit}</strong>
    <span>Разбор →</span>
  </div>
</a>

<style>
  .case {
    display: flex;
    min-height: 420px;
    flex-direction: column;
    box-sizing: border-box;
    padding: 34px;
    text-decoration: none;
    transition:
      background 0.18s,
      box-shadow 0.18s,
      transform 0.18s;
  }

  .bg-blue {
    background: var(--color-blue);
    color: var(--color-paper);
  }

  .bg-blue:hover {
    background: var(--color-blue-dk);
  }

  .bg-ochre {
    background: var(--color-ochre);
    color: var(--color-paper);
  }

  .bg-ochre:hover {
    background: var(--color-ochre-dk);
  }

  .bg-ink {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .bg-ink:hover {
    background: var(--color-ink-soft);
  }

  .bg-paper {
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1.5px solid rgb(23 21 15 / 0.25);
  }

  .bg-paper:hover {
    box-shadow: 10px 10px 0 var(--color-gold);
    transform: translate(-3px, -3px);
  }

  .meta {
    color: currentColor;
    opacity: 0.66;
  }

  h3 {
    margin: 22px 0 0;
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 42px);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.015em;
  }

  p {
    max-width: 58ch;
    margin: 22px 0 0;
    color: currentColor;
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.78;
  }

  .bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-top: auto;
    padding-top: 34px;
  }

  strong {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 58px);
    line-height: 1;
  }

  .bottom span {
    color: var(--color-gold);
    font-weight: 700;
    white-space: nowrap;
  }

  .bg-paper .bottom span {
    color: var(--color-blue);
  }

  @media (max-width: 620px) {
    .case {
      min-height: auto;
      padding: 24px;
    }

    .bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
