---
import { steps } from '../data/home';
---

<section id="process" class="process" data-bg="paper" aria-labelledby="process-title">
  <div class="wrap grid">
    <header class="sticky" data-reveal-group>
      <span class="section-label">Процесс</span>
      <h2 id="process-title">Весь проект — в одном чате</h2>
      <p>После фиксации сметы весь проект ведём в&nbsp;одном Telegram-чате. Там остаются договорённости, макеты, рабочие ссылки и&nbsp;сроки.</p>
      <p class="soft">Можно отвечать в удобное время. Если проще голосом — созвонимся на старте.</p>
    </header>

    <ol class="chat" aria-label="Этапы работы" data-reveal-group>
      {steps.map((step, index) => (
        <>
          <li class:list={['message', `message-${index + 1}`]}>
            <div class="stage-divider">
              <span class="number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="time">{step.time}</span>
            </div>
            <div class="incoming">
              <span class="avatar" aria-hidden="true">3D</span>
              <div class="bubble">
                <span class="sender">3D Studio</span>
                <h3>{step.name}</h3>
                <p>{step.desc}</p>
                <svg class="bubble-tail" width="14" height="15" viewBox="0 0 14 15" aria-hidden="true">
                  <path d="M14 0 L14 15 L0 15 Z" fill="white" />
                  <path d="M14 0 L0 15 L14 15" fill="none" stroke="rgba(23,21,15,0.16)" stroke-width="1" stroke-linejoin="round" />
                </svg>
              </div>
            </div>
          </li>

          {index === 2 && (
            <li class="reply">
              <span class="reply-author">Вы · в любое время</span>
              <blockquote>
                <p>«Посмотрел превью с телефона. Правки соберу списком и пришлю вечером».</p>
                <span class="delivered" aria-label="Доставлено">✓✓</span>
              </blockquote>
            </li>
          )}
        </>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);
    gap: clamp(56px, 8vw, 112px);
    align-items: start;
    padding-top: 96px;
    padding-bottom: 112px;
  }

  .sticky {
    position: sticky;
    top: 48px;
  }

  .section-label {
    color: var(--color-blue);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  h2 {
    max-width: 350px;
    margin: 16px 0 0;
    font-family: var(--font-display);
    font-size: clamp(30px, 3.6vw, 40px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .sticky p {
    max-width: 34ch;
    margin: 28px 0 0;
    color: rgb(23 21 15 / 0.72);
    font-size: 18px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .sticky .soft {
    margin-top: 16px;
    color: rgb(23 21 15 / 0.52);
    font-size: 14px;
  }

  .chat {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .message {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
  }

  .stage-divider {
    display: flex;
    align-items: baseline;
    gap: 10px;
    width: 100%;
    color: rgb(23 21 15 / 0.48);
  }

  .stage-divider::before,
  .stage-divider::after {
    content: '';
    height: 1px;
    flex: 1;
    background: rgb(23 21 15 / 0.16);
  }

  .stage-divider::before {
    max-width: 18px;
  }

  .number {
    color: var(--color-blue);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .time {
    display: block;
    color: rgb(23 21 15 / 0.5);
    font-size: 12px;
    font-weight: 500;
  }

  .incoming {
    display: flex;
    gap: 10px;
    align-items: flex-end;
    width: 100%;
  }

  .avatar {
    display: grid;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    place-items: center;
    background: var(--color-blue-legacy);
    color: white;
    font-size: 10px;
    font-weight: 700;
    border-radius: 50%;
  }

  .bubble {
    position: relative;
    width: min(calc(100% - 44px), 560px);
    box-sizing: border-box;
    background: white;
    border: 1px solid rgb(23 21 15 / 0.16);
    padding: 15px 18px 17px;
    border-radius: 0 14px 14px 14px;
  }

  .bubble-tail {
    position: absolute;
    left: -9px;
    bottom: -1px;
    display: block;
  }

  .message-1 .bubble {
    width: min(calc(100% - 44px), 500px);
  }

  .message-2 .bubble {
    width: min(calc(100% - 44px), 570px);
  }

  .message-3 .bubble {
    width: min(calc(100% - 44px), 530px);
  }

  .message-4 .bubble {
    width: min(calc(100% - 44px), 580px);
  }

  .sender {
    display: block;
    margin-bottom: 5px;
    color: var(--color-blue);
    font-size: 12px;
    font-weight: 600;
  }

  h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.35;
  }

  .bubble p {
    max-width: 56ch;
    margin: 6px 0 0;
    color: rgb(23 21 15 / 0.6);
    font-size: 14px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .reply {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 7px;
    padding: 4px 0 2px 72px;
  }

  .reply-author {
    padding-right: 3px;
    color: rgb(23 21 15 / 0.48);
    font-size: 12px;
    font-weight: 500;
  }

  blockquote {
    position: relative;
    max-width: 430px;
    margin: 0;
    box-sizing: border-box;
    background: var(--color-ink);
    padding: 16px 45px 17px 19px;
    color: var(--color-paper);
    border-radius: 14px 4px 14px 14px;
  }

  blockquote::after {
    content: '';
    position: absolute;
    right: -7px;
    bottom: 0;
    width: 12px;
    height: 13px;
    background: var(--color-ink);
    clip-path: polygon(0 0, 100% 100%, 0 100%);
  }

  blockquote p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .delivered {
    position: absolute;
    right: 15px;
    bottom: 9px;
    color: #8394ff;
    font-size: 10px;
    letter-spacing: -0.18em;
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 42px;
      padding-top: 64px;
      padding-bottom: 72px;
    }

    .sticky {
      position: static;
    }

    .sticky p {
      max-width: 52ch;
      font-size: 17px;
    }
  }

  @media (max-width: 640px) {
    .grid {
      gap: 34px;
    }

    .chat {
      gap: 18px;
    }

    .reply {
      padding-left: 28px;
    }

    blockquote {
      padding: 18px 20px;
    }

    .bubble {
      padding: 14px 16px 16px;
    }
  }

</style>
