---
import { site } from '../data/site';
---

<footer class="footer">
  <div class="wrap inner">
    <a class="brand" href="/">{site.name}<b>.</b></a>
    <nav aria-label="Нижняя навигация">
      <a href="/products/">Все продукты</a>
      <a href="/price/">Расширения</a>
      <a href="/cases/">Работы</a>
      <a href="/legal/">Legal</a>
      <a href={site.telegramUrl}>Telegram ↗</a>
    </nav>
  </div>
  <div class="wrap wordmark-row" aria-hidden="true" data-reveal>
    <span class="wordmark">{site.name}.</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    color: var(--text-on-ink-secondary);
    overflow: hidden;
  }

  .wordmark-row {
    padding-top: var(--space-12);
    /* Нижний отступ нужен reveal: без него вордмарк прижат к краю страницы
       и на мобильных не попадает в зону IntersectionObserver (остаётся opacity:0). */
    padding-bottom: var(--space-6);
  }

  /* Финальная сцена (Exo Ape/Snellenberg): вордмарк во всю ширину,
     заливается золотом слева направо при наведении. Размер fluid,
     чтобы вписываться в рельсу .wrap до 320px; footer клипует остаток. */
  .wordmark {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(44px, 13.5vw, 148px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.02em;
    white-space: nowrap;
    background-image: linear-gradient(90deg, var(--color-gold) 0 50%, var(--color-paper) 50% 100%);
    background-size: 205% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: background-position 0.9s var(--ease-site);
  }

  .wordmark:hover {
    background-position: 0 0;
  }

  .inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    column-gap: var(--space-6);
    padding-top: var(--space-8);
    padding-bottom: var(--space-4);
    font-size: var(--type-body-sm-size);
    line-height: var(--type-body-sm-lh);
  }

  /* Touch-цель ≥44px (§30.2): высота набирается min-height, а не padding-ом,
     поэтому плотность ряда почти не меняется. */
  .brand,
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .brand {
    color: var(--text-on-ink-primary);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
  }

  .brand b {
    color: var(--color-gold);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-6);
  }

  nav a {
    text-decoration: none;
    transition: color 0.2s var(--ease-site);
  }

  nav a:hover {
    color: var(--color-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark,
    nav a {
      transition: none;
    }
  }
</style>
