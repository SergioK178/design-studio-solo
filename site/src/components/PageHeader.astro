---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  tone?: 'dark' | 'paper' | 'gold';
}

const { eyebrow, title, lead, tone = 'dark' } = Astro.props;
const bg = tone === 'dark' ? 'ink' : tone;
---

<section class:list={['page-header', tone]} data-bg={bg}>
  <div class="wrap" data-reveal-group>
    {eyebrow && <p class="mono">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>

<style>
  .page-header {
    padding: 120px 0 70px;
  }

  .dark {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .paper {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .gold {
    background: var(--color-gold);
    color: var(--color-ink);
  }

  .mono {
    margin: 0 0 18px;
    color: var(--color-gold);
  }

  .gold .mono,
  .paper .mono {
    color: var(--color-blue);
  }

  h1 {
    max-width: 920px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(42px, 6vw, 72px);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.015em;
  }

  .lead {
    max-width: 720px;
    margin: 24px 0 0;
    color: currentColor;
    font-size: 18px;
    line-height: 1.55;
    opacity: 0.72;
  }
</style>
