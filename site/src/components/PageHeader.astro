---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  tone?: 'dark' | 'paper' | 'gold';
}

const { eyebrow, title, lead, tone = 'dark' } = Astro.props;
const bg = tone === 'dark' ? 'ink' : tone;
---

<section class:list={['page-header', tone]} data-bg={bg}>
  <div class="wrap" data-reveal-group>
    {eyebrow && <p class="mono">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>

<style>
  /* Opening scene (§7.2): desktop 120/80, mobile 80/56. Nav лежит поверх верхней полосы. */
  .page-header {
    padding: 120px 0 80px;
  }

  .dark {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .paper {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .gold {
    background: var(--color-gold);
    color: var(--color-ink);
  }

  .mono {
    margin: 0 0 18px;
    color: var(--color-gold);
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 650;
    letter-spacing: 0;
    text-transform: none;
  }

  .gold .mono,
  .paper .mono {
    color: var(--color-blue-legacy);
  }

  /* H1 / Page title (§6.2). Длинные слова Unbounded переносятся, а не расширяют вьюпорт (§11.3). */
  h1 {
    min-width: 0;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-h1-size);
    font-weight: var(--type-h1-weight);
    line-height: var(--type-h1-lh);
    letter-spacing: var(--type-h1-tracking);
    overflow-wrap: break-word;
  }

  .lead {
    max-width: var(--measure-lead);
    margin: 24px 0 0;
    color: var(--text-on-ink-secondary);
    font-size: var(--type-lead-size);
    font-weight: var(--type-lead-weight);
    line-height: var(--type-lead-lh);
    overflow-wrap: break-word;
  }

  .paper .lead,
  .gold .lead {
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .page-header {
      padding: 80px 0 56px;
    }

    /* Авто-перенос слогов только на узких экранах: длинные слова Unbounded в 280px. */
    h1 {
      hyphens: auto;
    }
  }
</style>
