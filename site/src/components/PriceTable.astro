---
import type { ExtensionPrice } from '../data/products';

interface Props {
  items: ExtensionPrice[];
}

const { items } = Astro.props;
---

<div class="price-table" data-reveal>
  <div class="row head" aria-hidden="true">
    <span>Расширение</span>
    <span>Цена</span>
    <span>Срок</span>
    <span>Что внутри</span>
  </div>
  {items.map((item) => (
    <article class="row">
      <h2>{item.name}</h2>
      <div class="field price">
        <span class="field-label mono">Цена</span>
        <strong>{item.price}</strong>
      </div>
      <div class="field term">
        <span class="field-label mono">Срок</span>
        <span class="term-value">{item.term}</span>
      </div>
      <p>{item.description}</p>
    </article>
  ))}
</div>

<style>
  .price-table {
    border-top: 2px solid rgb(23 21 15 / 0.22);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(220px, 1.1fr) 180px 170px minmax(260px, 1fr);
    gap: 24px;
    align-items: baseline;
    border-bottom: 1.5px solid rgb(23 21 15 / 0.14);
    padding: 24px 0;
  }

  .head {
    color: var(--color-blue-legacy);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.18;
  }

  .field {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .field-label {
    display: none;
  }

  strong {
    color: var(--color-blue-legacy);
    font-size: 18px;
  }

  .term-value {
    color: rgb(23 21 15 / 0.62);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
  }

  p {
    color: rgb(23 21 15 / 0.7);
    font-size: 15px;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .row {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 26px 0;
    }

    .head {
      display: none;
    }

    .field-label {
      display: inline;
      color: var(--color-blue-legacy);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
  }
</style>
