---
/**
 * Нативная пересборка трёх инфографик секции «Как мы считаем и работаем».
 * Тёмная тема на токенах сайта, золотые акценты. Иконки-плейсхолдеры (`.ig-ico`)
 * — реальные иконки положим позже. Три блока: смета, владение, прайс расширений.
 */

const estimate = [
  { n: '01', title: 'Анализ и проектирование', note: 'Структура, сценарии, ТЗ', sum: '28 000' },
  { n: '02', title: 'Дизайн интерфейса', note: 'Макеты ключевых экранов', sum: '36 000' },
  { n: '03', title: 'Вёрстка и разработка', note: 'Адаптив, интеграции', sum: '42 000' },
  { n: '04', title: 'Наполнение и контент', note: 'Тексты, медиа, карточки', sum: '14 000' },
  { n: '05', title: 'Тестирование и запуск', note: 'QA, деплой, HTTPS', sum: '10 000' },
];

const ownership = [
  { title: 'Код проекта', status: 'Передан', icon: 'code' },
  { title: 'Дизайн и файлы', status: 'У вас', icon: 'file-lines' },
  { title: 'Домен', status: 'У вас', icon: 'globe' },
  { title: 'Данные и контент', status: 'У вас', icon: 'database' },
  { title: 'Сервер', status: 'Полный доступ', icon: 'server' },
  { title: 'Доступы и аккаунты', status: 'Переданы', icon: 'key' },
];

const principles = [
  { title: 'Никакой зависимости', note: 'Развивайте с нами или без нас', icon: 'key-access' },
  { title: 'Полные права', note: 'Исходники и лицензии — ваши', icon: 'shield-check' },
  { title: 'Прозрачность', note: 'Всё задокументировано', icon: 'document' },
  { title: 'Свобода развития', note: 'Меняйте команду когда угодно', icon: 'growth' },
];

const modules = [
  { title: 'Слайдер на главной', note: 'Динамический баннер с управлением', price: '8 000', icon: 'slider' },
  { title: 'Фильтр товаров', note: 'Удобный поиск и фильтрация', price: '12 000', icon: 'funnel' },
  { title: 'Онлайн-чат', note: 'Интеграция с мессенджерами', price: '9 000', icon: 'chat' },
  { title: 'Доп. страницы', note: 'О компании, доставка, возврат и др.', price: '5 000', icon: 'document' },
  { title: 'Избранное', note: 'Список избранных товаров', price: '6 000', icon: 'star' },
  { title: 'Расширенная аналитика', note: 'Доп. отчёты и события', price: '10 000', icon: 'chart' },
];

const ico = (name: string) => `/assets/ui/icons/${name}.webp`;
---

<div class="approach-infographics" data-reveal-group>
  <!-- 1. Смета -->
  <article class="ig ig-estimate" data-reveal>
    <div class="ig-aside">
      <span class="ig-eyebrow">только по делу</span>
      <h3>Ничего лишнего в смете.</h3>
      <ul class="ig-checks">
        <li><span class="ig-check" aria-hidden="true"></span>Каждая строка — с обоснованием</li>
        <li><span class="ig-check" aria-hidden="true"></span>Только нужный объём, без раздувания ТЗ</li>
        <li><span class="ig-check" aria-hidden="true"></span>Прозрачно и понятно на каждом этапе</li>
      </ul>
    </div>
    <div class="ig-panel">
      <div class="ig-doc-head">
        <span>Проект: Веб-сайт</span>
        <span>Версия 1.2</span>
      </div>
      <table class="ig-table">
        <thead>
          <tr><th>№</th><th>Наименование работ</th><th class="num">Сумма</th></tr>
        </thead>
        <tbody>
          {estimate.map((row) => (
            <tr>
              <td class="ig-num-cell">{row.n}</td>
              <td>
                <span class="ig-row-title">{row.title}</span>
                <span class="ig-row-note">{row.note}</span>
              </td>
              <td class="num">{row.sum} ₽</td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr><td></td><td>Итого</td><td class="num ig-total">130 000 ₽</td></tr>
        </tfoot>
      </table>
    </div>
  </article>

  <!-- 2. Владение -->
  <article class="ig ig-ownership" data-reveal>
    <div class="ig-aside">
      <span class="ig-eyebrow">полный контроль</span>
      <h3>Всё — ваше.</h3>
      <p class="ig-sub">Код, доступы, дизайн и данные остаются у вас. Развивайте проект с любой командой — без привязки к студии.</p>
      <div class="ig-shield">
        <img class="ig-ico ig-ico-lg" src={ico('shield-user')} alt="" aria-hidden="true" />
        <span class="ig-shield-pill">У вас</span>
      </div>
    </div>
    <div class="ig-panel">
      <div class="ig-own-grid">
        {ownership.map((item) => (
          <div class="ig-own-card">
            <img class="ig-ico" src={ico(item.icon)} alt="" aria-hidden="true" />
            <div class="ig-own-text">
              <span class="ig-own-title">{item.title}</span>
              <span class="ig-own-status">{item.status}</span>
            </div>
            <span class="ig-tick" aria-hidden="true"></span>
          </div>
        ))}
      </div>
      <ul class="ig-principles">
        {principles.map((p) => (
          <li>
            <img class="ig-ico ig-ico-sm" src={ico(p.icon)} alt="" aria-hidden="true" />
            <span class="ig-pr-title">{p.title}</span>
            <span class="ig-pr-note">{p.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </article>

  <!-- 3. Прайс расширений -->
  <article class="ig ig-price" data-reveal>
    <div class="ig-aside">
      <span class="ig-eyebrow">расширения</span>
      <h3>По прайсу.</h3>
      <p class="ig-sub">Фиксированные цены. Никаких сюрпризов. Выбирайте только то, что нужно сейчас.</p>
      <div class="ig-badge">
        <img class="ig-ico" src={ico('shield-check-alt')} alt="" aria-hidden="true" />
        <div class="ig-own-text">
          <span class="ig-own-title">Все расширения из прайса</span>
          <span class="ig-own-status">Прозрачно и доступно</span>
        </div>
      </div>
    </div>
    <div class="ig-panel">
      <div class="ig-mod-head">
        <span>Дополнительные модули</span>
        <span>от</span>
      </div>
      <ul class="ig-modules">
        {modules.map((m) => (
          <li>
            <img class="ig-ico" src={ico(m.icon)} alt="" aria-hidden="true" />
            <div class="ig-own-text">
              <span class="ig-own-title">{m.title}</span>
              <span class="ig-own-status">{m.note}</span>
            </div>
            <span class="ig-price-val">{m.price} ₽</span>
            <span class="ig-plus" aria-hidden="true">+</span>
          </li>
        ))}
      </ul>
      <div class="ig-mod-total">
        <img class="ig-ico" src={ico('calculator')} alt="" aria-hidden="true" />
        <div class="ig-own-text">
          <span class="ig-own-title">Итого</span>
          <span class="ig-own-status">0 модулей выбрано</span>
        </div>
        <span class="ig-price-val ig-total">0 ₽</span>
      </div>
    </div>
  </article>
</div>

<style>
  .approach-infographics {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .ig {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: 0;
    box-sizing: border-box;
    border: 1.5px solid rgb(244 242 236 / 0.14);
    background: var(--color-ink-soft);
  }

  .ig-aside {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 32px;
    border-right: 1.5px solid rgb(244 242 236 / 0.12);
  }

  .ig-panel {
    padding: 28px 32px;
    min-width: 0;
  }

  .ig-eyebrow {
    color: var(--color-gold);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ig h3 {
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .ig-sub {
    color: rgb(244 242 236 / 0.6);
    font-size: 14px;
    line-height: 1.55;
  }

  .ig-ico {
    flex: none;
    display: block;
    width: 40px;
    height: 40px;
    object-fit: contain;
  }
  .ig-ico-sm { width: 30px; height: 30px; }
  .ig-ico-lg { width: 68px; height: 68px; }

  /* --- 1. Смета --- */
  .ig-checks {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ig-checks li {
    display: grid;
    grid-template-columns: 20px 1fr;
    align-items: start;
    gap: 12px;
    color: rgb(244 242 236 / 0.82);
    font-size: 15px;
    line-height: 1.4;
  }
  .ig-check {
    width: 20px;
    height: 20px;
    background: rgb(229 164 59 / 0.14);
    border: 1px solid var(--color-gold);
    position: relative;
  }
  .ig-check::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 2px;
    width: 5px;
    height: 10px;
    border: solid var(--color-gold);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .ig-doc-head {
    display: flex;
    justify-content: space-between;
    color: rgb(244 242 236 / 0.45);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-bottom: 14px;
    border-bottom: 1.5px solid rgb(244 242 236 / 0.12);
  }

  .ig-table {
    width: 100%;
    border-collapse: collapse;
  }
  .ig-table th {
    color: rgb(244 242 236 / 0.4);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: left;
    padding: 14px 0 10px;
  }
  .ig-table td {
    padding: 12px 0;
    border-top: 1px solid rgb(244 242 236 / 0.08);
    vertical-align: baseline;
  }
  .ig-table .num { text-align: right; white-space: nowrap; }
  .ig-num-cell {
    color: var(--color-gold);
    font-family: var(--font-mono);
    font-size: 12px;
    padding-right: 16px;
  }
  .ig-row-title { display: block; color: var(--color-paper); font-size: 15px; }
  .ig-row-note { display: block; color: rgb(244 242 236 / 0.5); font-size: 13px; margin-top: 2px; }
  .ig-table td.num { color: rgb(244 242 236 / 0.85); font-family: var(--font-mono); font-size: 14px; }
  .ig-table tfoot td {
    border-top: 1.5px solid rgb(244 242 236 / 0.2);
    padding-top: 16px;
    font-size: 15px;
    color: var(--color-paper);
  }
  .ig-total { color: var(--color-gold) !important; font-weight: 700; font-size: 17px !important; }

  /* --- 2. Владение --- */
  .ig-shield {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: auto;
  }
  .ig-shield-pill {
    color: var(--color-ink);
    background: var(--color-gold);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 12px;
  }

  .ig-own-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .ig-own-card {
    display: flex;
    align-items: center;
    gap: 14px;
    border: 1px solid rgb(244 242 236 / 0.12);
    background: rgb(23 21 15 / 0.35);
    padding: 14px;
  }
  .ig-own-text { display: grid; gap: 2px; min-width: 0; }
  .ig-own-title { color: var(--color-paper); font-size: 14px; font-weight: 600; }
  .ig-own-status { color: rgb(229 164 59 / 0.85); font-size: 12px; font-family: var(--font-mono); }
  .ig-tick {
    flex: none;
    margin-left: auto;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgb(74 165 90 / 0.16);
    border: 1px solid rgb(96 190 112 / 0.7);
    position: relative;
  }
  .ig-tick::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 4px;
    width: 5px;
    height: 9px;
    border: solid #63c47b;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .ig-principles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 20px 0 0;
    padding: 20px 0 0;
    border-top: 1.5px solid rgb(244 242 236 / 0.12);
    list-style: none;
  }
  .ig-principles li { display: grid; gap: 8px; }
  .ig-pr-title { color: var(--color-paper); font-size: 14px; font-weight: 600; }
  .ig-pr-note { color: rgb(244 242 236 / 0.55); font-size: 12px; line-height: 1.4; }

  /* --- 3. Прайс --- */
  .ig-badge {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: auto;
    border: 1px solid rgb(244 242 236 / 0.12);
    background: rgb(23 21 15 / 0.35);
    padding: 14px;
  }

  .ig-mod-head {
    display: flex;
    justify-content: space-between;
    color: rgb(244 242 236 / 0.4);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-bottom: 12px;
    border-bottom: 1.5px solid rgb(244 242 236 / 0.12);
  }
  .ig-modules { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .ig-modules li,
  .ig-mod-total {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
  }
  .ig-modules li { border-bottom: 1px solid rgb(244 242 236 / 0.08); }
  .ig-price-val {
    margin-left: auto;
    color: rgb(244 242 236 / 0.9);
    font-family: var(--font-mono);
    font-size: 14px;
    white-space: nowrap;
  }
  .ig-plus {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid rgb(229 164 59 / 0.5);
    color: var(--color-gold);
    font-size: 18px;
    line-height: 1;
  }
  .ig-mod-total {
    margin-top: 8px;
    border: 1px solid rgb(229 164 59 / 0.25);
    background: rgb(229 164 59 / 0.06);
    padding: 16px 14px;
  }

  @media (max-width: 900px) {
    .ig { grid-template-columns: 1fr; }
    .ig-aside { border-right: none; border-bottom: 1.5px solid rgb(244 242 236 / 0.12); }
    .ig-shield, .ig-badge { margin-top: 4px; }
    .ig-principles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .ig-aside, .ig-panel { padding: 20px; }
    .ig-own-grid { grid-template-columns: 1fr; }
    .ig-principles { grid-template-columns: 1fr; }
    .ig-row-note { display: none; }

    /* модули: иконка + текст в ряд, цена и «+» уходят на свою строку */
    .ig-modules li,
    .ig-mod-total {
      flex-wrap: wrap;
      row-gap: 8px;
    }
    .ig-modules li > .ig-own-text,
    .ig-mod-total > .ig-own-text {
      flex: 1 1 140px;
    }
    .ig-price-val {
      order: 3;
      margin-left: 54px;
    }
    .ig-plus {
      order: 4;
      margin-left: auto;
    }
    .ig-own-title,
    .ig-own-status,
    .ig-pr-title,
    .ig-pr-note { overflow-wrap: anywhere; }

    /* смета: отодвигаем текст от номера 01/02/03 */
    .ig-num-cell {
      padding-right: 14px;
      vertical-align: top;
    }
    .ig-table tbody td:nth-child(2) { padding-left: 6px; }
  }
</style>
