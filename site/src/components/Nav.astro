---
import { site } from '../data/site';

const links = [
  { label: 'Продукты', href: '/products/' },
  { label: 'Работы', href: '/cases/' },
  { label: 'Расширения', href: '/price/' },
];

const currentPath = Astro.url.pathname;
// На самой странице брифа кнопка «Пройти бриф» ведёт в никуда.
const onBrief = currentPath.startsWith('/brief');
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="3D Studio на главную">{site.name}<span>.</span></a>

    <nav class="nav-links" aria-label="Главная навигация">
      {links.map((link) => (
        <a class="roll" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
          <span data-text={link.label}>{link.label}</span>
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <a class="tg roll" href={site.telegramUrl}>
        <span data-text="Telegram ↗">Telegram ↗</span>
      </a>
      {!onBrief && <a class="btn-gold nav-cta" href="/brief/" data-magnetic>Пройти бриф →</a>}
    </div>

    <button id="nav-toggle" class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-panel">
      <span>Меню</span>
    </button>
  </div>

  <div id="nav-panel" class="nav-panel" hidden>
    <div class="nav-panel-backdrop" data-nav-close></div>
    <div class="nav-panel-sheet" role="dialog" aria-modal="true" aria-label="Мобильное меню">
      <div class="nav-panel-head">
        <span class="brand">{site.name}.</span>
        <button type="button" class="nav-panel-close" data-nav-close aria-label="Закрыть меню">✕</button>
      </div>
      <nav aria-label="Мобильная навигация">
        {links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
        ))}
        <a href={site.telegramUrl}>Telegram ↗</a>
      </nav>
      {!onBrief && <a class="btn-gold nav-panel-cta" href="/brief/">Пройти бриф →</a>}
    </div>
  </div>
</header>

<style>
  .nav {
    position: absolute;
    z-index: 40;
    inset: 0 0 auto;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding-top: 26px;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 800;
    text-decoration: none;
    color: currentColor;
  }

  .brand span,
  .tg {
    color: var(--color-gold);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    min-width: 0;
    margin-right: auto;
    margin-left: var(--space-10);
    font-size: var(--type-body-sm-size);
    font-weight: 500;
    color: var(--text-on-ink-secondary);
  }

  .nav-links a {
    text-decoration: none;
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--color-paper);
  }

  .nav-links a[aria-current='page'] {
    position: relative;
  }

  .nav-links a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: var(--border-width-major);
    background: var(--color-gold);
  }

  /* Действия не сжимаются: пространство отдаёт зазор между links и actions (margin-right: auto). */
  .nav-actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-6);
  }

  .tg {
    font-size: var(--type-body-sm-size);
    font-weight: 600;
    text-decoration: none;
  }

  /* .nav-cta — стандартный .btn-gold (52px); локальных override нет. */

  /* Контекст gold-шапки (карточки продуктов): ink-элементы на gold, иначе Telegram, CTA и
     wordmark сливаются с фоном. Контекст задаёт PageHeader tone="gold". */
  :global(body:has(.page-header.gold)) .nav {
    color: var(--color-ink);
  }

  :global(body:has(.page-header.gold)) .brand span,
  :global(body:has(.page-header.gold)) .tg {
    color: var(--color-ink);
  }

  :global(body:has(.page-header.gold)) .nav-links {
    color: var(--text-secondary);
  }

  :global(body:has(.page-header.gold)) .nav-links a:hover,
  :global(body:has(.page-header.gold)) .nav-links a[aria-current='page'] {
    color: var(--color-ink);
  }

  :global(body:has(.page-header.gold)) .nav-links a[aria-current='page']::after {
    background: var(--color-ink);
  }

  :global(body:has(.page-header.gold)) .nav-cta {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  :global(body:has(.page-header.gold)) .nav-cta:hover {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  :global(body:has(.page-header.gold)) .menu-toggle {
    border-color: var(--border-strong);
    color: var(--color-ink);
  }

  .menu-toggle {
    display: none;
    box-sizing: border-box;
    min-height: 44px;
    border: var(--border-width) solid var(--border-on-ink-strong);
    background: transparent;
    padding: 0 var(--space-5);
    color: var(--color-paper);
    font-family: inherit;
    font-size: var(--type-body-sm-size);
    font-weight: 600;
    cursor: pointer;
  }

  .nav-panel {
    position: fixed;
    inset: 0;
    z-index: 50;
  }

  .nav-panel[hidden] {
    display: none;
  }

  .nav-panel-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(23 21 15 / 0.6);
  }

  .nav-panel-sheet {
    position: relative;
    display: flex;
    height: 100%;
    width: 100%;
    max-width: min(360px, 100%);
    margin-left: auto;
    flex-direction: column;
    gap: 28px;
    box-sizing: border-box;
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 22px var(--page-gutter) 32px;
    overflow-y: auto;
  }

  .nav-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-panel-close {
    display: grid;
    place-items: center;
    border: var(--border-width) solid var(--border-on-ink-strong);
    background: transparent;
    width: 44px;
    height: 44px;
    color: var(--color-paper);
    font-size: 15px;
    cursor: pointer;
  }

  .nav-panel nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .nav-panel nav a {
    padding: 14px 4px;
    border-bottom: var(--border-width) solid var(--border-on-ink-subtle);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: var(--type-row-title-size);
    font-weight: var(--type-row-title-weight);
    line-height: var(--type-row-title-lh);
    text-decoration: none;
  }

  .nav-panel nav a[aria-current='page'] {
    color: var(--color-gold);
  }

  .nav-panel-cta {
    margin-top: auto;
    text-align: center;
  }

  /* Canonical 960: desktop-навигация → drawer (§10.1, §21.2). */
  @media (max-width: 960px) {
    .nav-links,
    .nav-actions {
      display: none;
    }

    .menu-toggle {
      display: block;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');

  if (toggle && panel) {
    let lastFocused: HTMLElement | null = null;

    const focusableEls = () => Array.from(panel.querySelectorAll<HTMLElement>('a, button'));

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closePanel();
        return;
      }
      if (event.key !== 'Tab') return;
      const items = focusableEls();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    function openPanel() {
      lastFocused = document.activeElement as HTMLElement | null;
      panel!.hidden = false;
      toggle!.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      focusableEls()[0]?.focus();
      document.addEventListener('keydown', onKeydown);
    }

    function closePanel() {
      panel!.hidden = true;
      toggle!.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      (lastFocused ?? toggle)?.focus();
    }

    toggle.addEventListener('click', () => {
      if (panel.hidden) openPanel();
      else closePanel();
    });

    // Выход из drawer-режима (>960) с открытой панелью: закрываем без возврата фокуса.
    matchMedia('(min-width: 961px)').addEventListener('change', (event) => {
      if (event.matches && !panel.hidden) {
        panel.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        document.removeEventListener('keydown', onKeydown);
      }
    });

    for (const closer of panel.querySelectorAll('[data-nav-close]')) {
      closer.addEventListener('click', closePanel);
    }

    for (const link of panel.querySelectorAll('nav a')) {
      link.addEventListener('click', closePanel);
    }
  }
</script>
