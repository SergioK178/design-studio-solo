---
interface Props {
  item: {
    name: string;
    price: string;
    term: string;
    desc: string;
    excl: string;
    slug?: string;
  };
}

const { item } = Astro.props;
---

<article class="price-row">
  <div class="top">
    <h3>{item.slug ? <a href={`/products/${item.slug}/`}>{item.name}</a> : item.name}</h3>
    <strong>{item.price}</strong>
  </div>
  <div class="details">
    <span class="mono">{item.term}</span>
    <p>{item.desc}</p>
    <p class="muted"><b>Не входит:</b> {item.excl}</p>
  </div>
</article>

<style>
  .price-row {
    padding: 30px 0 34px;
    border-top: 2px solid rgb(244 242 236 / 0.25);
  }

  .price-row:hover {
    border-top-color: var(--color-gold);
  }

  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 30px;
    flex-wrap: wrap;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(30px, 4.2vw, 52px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--color-gold);
  }

  strong {
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 700;
    white-space: nowrap;
  }

  .details {
    display: grid;
    grid-template-columns: 170px 1fr 1fr;
    gap: 30px;
    margin-top: 18px;
    font-size: 14px;
    line-height: 1.55;
  }

  .details span {
    color: rgb(244 242 236 / 0.5);
  }

  p {
    margin: 0;
    color: rgb(244 242 236 / 0.7);
  }

  .muted {
    color: rgb(244 242 236 / 0.45);
  }

  .muted b {
    color: rgb(244 242 236 / 0.7);
  }

  @media (max-width: 760px) {
    .details {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
