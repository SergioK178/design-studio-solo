---
import Glyph from './parts/Glyph.astro';

/**
 * Главы 11–12. Мобильный сценарий и связность слоёв.
 *
 * Телефон липкий, экраны в нём — настоящий DOM, а не картинки: мобильную
 * версию мы не уменьшали, а перестраивали, и показать это можно только
 * работающей перестройкой. Экран меняется по мере чтения шагов — третий и
 * последний заметный интерактив кейса.
 *
 * Ниже — слои продукта и инженерные цифры. Они закрывают главу 12 и не вводят
 * новых идей: то же самое, но с изнанки.
 */
interface Props {
  stack: string[];
  presentation: any;
}

const { stack, presentation } = Astro.props;
const { system } = presentation;
---

<section class="scene system" data-bg="paper" data-mobile-scene>
  <div class="wrap">
    <div class="chapter">
      <div class="chapter-copy">
        <p class="s-label"><b>07</b> {system.eyebrow}</p>
        <h2 class="s-title">
          {system.title.map((line: string, index: number) => (
            <>{index > 0 && <br />}{line}</>
          ))}
        </h2>
        {system.text.map((paragraph: string) => (
          <p class="s-text" set:html={paragraph} />
        ))}

        <ol class="steps">
          {system.mobileSteps.map((step: any, index: number) => (
            <li class:list={['step', index === 0 && 'is-active']} data-mobile-step={step.id}>
              <span class="step-medallion"><Glyph name={step.icon} /></span>
              <p class="step-kicker">{String(index + 1).padStart(2, '0')} · {step.label}</p>
              <b>{step.title}</b>
              <p class="evidence">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="chapter-visual">
        <div class="phone-hold">
          <div class="phone project-layer" aria-hidden="true">
            <div class="phone-screen is-active" data-mobile-screen="materials">
              <p class="ph-kicker">Материалы</p>
              <p class="ph-title">Линейка</p>
              <ul class="ph-list">
                {system.mobileSteps && presentation.materials.items.slice(0, 4).map((item: any) => (
                  <li>
                    <span class="ph-dot" style={`--tint: ${item.tint}`}></span>
                    <b>{item.name}</b>
                    <i>{item.term ?? item.group}</i>
                  </li>
                ))}
              </ul>
            </div>

            <div class="phone-screen" data-mobile-screen="config">
              <p class="ph-kicker">Исполнение</p>
              <p class="ph-title">{presentation.materials.items[0].name}</p>
              {presentation.configurator.steps.map((step: any) => (
                <div class="ph-step">
                  <span class="ph-step-label">{step.num} · {step.label}</span>
                  <div class="ph-chips">
                    {step.options.slice(0, 3).map((option: string) => (
                      <span class:list={['ph-chip', option === step.active && 'is-on']}>{option}</span>
                    ))}
                  </div>
                </div>
              ))}
              <span class="ph-btn">Добавить в подборку</span>
            </div>

            <div class="phone-screen" data-mobile-screen="request">
              <p class="ph-kicker">Подборка</p>
              <p class="ph-title">{presentation.request.items.length} позиции</p>
              <ul class="ph-list ph-list--rfq">
                {presentation.request.items.map((item: any) => (
                  <li><b>{item.name}</b><i>{item.spec}</i></li>
                ))}
              </ul>
              <div class="ph-channels">
                {presentation.request.channels.map((channel: any) => (
                  <span class="ph-chip">{channel.label}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="layers-block grid12">
      <div class="layers-copy">
        <p class="s-label"><b>08</b> Система</p>
        <h2 class="s-title">Все части продукта связаны между собой</h2>
        <p class="evidence layers-note">{system.techNote}</p>
      </div>

      <div class="layers-grid">
        {system.layers.map((layer: any) => (
          <div class="layer-card">
            <Glyph name={layer.icon} />
            <b>{layer.title}</b>
            <p class="evidence">{layer.text}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="stats-row grid12">
      <div class="stats">
        {system.stats.map((stat: any) => (
          <div class="stat">
            <strong>{stat.value}</strong>
            <b>{stat.label}</b>
            <span>{stat.note}</span>
          </div>
        ))}
      </div>
      <p class="stack">
        <span class="part-label">Stack</span>
        {stack.slice(0, 8).join(' / ')}
      </p>
    </div>
  </div>
</section>

<script>
  const scene = document.querySelector<HTMLElement>('[data-mobile-scene]');

  if (scene && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const steps = Array.from(scene.querySelectorAll<HTMLElement>('[data-mobile-step]'));
    const screens = Array.from(scene.querySelectorAll<HTMLElement>('[data-mobile-screen]'));

    const show = (id: string) => {
      for (const step of steps) step.classList.toggle('is-active', step.dataset.mobileStep === id);
      for (const screen of screens) screen.classList.toggle('is-active', screen.dataset.mobileScreen === id);
    };

    // Активным считается шаг, пересёкший середину экрана: телефон меняется
    // тогда же, когда читатель доходит до соответствующего тезиса.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = (entry.target as HTMLElement).dataset.mobileStep;
          if (id) show(id);
        }
      },
      { rootMargin: '-50% 0px -50% 0px', threshold: 0 },
    );

    for (const step of steps) observer.observe(step);
  }
</script>

<style>
  .steps {
    display: grid;
    gap: clamp(48px, 9vh, 96px);
    margin: 44px 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    opacity: 0.45;
    transition: opacity 0.4s var(--ease-site);
  }

  .step.is-active {
    opacity: 1;
  }

  .step-medallion {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-ink);
    border-radius: 50%;
    color: var(--p-mint-700);
    --icon-size: 22px;
  }

  .step.is-active .step-medallion {
    border-color: rgb(93 185 162 / 0.5);
    background: rgb(141 215 193 / 0.16);
  }

  .step-kicker {
    margin: 16px 0 0;
    color: rgb(16 20 26 / 0.45);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .step b {
    display: block;
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .step .evidence {
    margin: 10px 0 0;
    max-width: 40ch;
  }

  /* ── Телефон ─────────────────────────────────────────────────────── */
  .phone-hold {
    position: sticky;
    top: 96px;
    display: flex;
    justify-content: center;
  }

  .phone {
    position: relative;
    width: min(100%, 300px);
    height: 604px;
    overflow: hidden;
    border: 9px solid var(--p-ink-950);
    border-radius: 38px;
    background: var(--p-ink-900);
    box-shadow: 0 26px 60px rgb(16 20 26 / 0.28);
  }

  .phone-screen {
    position: absolute;
    inset: 0;
    padding: 26px 18px 18px;
    opacity: 0;
    transition: opacity 0.4s var(--ease-site);
  }

  /* Активный экран проставлен уже в разметке: без JS сцена остаётся рабочей,
     просто телефон не переключается. */
  .phone-screen.is-active {
    opacity: 1;
  }

  .ph-kicker {
    margin: 0;
    color: rgb(247 243 236 / 0.4);
    font-family: var(--font-project);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .ph-title {
    margin: 6px 0 18px;
    color: var(--p-paper-soft);
    font-family: var(--font-project-display);
    font-size: 22px;
  }

  .ph-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ph-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 4px 10px;
    border: 1px solid var(--line-light);
    border-radius: 10px;
    background: rgb(16 20 26 / 0.6);
    padding: 11px 12px;
  }

  .ph-list b {
    color: var(--p-paper-soft);
    font-size: 13px;
    font-weight: 600;
  }

  .ph-list i {
    grid-column: 2;
    color: rgb(247 243 236 / 0.45);
    font-size: 11px;
    font-style: normal;
  }

  .ph-list--rfq li {
    grid-template-columns: 1fr;
  }

  .ph-list--rfq i {
    grid-column: 1;
    font-family: var(--font-mono);
  }

  .ph-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--tint);
  }

  .ph-step {
    margin-bottom: 14px;
  }

  .ph-step-label {
    display: block;
    margin-bottom: 6px;
    color: rgb(247 243 236 / 0.45);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ph-chips,
  .ph-channels {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ph-channels {
    margin-top: 16px;
  }

  .ph-chip {
    border: 1px solid var(--line-light);
    border-radius: 7px;
    background: rgb(16 20 26 / 0.6);
    padding: 6px 10px;
    color: rgb(247 243 236 / 0.7);
    font-size: 11px;
  }

  .ph-chip.is-on {
    border-color: rgb(141 215 193 / 0.55);
    background: rgb(141 215 193 / 0.12);
    color: var(--p-mint-300);
  }

  .ph-btn {
    display: block;
    margin-top: 18px;
    border-radius: 9px;
    padding: 11px;
    background: var(--p-mint-400);
    color: #11302a;
    font-size: 12px;
    font-weight: 600;
    text-align: center;
  }

  /* ── Слои продукта ───────────────────────────────────────────────── */
  .layers-block {
    margin-top: clamp(72px, 8vh, 112px);
    row-gap: 32px;
  }

  .layers-copy {
    grid-column: 1 / span 4;
  }

  .layers-note {
    margin-top: 20px;
  }

  .layers-grid {
    display: grid;
    grid-column: 6 / -1;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 16px;
  }

  .layer-card {
    border: 1px solid var(--line-ink);
    border-radius: 12px;
    background: var(--color-paper);
    padding: 20px;
    color: var(--p-mint-700);
    --icon-size: 22px;
  }

  .layer-card b {
    display: block;
    margin-top: 12px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .layer-card .evidence {
    margin: 8px 0 0;
  }

  /* ── Инженерные цифры ────────────────────────────────────────────── */
  .stats-row {
    margin-top: clamp(48px, 5vh, 72px);
    row-gap: 28px;
    border-top: 1px solid var(--line-ink);
    padding-top: 32px;
  }

  .stats {
    display: grid;
    grid-column: 1 / span 7;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 24px;
  }

  .stat strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(26px, 2.6vw, 36px);
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .stat b {
    display: block;
    margin-top: 6px;
    font-size: 14px;
    font-weight: 600;
  }

  .stat span {
    display: block;
    margin-top: 4px;
    color: var(--text-soft);
    font-size: 12.5px;
    line-height: 1.45;
  }

  .stack {
    grid-column: 9 / -1;
    margin: 0;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.7;
  }

  @media (max-width: 1000px) {
    .phone-hold {
      position: static;
    }

    .steps {
      gap: 36px;
    }

    .step {
      opacity: 1;
    }
  }
</style>
