---
/**
 * Глава 04. Выбор — одна тёмная глава из двух актов.
 *
 * Мысль главы простая: сначала человек понимает, какой материал ему нужен,
 * затем собирает конкретное исполнение. Поэтому здесь нет отдельных номеров
 * на линейку, конфигуратор и «предметность» — это один разговор, разделённый
 * воздухом и одной волосяной линией.
 *
 * Акт A — плоскость сравнения: колонка равна материалу, строка равна свойству,
 * сроки подписаны над колонками. Положение материала само несёт информацию,
 * поэтому карточек-плиток здесь нет.
 *
 * Акт B — рабочая плоскость конфигуратора: предмет слева, управление справа,
 * итог там же внизу. Параметры переключаются по-настоящему: это единственное
 * место кейса, где интерактив показывает саму работу, а не украшает её.
 *
 * Цветовое правило главы: мятный — состояние интерфейса, фиолетовый — свойство
 * продукта. Смешивать их как два равноправных акцента нельзя.
 */
interface Props {
  presentation: any;
}

const { presentation } = Astro.props;
const { materials, configurator, photos } = presentation;

/** Строки матрицы сравнения: подписи здесь, значения — в полях материала. */
const MATRIX_ROWS: { label: string; key: string }[] = [
  { label: 'Рассасывание', key: 'pace' },
  { label: 'Структура нити', key: 'structure' },
  { label: 'Состав', key: 'composition' },
  { label: 'Стерилизация', key: 'sterilization' },
  { label: 'Форма поставки', key: 'supply' },
];

/** Иглы иллюстрируются собственными иконками проекта: у каждой геометрии свой файл. */
const NEEDLE_ICONS: Record<string, string> = {
  'Колющая': 'needle-taper.svg',
  'Режущая': 'needle-cutting.svg',
  'Обратно-режущая': 'needle-reverse-cutting.svg',
  'Таперкат': 'needle-tapercut.svg',
  'Шпательная': 'needle-spatula.svg',
};

const ICON_BASE = '/assets/works/suture/icons';
const THREADS: Record<string, string> = {
  braided: photos.configThread.src,
  mono: photos.configThreadMono.src,
};
const LOOP = photos.configThreadLoop.src;

/** Ключи шагов: по ним скрипт связывает чипы, этикетку и итог. */
const STEP_KEYS = ['format', 'length', 'needle'];
const stepsWithKeys = configurator.steps.map((step: any, index: number) => ({
  ...step,
  key: STEP_KEYS[index] ?? `step-${index}`,
}));
const [formatStep, lengthStep, needleStep] = stepsWithKeys;
---

<section
  class="scene choice"
  data-bg="ink"
  data-mode-scope
  data-mode-active={materials.items[0].id}
  data-config
>
  <div class="wrap">
    {/* ── Акт A: сравнение материалов ──────────────────────────────── */}
    <div class="chapter act">
      <div class="chapter-copy">
        <p class="s-label"><b>04</b> {materials.eyebrow}</p>
        <h2 class="s-title">
          {materials.title.map((line: string, index: number) => (
            <>{index > 0 && <br />}{line}</>
          ))}
        </h2>
        {materials.text.map((paragraph: string) => (
          <p class="s-text" set:html={paragraph} />
        ))}
        <p class="act-lead">{materials.lead}</p>
      </div>

      <div class="chapter-visual project-layer">
        <p class="part-label">Сравнение материалов</p>

        {/* Одна сетка на всю плоскость: шкала сроков, колонки материалов и
            матрица свойств стоят по одним и тем же вертикалям. */}
        <div class="matrix-scroll">
        <div class="matrix">
          <span class="matrix-corner" aria-hidden="true"></span>
          {materials.items.map((item: any) => (
            <p class="term">{item.termLabel}</p>
          ))}

          <span class="matrix-corner" aria-hidden="true"></span>
          {materials.items.map((item: any, index: number) => (
            <button
              class:list={['mat', index === 0 && 'is-active']}
              type="button"
              aria-pressed={index === 0 ? 'true' : 'false'}
              data-mode-btn={item.id}
              data-mode-label={item.name}
              data-mode-sublabel={`${item.group} · ${item.structure.toLowerCase()}`}
            >
              {/* Виток тонируется реальным цветом нити материала: один рендер
                  обслуживает всю линейку — тот же приём, что в конфигураторе. */}
              <span
                class="mat-thread thread-tint"
                style={`--thread-tint: ${item.tint}; --thread-mask: url(${LOOP})`}
              >
                <img src={LOOP} alt="" width="220" height="130" loading="lazy" />
              </span>
              <b>{item.name}</b>
            </button>
          ))}

          {MATRIX_ROWS.map((row) => (
            <>
              <p class="row-label">{row.label}</p>
              {materials.items.map((item: any, index: number) => (
                <p
                  class:list={['cell', index === 0 && 'is-active']}
                  data-mode-mark={item.id}
                >{item[row.key]}</p>
              ))}
            </>
          ))}
        </div>
        </div>

        <p class="matrix-note">{materials.scaleNote}</p>
      </div>
    </div>

    {/* ── Акт B: конкретное исполнение ─────────────────────────────── */}
    <div class="chapter act act--config">
      <div class="chapter-copy">
        <p class="p-kicker act-kicker">{configurator.eyebrow}</p>
        <h2 class="s-title">
          {configurator.title.map((line: string, index: number) => (
            <>{index > 0 && <br />}{line}</>
          ))}
        </h2>
        {configurator.text.map((paragraph: string) => (
          <p class="s-text" set:html={paragraph} />
        ))}
      </div>

      <div class="chapter-visual project-layer">
        <p class="bridge">{configurator.bridge}</p>

        {/* Одна рабочая плоскость, разделённая волосяной линией: предмет и
            управление — не две карточки внутри третьей. */}
        <div class="config">
          <div class="config-product">
            {materials.items.map((item: any, index: number) => (
              <div
                class:list={['mat-panel', index === 0 && 'is-active']}
                data-mode-panel={item.id}
              >
                <p class="p-kicker pane-kicker">Выбранный материал</p>
                <p class="config-name">{item.name}</p>
                <p class="config-sub">{item.group} · {item.structure.toLowerCase()}</p>

                <div class="features">
                  <div class="feature">
                    <span class="p-asset-icon"><img src={`${ICON_BASE}/feature-duration.svg`} alt="" /></span>
                    <span><b>{item.pace} рассасывание</b><small>{item.term ?? 'не рассасывается'}</small></span>
                  </div>
                  <div class="feature">
                    <span class="p-asset-icon"><img src={`${ICON_BASE}/feature-structure.svg`} alt="" /></span>
                    <span><b>{item.structure}</b><small>Структура нити</small></span>
                  </div>
                  <div class="feature">
                    <span class="p-asset-icon"><img src={`${ICON_BASE}/feature-sterilization.svg`} alt="" /></span>
                    <span><b>{item.sterilization} стерилизация</b><small>EO</small></span>
                  </div>
                  <div class="feature">
                    <span class="p-asset-icon"><img src={`${ICON_BASE}/feature-material.svg`} alt="" /></span>
                    <span><b>{item.supply}</b><small>Форма поставки</small></span>
                  </div>
                </div>

                <div class="stage" aria-hidden="true">
                  <img class="layer layer--box" src={photos.configBox.src} alt="" loading="lazy" />
                  <div
                    class="layer layer--thread thread-tint"
                    style={`--thread-tint: ${item.tint}; --thread-mask: url(${THREADS[item.thread]})`}
                  >
                    <img src={THREADS[item.thread]} alt="" loading="lazy" />
                  </div>
                  <img class="layer layer--needle" src={photos.configNeedle.src} alt="" loading="lazy" />
                  <div class="layer layer--sachet">
                    <img src={photos.configSachet.src} alt="" loading="lazy" />
                    {/* Этикетка — живой текст на плоскости сашета: значения
                        меняются вместе с параметрами справа. */}
                    <div class="label-scaler">
                      <div class="label-plane">
                        <div class="label-row">
                          <span class="label-kicker">Шовный материал</span>
                          <span class="label-sterile">STERILE | EO</span>
                        </div>
                        <div class="label-name">{item.name}</div>
                        <div class="label-structure">{item.structure.toLowerCase()}</div>
                        <div class="label-meta">
                          <div><span>Формат</span><b data-config-out="format">{formatStep.active}</b></div>
                          <div><span>Длина</span><b data-config-out="length">{lengthStep.active}</b></div>
                          <div><span>Игла</span><b data-config-out="needle">{needleStep.active}</b></div>
                        </div>
                      </div>
                      <div class="label-gloss"></div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <div class="config-options">
            <p class="p-kicker pane-kicker">Параметры</p>

            {stepsWithKeys.map((step: any) => (
              <div class="step" data-config-step={step.key}>
                <p class="step-title"><span class="step-num">{step.num}</span> {step.label}</p>
                <div class:list={['step-options', step.key === 'needle' && 'step-options--needle']}>
                  {step.options.map((option: string) => (
                    <button
                      class:list={['p-chip', option === step.active && 'p-chip--on']}
                      type="button"
                      aria-pressed={option === step.active ? 'true' : 'false'}
                      data-config-opt={step.key}
                      data-config-value={option}
                    >
                      {NEEDLE_ICONS[option] && (
                        <img class="needle-icon" src={`${ICON_BASE}/${NEEDLE_ICONS[option]}`} alt="" width="34" height="26" loading="lazy" />
                      )}
                      {option}
                    </button>
                  ))}
                </div>
              </div>
            ))}

            <div class="summary">
              <p class="p-kicker pane-kicker">{configurator.summaryTitle}</p>
              <p class="summary-line">
                <span data-mode-name>{materials.items[0].name}</span> ·
                <span data-config-out="format">{formatStep.active}</span> ·
                <span data-config-out="length">{lengthStep.active}</span> ·
                <span data-config-out="needle">{needleStep.active}</span>
              </p>
              <span class="p-btn config-add">{configurator.cta}<i>+</i></span>
            </div>
          </div>
        </div>

        {/* Предметность — не отдельная сцена, а полоса из двух заметок. */}
        <div class="craft">
          {configurator.craft.map((item: any) => (
            <div class="craft-item">
              <div class="craft-copy">
                <b><span class="craft-dot"></span>{item.title}</b>
                <p class="evidence">{item.text}</p>
              </div>
              {item.tinted ? (
                materials.items.map((mat: any, index: number) => (
                  <span
                    class:list={['craft-shot', 'thread-tint', index === 0 && 'is-active']}
                    data-mode-mark={mat.id}
                    style={`--thread-tint: ${mat.tint}; --thread-mask: url(${item.image})`}
                  >
                    <img src={item.image} alt={item.alt} loading="lazy" />
                  </span>
                ))
              ) : (
                <span class="craft-shot is-active">
                  <img src={item.image} alt={item.alt} loading="lazy" />
                </span>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    {/* ── Эпилог: тот же выбор на телефоне ─────────────────────────── */}
    <div class="chapter act act--mobile">
      <div class="chapter-copy">
        <p class="p-kicker act-kicker">{configurator.mobile.eyebrow}</p>
        <p class="mobile-text">{configurator.mobile.text}</p>
        <ul class="checks">
          {configurator.mobile.checks.map((check: string) => (
            <li>{check}</li>
          ))}
        </ul>
      </div>

      <div class="chapter-visual project-layer">
        {/* Экраны собраны той же вёрсткой, что и десктоп: это не скриншоты,
            а тот же интерфейс в одну колонку. */}
        <div class="phones">
          <div class="phone">
            <p class="phone-back">←</p>
            <p class="phone-name" data-mode-name>{materials.items[0].name}</p>
            <p class="phone-sub" data-mode-sub>{materials.items[0].group} · {materials.items[0].structure.toLowerCase()}</p>
            <p class="phone-step"><span>{formatStep.num}</span> {formatStep.label}</p>
            <ul class="phone-opts">
              {formatStep.options.map((option: string) => (
                <li class:list={[option === formatStep.active && 'is-on']}>{option}</li>
              ))}
            </ul>
          </div>

          <span class="phone-arrow" aria-hidden="true">→</span>

          <div class="phone">
            <p class="phone-back">←</p>
            <p class="phone-step"><span>{lengthStep.num}</span> {lengthStep.label}</p>
            <ul class="phone-opts">
              {lengthStep.options.map((option: string) => (
                <li class:list={[option === lengthStep.active && 'is-on']}>{option}</li>
              ))}
            </ul>
            <p class="phone-step"><span>{needleStep.num}</span> {needleStep.label}</p>
            <ul class="phone-opts phone-opts--needle">
              {needleStep.options.slice(0, 3).map((option: string) => (
                <li class:list={[option === needleStep.active && 'is-on']}>
                  <img src={`${ICON_BASE}/${NEEDLE_ICONS[option]}`} alt="" width="28" height="20" loading="lazy" />
                  {option}
                </li>
              ))}
            </ul>
          </div>

          <span class="phone-arrow" aria-hidden="true">→</span>

          <div class="phone">
            <p class="phone-title">{configurator.summaryTitle}</p>
            <dl class="phone-summary">
              <div><dt>Материал</dt><dd data-mode-name>{materials.items[0].name}</dd></div>
              {configurator.summary.map((row: any, index: number) => (
                <div>
                  <dt>{row.label}</dt>
                  <dd data-config-out={STEP_KEYS[index]}>{row.value}</dd>
                </div>
              ))}
            </dl>
            <span class="p-btn phone-btn">{configurator.cta}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ритм главы задан макетом: два акта и эпилог внутри одной тёмной полосы. */
  .choice {
    padding-block: clamp(72px, 7.5vw, 116px) clamp(80px, 8vw, 128px);
  }

  .act + .act {
    margin-top: clamp(76px, 8vw, 132px);
  }

  /* Единственная линия внутри главы — шов между актами. */
  .act--config {
    border-top: 1px solid var(--line-light);
    padding-top: clamp(56px, 5.5vw, 84px);
  }

  .act--mobile {
    margin-top: clamp(56px, 6vw, 88px);
  }

  .act-lead {
    margin: 28px 0 0;
    max-width: 26ch;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
  }

  .act-kicker {
    color: var(--p-mint-400);
  }

  .act--config .chapter-copy .s-title,
  .act--mobile .chapter-copy .s-title {
    margin-top: 16px;
  }

  /* ── Акт A: плоскость сравнения ──────────────────────────────────── */
  .matrix {
    display: grid;
    grid-template-columns: 132px repeat(6, minmax(0, 1fr));
    column-gap: 10px;
    align-items: start;
  }

  /* Срок подписан над колонкой: положение материала само несёт информацию. */
  .term {
    position: relative;
    margin: 0 0 26px;
    padding-top: 16px;
    color: rgb(247 243 236 / 0.62);
    font-size: 11.5px;
    line-height: 1.3;
    text-align: center;
  }

  .term::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    width: 5px;
    height: 5px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--p-mint-400);
  }

  .term::after {
    content: '';
    position: absolute;
    top: -1px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--line-light);
  }

  .mat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    box-sizing: border-box;
    margin-bottom: 28px;
    border: 1px solid var(--line-light);
    border-radius: 10px;
    background: rgb(21 26 33 / 0.7);
    padding: 14px 10px 16px;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease-site),
      background-color 0.2s var(--ease-site);
  }

  .mat:hover {
    border-color: rgb(247 243 236 / 0.24);
  }

  /* Активный материал держит мятную кромку — тот же сигнал выбора, что и
     у чипов конфигуратора ниже. */
  .mat.is-active {
    border-color: rgb(141 215 193 / 0.5);
    background: rgb(141 215 193 / 0.08);
  }

  .mat b {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
  }

  .mat-thread {
    display: block;
    position: relative;
    width: 100%;
  }

  .mat-thread img {
    display: block;
    width: 100%;
    height: auto;
  }

  .row-label,
  .cell {
    margin: 0;
    border-top: 1px solid rgb(247 243 236 / 0.08);
    padding: 13px 4px;
    font-size: 12.5px;
    line-height: 1.35;
  }

  .row-label {
    color: rgb(247 243 236 / 0.45);
  }

  .cell {
    color: rgb(247 243 236 / 0.78);
    text-align: center;
  }

  .cell:not(.is-active) {
    color: rgb(247 243 236 / 0.5);
  }

  .cell.is-active {
    color: var(--color-paper);
  }

  .matrix-note {
    margin: 20px 0 0;
    color: rgb(247 243 236 / 0.38);
    font-size: 12px;
  }

  /* ── Переход A → B ───────────────────────────────────────────────── */
  .bridge {
    margin: 0 0 22px;
    color: rgb(247 243 236 / 0.5);
    font-size: 13.5px;
  }

  /* ── Акт B: рабочая плоскость ────────────────────────────────────── */
  .config {
    display: grid;
    grid-template-columns: 1.42fr 1fr;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 20px;
    background: var(--p-card);
  }

  .config-product {
    position: relative;
    min-height: 442px;
    border-right: 1px solid rgb(255 255 255 / 0.08);
    background:
      radial-gradient(circle at 57% 58%, rgb(43 54 67 / 0.5), transparent 45%),
      linear-gradient(135deg, rgb(255 255 255 / 0.03), transparent 38%);
  }

  /* Панели материалов лежат стопкой и кроссфейдятся: плоскость не должна
     прыгать по высоте от того, что у одного материала подпись длиннее. */
  .mat-panel {
    position: absolute;
    inset: 0;
    padding: 26px 28px;
    opacity: 0;
    transition: opacity 0.22s var(--ease-site);
  }

  .mat-panel.is-active {
    position: relative;
    opacity: 1;
  }

  .pane-kicker {
    color: rgb(247 243 236 / 0.4);
  }

  .config-name {
    position: relative;
    z-index: 8;
    max-width: 11ch;
    margin: 10px 0 0;
    font-family: var(--font-project-display);
    font-size: clamp(21px, 1.8vw, 27px);
    line-height: 1.05;
  }

  .config-sub {
    position: relative;
    z-index: 8;
    margin: 8px 0 0;
    color: rgb(247 243 236 / 0.5);
    font-size: 12.5px;
  }

  .features {
    position: relative;
    z-index: 8;
    display: grid;
    width: min(50%, 236px);
    gap: 8px;
    margin-top: 24px;
  }

  .feature {
    display: flex;
    min-height: 46px;
    align-items: center;
    gap: 11px;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 9px;
    background: rgb(13 18 24 / 0.62);
    padding: 8px 12px;
    font-size: 12.5px;
    line-height: 1.18;
  }

  .feature b {
    display: block;
    font-weight: 500;
  }

  .feature small {
    display: block;
    margin-top: 3px;
    color: rgb(247 243 236 / 0.45);
    font-size: 10.5px;
  }

  /* ── Сцена продукта: слои в процентах от кадра ───────────────────── */
  .stage {
    position: absolute;
    inset: 0;
    overflow: clip;
    pointer-events: none;
  }

  .layer {
    position: absolute;
    display: block;
  }

  .layer img {
    display: block;
    width: 100%;
  }

  .layer--box {
    z-index: 1;
    top: 6%;
    left: 64%;
    width: 28%;
    opacity: 0.66;
    filter: drop-shadow(0 22px 34px rgb(0 0 0 / 0.34));
  }

  .layer--thread {
    z-index: 4;
    top: 38%;
    left: 42%;
    width: 62%;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.65));
  }

  /* У лигатуры и петли иглы нет — предмет обязан это показывать, иначе
     сцена спорит с параметрами. */
  .choice.is-needleless .layer--needle {
    opacity: 0;
    transition: opacity 0.18s var(--ease-site);
  }

  .layer--needle {
    z-index: 6;
    top: 68%;
    left: 40%;
    width: 37%;
    filter: drop-shadow(0 8px 9px rgb(0 0 0 / 0.58));
  }

  .layer--sachet {
    z-index: 3;
    top: 26%;
    left: 52%;
    width: 39%;
    filter: drop-shadow(0 20px 18px rgb(0 0 0 / 0.38));
  }

  /* Ассет нити нейтрально-серый: цвет кладётся multiply поверх него, чтобы
