---
/**
 * Глава 1. Первый экран кейса.
 *
 * Слева — студийная постановка задачи, справа — сразу физический продукт и
 * кусок интерфейса в одном кадре. Это тезис всего кейса, показанный до того,
 * как он произнесён словами: коробка, сашет, нить и карточка конфигуратора
 * лежат в одной композиции, потому что в проекте они и работают как одно целое.
 *
 * Ассеты донора обрезаны по содержимому и отрендерены по одному предмету на
 * кадр, поэтому композиция задаётся позиционированием в процентах от сцены —
 * ровно так же, как в самом конфигураторе ИМЭКС.
 */
interface Props {
  title: string;
  presentation: any;
}

const { title, presentation } = Astro.props;
const { photos, heroTitle, roles } = presentation;
---

<section class="sutures-hero" data-bg="ink">
  <div class="wrap hero-grid" data-reveal-group>
    <p class="hero-kicker">{title} · {presentation.sector} · {presentation.year}</p>

    <div class="hero-copy">
      <h1>
        <span class="hero-title-line">Упаковали</span>
        <span class="hero-title-line">медицинский</span>
        <span class="hero-title-line">продукт</span>
        <span class="hero-em">{heroTitle.em}</span>
      </h1>
      <div class="hero-lead">
        {presentation.lead.map((paragraph: string) => <p>{paragraph}</p>)}
      </div>
      <ul class="hero-roles">
        {roles.map((role: string) => <li>{role}</li>)}
      </ul>
      <a class="hero-visit" href={presentation.projectUrl} target="_blank" rel="noreferrer">
        Перейти на сайт <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="hero-visual project-layer" aria-hidden="true">
      <div class="hero-stage">
        <img class="layer layer--box" src={photos.configBox.src} alt="" />
        <img class="layer layer--thread" src={photos.configThread.src} alt="" />
        <img class="layer layer--needle" src={photos.configNeedle.src} alt="" />
        <img class="layer layer--sachet" src={photos.configSachet.src} alt="" />
      </div>

      <div class="hero-card p-card">
        <p class="p-kicker">Выбранный материал</p>
        <p class="hero-card-name">Лактисорб</p>
        <p class="hero-card-sub">Рассасывающийся · плетёная нить</p>
        <dl class="hero-card-rows">
          <div><dt>Формат</dt><dd>Нить с иглой</dd></div>
          <div><dt>Длина</dt><dd>75 см</dd></div>
          <div><dt>Игла</dt><dd>Обратно-режущая</dd></div>
        </dl>
        <span class="hero-card-btn">Добавить в подборку <b aria-hidden="true">＋</b></span>
      </div>
    </div>

  </div>
</section>

<style>
  .sutures-hero {
    position: relative;
    box-sizing: border-box;
    min-height: 800px;
    padding-block: 132px 64px;
    /* Мятное свечение за продуктом — приём донора (.hero-product-wrap::before),
       перенесённый один в один: холодный студийный свет предмета иначе
       проваливается в почти чёрный фон. */
    background:
      radial-gradient(circle at 72% 46%, rgb(141 215 193 / 0.09), transparent 42%),
      var(--p-ink-950);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 34px;
    align-items: start;
  }

  .hero-kicker {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--p-mint-400);
    font-family: var(--font-text);
    font-size: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-copy {
    grid-column: 1 / span 5;
  }

  .hero-copy h1 {
    margin: 0;
    font-family: 'Onest', sans-serif;
    font-size: clamp(48px, 3.65vw, 60px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.96;
    text-wrap: balance;
  }

  /* Вторая строка заголовка мятная: акцент принадлежит клиенту, и первое, что
     он делает на странице, — договаривает мысль студийного заголовка. */
  .hero-em {
    display: block;
    color: var(--p-mint-400);
  }

  .hero-title-line {
    display: block;
  }

  .hero-lead {
    margin: 24px 0 0;
    max-width: none;
    color: var(--text-soft-light);
    font-size: 16px;
    line-height: 1.48;
    text-wrap: pretty;
  }

  .hero-lead p {
    margin: 0;
  }

  .hero-lead p + p {
    margin-top: 8px;
  }

  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    color: rgb(247 243 236 / 0.5);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero-roles li::before {
    content: '#';
    margin-right: 0.35em;
    color: var(--p-mint-400);
  }

  .hero-visual {
    position: relative;
    grid-column: 6 / -1;
    grid-row: 2;
  }

  /* Сцена продукта: пропорция задана padding-top, чтобы слои в процентах не
     плавали при смене ширины колонки. */
  .hero-stage {
    position: relative;
    padding-top: 70%;
  }

  .layer {
    position: absolute;
    display: block;
  }

  .layer--box {
    z-index: 1;
    top: -5%;
    left: 43%;
    width: 52%;
    opacity: 0.78;
    filter: drop-shadow(0 22px 34px rgb(0 0 0 / 0.4));
  }

  .layer--thread {
    z-index: 2;
    top: 20%;
    left: 19%;
    width: 91%;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.6));
  }

  .layer--needle {
    z-index: 3;
    top: 47%;
    left: 0;
    width: 52%;
    filter: drop-shadow(0 8px 9px rgb(0 0 0 / 0.55));
  }

  .layer--sachet {
    z-index: 4;
    top: 30%;
    left: 7%;
    width: 58%;
    filter: drop-shadow(0 20px 18px rgb(0 0 0 / 0.42));
  }

  /* Карточка интерфейса лежит поверх предмета — на макете это единственное
     место, где цифровое и физическое буквально накладываются. */
  .hero-card {
    position: absolute;
    right: 8%;
    bottom: 0;
    z-index: 6;
    width: min(52%, 365px);
    padding: 25px;
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--p-card) 88%, transparent);
  }

  .hero-card .p-kicker {
    color: rgb(247 243 236 / 0.42);
  }

  .hero-card-name {
    margin: 8px 0 0;
    font-family: var(--font-project-display);
    font-size: 30px;
    line-height: 1.1;
  }

  .hero-card-sub {
    margin: 8px 0 0;
    color: rgb(247 243 236 / 0.5);
    font-size: 16px;
  }

  .hero-card-rows {
    margin: 20px 0 0;
    display: grid;
    gap: 11px;
  }

  .hero-card-rows div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--line-light);
    padding-bottom: 10px;
    font-size: 16px;
  }

  .hero-card-rows dt {
    color: rgb(247 243 236 / 0.45);
  }

  .hero-card-rows dd {
    margin: 0;
    color: var(--p-paper-soft);
  }

  .hero-card-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 20px;
    border-radius: 8px;
    padding: 16px 18px;
    background: var(--p-mint-400);
    color: #11302a;
    font-size: 15px;
    font-weight: 600;
    text-align: center;
  }

  .hero-visit {
    display: inline-block;
    margin-top: 26px;
    color: var(--p-mint-400);
    font-size: 15px;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
    transition: opacity 0.2s ease;
  }

  .hero-visit:hover {
    opacity: 0.7;
  }

  @media (max-width: 1000px) {
    .sutures-hero {
      min-height: auto;
      padding-block: 104px 56px;
    }
    .hero-grid {
      display: block;
    }

    .hero-visual {
      margin-top: 48px;
    }

    .hero-card {
      position: static;
      width: auto;
      margin-top: 20px;
    }

  }

  @media (max-width: 560px) {
    .hero-copy h1 {
      font-size: clamp(38px, 12vw, 52px);
    }

    .hero-card {
      padding: 20px;
    }
  }
</style>
