---
/**
 * Глифы кейса «ИМЭКС» — контур в один вес, как техническая пиктограмма на
 * упаковке медизделия.
 *
 * У проекта есть собственные иконки-ассеты (feature-*.svg и needle-*.svg), но
 * их всего девять и они про свойства материала. Всё остальное — путь продукта,
 * каналы запроса, почтовый контур — рисуется здесь вектором: значок остаётся
 * резким на любом кегле, красится currentColor и ничего не весит.
 *
 * Разметка принимает имя, а не путь: если у проекта появится свой комплект,
 * подменить можно точечно.
 */
interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['p-icon', className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  {name === 'eye' && (
    <>
      <path d="M1.8 12S5.4 5.4 12 5.4 22.2 12 22.2 12 18.6 18.6 12 18.6 1.8 12 1.8 12Z" />
      <circle cx="12" cy="12" r="3.2" />
    </>
  )}

  {name === 'book' && (
    <>
      <path d="M12 6.4C10.3 5 8.2 4.3 5 4.3v13c3.2 0 5.3.7 7 2.1 1.7-1.4 3.8-2.1 7-2.1v-13c-3.2 0-5.3.7-7 2.1Z" />
      <path d="M12 6.4v13" />
    </>
  )}

  {name === 'sliders' && (
    <>
      <path d="M3.4 7.4h17M3.4 16.6h17" />
      <circle cx="9" cy="7.4" r="2.3" />
      <circle cx="15.4" cy="16.6" r="2.3" />
    </>
  )}

  {name === 'send' && (
    <>
      <path d="M21 3 2.8 10.4l7.6 3.2L21 3Z" />
      <path d="M21 3 10.4 13.6l3.2 7.6L21 3Z" />
    </>
  )}

  {name === 'box' && (
    <>
      <path d="M12 2.8 3.6 6.9v10.2L12 21.2l8.4-4.1V6.9Z" />
      <path d="M3.6 6.9 12 11l8.4-4.1" />
      <path d="M12 11v10.2" />
    </>
  )}

  {name === 'thread' && (
    <path d="M4 18.6c3.4 0 3.4-4.6 6.8-4.6s3.4 4.6 6.8 4.6M4 9.4c3.4 0 3.4-4.6 6.8-4.6s3.4 4.6 6.8 4.6" />
  )}

  {name === 'needle' && (
    <>
      <path d="M20.4 5.2c-8 0-12.6 4-12.6 8.6a4.6 4.6 0 0 0 4.6 4.6" />
      <path d="M3.6 20.4 8 16" />
    </>
  )}

  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8.6" />
      <path d="M12 7v5.3l3.4 2" />
    </>
  )}

  {name === 'list' && (
    <>
      <rect x="4" y="3.6" width="16" height="16.8" rx="2.4" />
      <path d="M8.2 9h7.6M8.2 12.6h7.6M8.2 16.2h4.6" />
    </>
  )}

  {name === 'mail' && (
    <>
      <rect x="2.8" y="5.2" width="18.4" height="13.6" rx="2.4" />
      <path d="m3.6 7 8.4 6 8.4-6" />
    </>
  )}

  {name === 'chat' && (
    <path d="M20.4 12.6c0 3.9-3.8 7-8.4 7a9.8 9.8 0 0 1-2.9-.4L4 21l1.5-3.6a6.6 6.6 0 0 1-2-4.8c0-3.9 3.8-7 8.5-7s8.4 3.1 8.4 7Z" />
  )}

  {name === 'copy' && (
    <>
      <rect x="8.6" y="8.6" width="11.8" height="11.8" rx="2.2" />
      <path d="M15.8 5.6a2.2 2.2 0 0 0-2.2-2H5.8a2.2 2.2 0 0 0-2.2 2.2v7.8c0 1.1.9 2 2 2.2" />
    </>
  )}

  {name === 'server' && (
    <>
      <rect x="3.2" y="4" width="17.6" height="6.4" rx="1.8" />
      <rect x="3.2" y="13.6" width="17.6" height="6.4" rx="1.8" />
      <path d="M7 7.2h.01M7 16.8h.01" />
    </>
  )}

  {name === 'shield' && (
    <>
      <path d="M12 2.6 4.6 5.6v6.1c0 4.4 3 8.2 7.4 9.7 4.4-1.5 7.4-5.3 7.4-9.7V5.6Z" />
      <path d="m8.9 11.9 2.2 2.3 4-4.4" />
    </>
  )}

  {name === 'phone' && (
    <>
      <rect x="6.4" y="2.4" width="11.2" height="19.2" rx="2.6" />
      <path d="M10.4 5.4h3.2" />
      <path d="M10.8 18.6h2.4" />
    </>
  )}

  {name === 'layers' && (
    <>
      <path d="M12 3.2 3.4 7.6 12 12l8.6-4.4Z" />
      <path d="m3.4 12.6 8.6 4.4 8.6-4.4" />
      <path d="m3.4 17.2 8.6 4.4 8.6-4.4" />
    </>
  )}

  {name === 'check' && (
    <>
      <circle cx="12" cy="12" r="8.6" />
      <path d="m8.4 12.2 2.4 2.4 4.8-5" />
    </>
  )}

  {name === 'chart' && (
    <>
      <path d="M3.6 20.4h16.8" />
      <path d="M7 20.4v-5.8M12 20.4V8.6M17 20.4v-9" />
    </>
  )}

  {name === 'sterile' && (
    <>
      <circle cx="12" cy="12" r="8.6" />
      <path d="M12 3.4v17.2M3.9 7.7l16.2 8.6M20.1 7.7 3.9 16.3" />
    </>
  )}
</svg>
