---
import { site, nav } from '../data/site';
---

<header class="topbar">
  <span class="brand">{site.name}</span>
  <span class="tagline">{site.tagline}</span>
  <nav>
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</header>

<style>
  .topbar {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 14px var(--spacing-sheet);
    background: var(--color-ink);
    color: var(--color-paper);
    font: 400 11px / 1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font: 800 14px / 1 var(--font-display);
    letter-spacing: 0.02em;
    text-transform: none;
  }
  .tagline {
    color: rgb(242 242 238 / 0.6);
  }
  nav {
    margin-left: auto;
    display: flex;
    gap: 22px;
  }
  nav a {
    color: var(--color-paper);
    text-decoration: none;
    padding-bottom: 2px;
  }
  nav a:hover {
    color: #fff;
    box-shadow: 0 1px 0 var(--color-sign);
  }
  @media (max-width: 760px) {
    .tagline {
      display: none;
    }
    nav {
      gap: 14px;
      flex-wrap: wrap;
    }
  }
</style>
