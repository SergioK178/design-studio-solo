---
import { briefHref, type Product } from '../data/products';

interface Props {
  product: Product;
  showIcon?: boolean;
}

const { product, showIcon = false } = Astro.props;
const href = product.status === 'published' ? `/products/${product.slug}/` : briefHref(product);
const actionLabel = product.status === 'published' ? 'Подробнее →' : 'Разобрать задачу →';
const statusLabel = product.status === 'published' ? 'детальная страница' : 'по запросу';
---

<a class:list={['product-card', product.status === 'planned' && 'planned']} href={href}>
  <div class="card-head">
    {showIcon && product.icon && (
      <span class="icon-slot" aria-hidden="true">
        <img src={`/assets/ui/products/${product.icon}.webp`} alt="" width="224" height="224" loading="lazy" />
      </span>
    )}
    <h3>{product.name}</h3>
  </div>
  <p class="summary">{product.summary}</p>
  <div class="meta">
    <strong>{product.price}</strong>
    <span class="term">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
      {product.term}
    </span>
  </div>
  <span class="action">{actionLabel}</span>
</a>

<style>
  .product-card {
    display: grid;
    box-sizing: border-box;
    min-height: 270px;
    grid-template-rows: auto 1fr auto auto;
    gap: 16px;
    border: 1.5px solid rgb(23 21 15 / 0.18);
    background: white;
    padding: 22px;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      box-shadow 0.25s var(--ease-site),
      transform 0.25s var(--ease-site);
  }

  .product-card:hover {
    box-shadow: 10px 10px 0 var(--color-gold);
    transform: translate(-3px, -3px);
  }

  .product-card.planned {
    opacity: 0.88;
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .icon-slot {
    display: grid;
    flex: none;
    width: 62px;
    height: 62px;
    place-items: center;
    border-radius: 50%;
    background: rgb(23 21 15 / 0.05);
  }

  .icon-slot img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .status {
    display: inline-block;
    color: var(--color-blue);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status.planned {
    color: var(--color-ochre);
  }

  h3 {
    margin: 0;
    min-width: 0;
    font-family: var(--font-display);
    font-size: clamp(18px, 1.7vw, 22px);
    line-height: 1.15;
    overflow-wrap: break-word;
  }

  .summary {
    margin: 0;
    color: rgb(23 21 15 / 0.7);
    font-size: 15px;
    line-height: 1.55;
  }

  .meta {
    display: grid;
    gap: 8px;
  }

  .meta strong {
    color: var(--color-blue);
    font-size: 20px;
  }

  .term {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: rgb(23 21 15 / 0.5);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .term svg {
    flex: none;
    opacity: 0.75;
  }

  .action {
    color: var(--color-ochre);
    font-weight: 700;
  }
</style>
