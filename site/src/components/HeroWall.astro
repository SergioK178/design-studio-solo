---
import { wallColA, wallColB } from '../data/home';
import { site } from '../data/site';

const wall = [wallColA, wallColB].map((col) => [...col, ...col]);
---

<section class="hero" data-bg="ink">
  <div class="wall" aria-hidden="true">
    {wall.map((col, index) => (
      <div class:list={['wall-col', index === 1 && 'reverse']}>
        {col.map((card) => (
          <div class:list={['wall-card', `accent-${card.accent}`]}>
            <div class="wall-top">
              <b>{card.logo}</b>
              <span>{card.nav}</span>
            </div>
            <div class="slot" aria-label={`${card.assetKey}: asset pending`}>
              <span class="mono">asset pending</span>
              <em>{card.assetKey}</em>
            </div>
            <strong>{card.title}</strong>
            <span class="wall-cta">{card.cta}</span>
          </div>
        ))}
      </div>
    ))}
  </div>
  <div class="fade" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <div class="copy">
      <h1>Сайт под вашу задачу — <span>первый запуск от недели.</span></h1>
      <p class="lead">Делаем лендинги, корпоративные сайты, каталоги и интернет-магазины. Подключаем управление контентом, приём заявок, оплату и нужные сервисы.</p>
      <p class="secondary">Также создаём приложения внутри Telegram, личные кабинеты и внутренние рабочие системы.</p>
      <div class="actions">
        <a class="btn-gold" href="#brief" data-magnetic>Разобрать задачу →</a>
        <a class="btn-outline" href={site.telegramUrl} target="_blank" rel="noopener" data-magnetic>Написать в Telegram</a>
      </div>
      <div class="proof">
        <span><b>сайты под задачу бизнеса</b></span>
        <span><b>фиксированная смета</b></span>
        <span><b>весь код и данные — ваши</b></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 800px;
    overflow: hidden;
    background: var(--color-ink);
    display: flex;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    align-items: center;
    padding-top: 96px;
    padding-bottom: 70px;
  }

  .copy {
    max-width: 640px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(44px, 5.2vw, 66px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    font-weight: 800;
  }

  h1 span {
    color: var(--color-gold);
  }

  .lead {
    margin: 26px 0 0;
    max-width: 420px;
    color: rgb(244 242 236 / 0.7);
    font-size: 18px;
    line-height: 1.5;
  }

  .secondary {
    margin: 12px 0 0;
    max-width: 460px;
    color: rgb(244 242 236 / 0.52);
    font-size: 15px;
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 22px;
    margin-top: 40px;
    color: rgb(244 242 236 / 0.6);
    font-size: 13px;
  }

  .proof b {
    color: var(--color-paper);
  }

  .wall {
    position: absolute;
    top: -120px;
    right: -40px;
    z-index: 1;
    display: flex;
    gap: 20px;
    width: 620px;
    height: 1140px;
    transform: rotate(-8deg);
    opacity: 0.92;
  }

  .wall-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    animation: wallScroll 26s linear infinite;
  }

  .wall-col.reverse {
    animation-duration: 34s;
    animation-direction: reverse;
  }

  .wall-card {
    width: 250px;
    flex: none;
    box-sizing: border-box;
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 14px;
  }

  .wall-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }

  .wall-top b {
    font-size: 12px;
  }

  .wall-top span {
    color: rgb(23 21 15 / 0.5);
    font-size: 9.5px;
  }

  .slot {
    display: grid;
    place-content: center;
    gap: 6px;
    height: 76px;
    margin-bottom: 10px;
    border: 1px solid rgb(23 21 15 / 0.16);
    background:
      linear-gradient(135deg, rgb(229 164 59 / 0.12) 25%, transparent 25%) 0 0 / 14px 14px,
      color-mix(in srgb, var(--color-paper) 82%, white);
    text-align: center;
  }

  .slot .mono {
    color: var(--color-blue);
    font-size: 8px;
  }

  .slot em {
    max-width: 20ch;
    color: rgb(23 21 15 / 0.48);
    font-size: 9px;
    font-style: normal;
    line-height: 1.25;
  }

  .wall-card strong {
    display: block;
    font-size: 11.5px;
    line-height: 1.3;
  }

  .wall-cta {
    display: inline-block;
    margin-top: 8px;
    background: var(--color-gold);
    color: var(--color-ink);
    padding: 5px 9px;
    font-size: 9.5px;
    font-weight: 600;
  }

  .accent-blue .wall-top b,
  .accent-blue .wall-cta {
    color: var(--color-blue);
  }

  .accent-ochre .wall-top b,
  .accent-ochre .wall-cta {
    color: var(--color-ochre);
  }

  .accent-ink .wall-top b,
  .accent-ink .wall-cta {
    color: var(--color-ink);
  }

  .fade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, var(--color-ink) 0%, var(--color-ink) 44%, rgb(23 21 15 / 0.55) 62%, rgb(23 21 15 / 0.15) 100%);
  }

  @media (max-width: 820px) {
    .hero {
      min-height: 720px;
    }

    .wall {
      right: -260px;
      opacity: 0.5;
    }
  }

  @media (max-width: 520px) {
    h1 {
      font-size: 40px;
    }

    .hero-inner {
      padding-top: 116px;
    }

    .actions a {
      width: 100%;
      box-sizing: border-box;
      text-align: center;
    }
  }
</style>
