---
import { works } from '../data/works';
import { site } from '../data/site';

// Стена — только реальные опубликованные работы с готовой обложкой (16:10).
// Вторая колонка — та же лента, сдвинутая на половину, чтобы соседние карточки не повторялись.
// Каждая колонка — две одинаковые половины: цикл -50% бесшовный.
const covers = works.filter((work) => work.status === 'published' && work.assetSrc);
const shift = Math.ceil(covers.length / 2);
const columns = [covers, [...covers.slice(shift), ...covers.slice(0, shift)]].map((col) => [...col, ...col]);
---

<section class="hero" data-bg="ink">
  <div class="wall" aria-hidden="true">
    {columns.map((col, index) => (
      <div class:list={['wall-col', index === 1 && 'reverse']}>
        {col.map((work) => (
          <div class="wall-card">
            <img src={work.assetSrc} alt="" width="1600" height="1000" loading="lazy" />
            <span>{work.title}</span>
          </div>
        ))}
      </div>
    ))}
  </div>
  <div class="fade" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <div class="copy">
      <h1>Сайты и рабочие системы — <span>своей командой.</span></h1>
      <p class="lead">Подбираем формат под задачу: от компактного сайта до сервиса с интеграциями. Если достаточно простого решения, не усложняем.</p>
      <div class="actions">
        <a class="btn-gold btn-lg" href="/brief/" data-magnetic>Пройти бриф →</a>
        <a class="btn-outline btn-lg" href={site.telegramUrl} target="_blank" rel="noopener" data-magnetic>Обсудить проект</a>
      </div>
      <div class="proof">
        <span><b>фиксированная смета</b></span>
        <span><b>весь код и данные — ваши</b></span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hero (DESIGN-SYSTEM-V1 §25.1): слева тезис, справа пассивный диагональный конвейер
     реальных работ. IDLE = спокойное заявление + фоновое доказательство. */
  .hero {
    position: relative;
    min-height: 800px;
    overflow: hidden;
    background: var(--color-ink);
    display: flex;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    align-items: center;
    padding-top: var(--scene-opening-top);
    padding-bottom: var(--scene-opening-bottom);
  }

  .copy {
    max-width: 640px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-display-size);
    font-weight: var(--type-display-weight);
    line-height: var(--type-display-lh);
    letter-spacing: var(--type-display-tracking);
    overflow-wrap: break-word;
  }

  h1 span {
    color: var(--color-gold);
  }

  .lead {
    margin: var(--space-6) 0 0;
    max-width: 440px;
    color: var(--text-on-ink-secondary);
    font-size: var(--type-lead-size);
    font-weight: var(--type-lead-weight);
    line-height: var(--type-lead-lh);
  }


  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-10);
    color: var(--text-on-ink-muted);
    font-size: var(--type-body-sm-size);
    line-height: var(--type-body-sm-lh);
  }

  .proof b {
    color: var(--text-on-ink-primary);
    font-weight: 600;
  }

  /* Стена — один объект: две колонки, наклон -8°, по центру сцены по вертикали.
     Высота = ровно один цикл ленты (4 карточки), поэтому на краях цикла нет пустот. */
  .wall {
    --card-w: 272px;
    --card-gap: 20px;
    position: absolute;
    top: 50%;
    right: -40px;
    z-index: 1;
    display: flex;
    gap: var(--card-gap);
    width: calc(var(--card-w) * 2 + var(--card-gap));
    height: 890px;
    translate: 0 -50%;
    rotate: -8deg;
  }

  .wall-col {
    animation: wallScroll 26s linear infinite;
  }

  .wall-col.reverse {
    animation-duration: 34s;
    animation-direction: reverse;
  }

  /* Отступ (а не gap): половина ленты = ровно N карточек, без скачка на петле. */
  .wall-card {
    box-sizing: border-box;
    width: var(--card-w);
    margin-bottom: var(--card-gap);
    background: var(--color-paper);
    color: var(--color-ink);
    padding: var(--space-2);
  }

  .wall-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .wall-card span {
    display: block;
    padding: 10px var(--space-1) 2px;
    overflow: hidden;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* Затухание: слева чистый ink под текст, сверху — под Nav, снизу — мягкий край сцены. */
  .fade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, var(--color-ink) 0, transparent 140px),
      linear-gradient(0deg, var(--color-ink) 0, transparent 96px),
      linear-gradient(90deg, var(--color-ink) 0%, var(--color-ink) 46%, rgb(23 21 15 / 0.5) 60%, transparent 100%);
  }

  /* ≤1120: стена уходит правее, а текст держится в ink-зоне слева — без наезда на карточки. */
  @media (max-width: 1120px) {
    .wall {
      right: -230px;
    }

    .copy {
      max-width: min(640px, 58vw);
    }
  }

  /* ≤768: стена — фоновая атмосфера за текстом; читаемость держит вертикальное затухание. */
  @media (max-width: 768px) {
    .hero {
      min-height: 720px;
    }

    .hero-inner {
      padding-top: 96px; /* под Nav: toggle 44px + воздух */
      padding-bottom: var(--scene-opening-bottom);
    }

    .copy {
      max-width: 640px;
    }

    .wall {
      top: 0;
      right: -150px;
      translate: none;
      opacity: 0.6;
    }

    .fade {
      background:
        linear-gradient(180deg, var(--color-ink) 0, transparent 96px),
        linear-gradient(180deg, rgb(23 21 15 / 0.45) 0, rgb(23 21 15 / 0.72) 40%, var(--color-ink) 68%);
    }
  }

  @media (max-width: 640px) {
    .actions a {
      width: 100%;
      box-sizing: border-box;
      text-align: center;
    }
  }
</style>
