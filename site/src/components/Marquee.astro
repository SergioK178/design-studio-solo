---
const words = ['ЛЕНДИНГ', 'КАТАЛОГ B2B', 'МАГАЗИН', 'ЗАПИСЬ ОНЛАЙН', 'ВИТРИНА', 'ПАРСЕР'];
const row = [...words, ...words];
---

<div class="marquee" aria-hidden="true">
  <div class="track">
    {[0, 1].map(() => (
      <div class="group">
        {row.map((word) => (
          <>
            <span>{word}</span>
            <span>✳</span>
          </>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-top: 2px solid var(--color-ink);
  }

  .track {
    display: flex;
    width: max-content;
    animation: tickerMove 28s linear infinite;
  }

  .group {
    display: flex;
    align-items: center;
    gap: 26px;
    padding: 14px 26px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
</style>
