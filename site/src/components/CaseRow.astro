---
// Строка проекта: номер, задача, ключевая цифра и переход к подробностям.
import type { CaseTeaser } from '../data/cases';

type Props = CaseTeaser;
const { pos, title, fact, digit, unit, href } = Astro.props;
---

<a class="case" href={href}>
  <span class="pos">{pos}<br /><span class="pos-u">поз.</span></span>
  <span class="what">
    <span class="title">{title}</span>
    <span class="fact">{fact}</span>
  </span>
  <span class="digit">
    <span class="n">{digit}</span>
    <span class="u">{unit}</span>
  </span>
  <span class="go" aria-hidden="true">→</span>
</a>

<style>
  .case {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) minmax(220px, 0.5fr) 64px;
    align-items: baseline;
    gap: 20px;
    padding: 20px var(--spacing-gutter) 22px;
    text-decoration: none;
    color: inherit;
    border-top: 1px solid var(--color-rule-soft);
  }
  .pos {
    font: 400 13px / 1.4 var(--font-mono);
    letter-spacing: 0.06em;
  }
  .pos-u {
    color: var(--color-aux);
    font-size: 11px;
  }
  .title {
    display: block;
    font: 500 clamp(18px, 1.8vw, 26px) / 1.25 var(--font-text);
    transition: color 0.15s;
  }
  .fact {
    display: block;
    font: 400 13px / 1.55 var(--font-text);
    color: var(--color-aux);
    margin-top: 6px;
    max-width: 56ch;
  }
  .digit {
    text-align: right;
  }
  .digit .n {
    display: block;
    font: 800 var(--text-digit) / 1 var(--font-display);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    transition: color 0.15s;
  }
  .digit .u {
    display: block;
    margin-top: 6px;
    font: 400 11px / 1.5 var(--font-mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-aux);
  }
  .go {
    font: 400 22px / 1 var(--font-mono);
    color: var(--color-aux);
    text-align: right;
    transition:
      color 0.15s,
      transform 0.15s;
  }
  .case:hover .title,
  .case:hover .n {
    color: var(--color-sign);
  }
  .case:hover .go {
    color: var(--color-sign);
    transform: translateX(4px);
  }
  .case:focus-visible {
    outline: 2px solid var(--color-sign);
    outline-offset: -2px;
  }
  @media (max-width: 760px) {
    .case {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'pos pos' 'what digit';
      row-gap: 12px;
    }
    .pos {
      grid-area: pos;
    }
    .what {
      grid-area: what;
    }
    .digit {
      grid-area: digit;
    }
    .go {
      display: none;
    }
  }
</style>
