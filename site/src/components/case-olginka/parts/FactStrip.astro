---
/**
 * Полоса фактов объекта: крупное число, единица измерения подписью сверху,
 * кикер снизу. Главный типографический приём проекта — единица уходит наверх
 * мелким начертанием, чтобы число оставалось главным.
 *
 * Разделители — волосяные линейки, а не карточки: в этом проекте карточек нет
 * вообще, весь ритм держат border-y.
 */
interface Props {
  /** text: значение не число («От собственника») — кегль мельче, счётчик не вешаем. */
  items: { value: string; unit?: string; label: string; text?: boolean }[];
  tone?: 'light' | 'dark';
  /** Числа сцены 2 доезжают счётчиком; в разобранном виде (сцена 6) — нет. */
  countUp?: boolean;
  size?: 'lg' | 'md';
}

const { items, tone = 'light', countUp = false, size = 'lg' } = Astro.props;
---

<div class:list={['fact-strip', `tone-${tone}`, `size-${size}`]} data-reveal-group>
  {items.map((item) => (
    <article class:list={[item.text && 'is-text']}>
      <strong>
        <span data-countup={countUp && !item.text ? '' : undefined}>{item.value}</span>
        {item.unit && <span class="p-unit">{item.unit}</span>}
      </strong>
      <span class="p-kicker">{item.label}</span>
    </article>
  ))}
</div>

<style>
  .fact-strip {
    display: grid;
    grid-template-columns: repeat(var(--strip-cols, 4), minmax(0, 1fr));
    border-block: 1px solid var(--strip-line);
  }

  .tone-light {
    --strip-line: rgb(33 27 20 / 0.15);
    --strip-muted: rgb(33 27 20 / 0.55);
    color: var(--p-ink);
  }

  .tone-dark {
    --strip-line: rgb(244 238 227 / 0.18);
    --strip-muted: rgb(244 238 227 / 0.55);
    color: var(--p-paper);
  }

  /* Колонка с прижатым к низу кикером: длинное текстовое значение может
     занять две строки, но подписи по ряду всё равно стоят на одной линии. */
  .fact-strip article {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    padding: clamp(22px, 3vw, 38px) clamp(14px, 2vw, 28px);
  }

  .fact-strip article + article {
    border-left: 1px solid var(--strip-line);
  }

  /* Число и единица держатся одной строкой: перенос ломает и приём
     («м²» наверху при цифре), и выравнивание кикеров по ряду. */
  .fact-strip strong {
    display: block;
    font-family: var(--font-project);
    font-size: clamp(28px, 3.6vw, 56px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }

  .size-md strong {
    font-size: clamp(24px, 2.6vw, 36px);
  }

  /* Текстовый факт стоит в одном ряду с числами, но не спорит с ними
     кеглем: по смыслу он вывод, а не показатель. */
  .fact-strip .is-text strong {
    font-size: clamp(19px, 1.8vw, 24px);
    white-space: normal;
    text-wrap: balance;
  }

  .fact-strip .p-unit {
    color: var(--strip-muted);
    font-family: var(--font-mono);
  }

  .fact-strip .p-kicker {
    margin-top: auto;
    padding-top: 14px;
    color: var(--strip-muted);
  }

  @media (max-width: 900px) {
    .fact-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fact-strip article:nth-child(odd) {
      border-left: 0;
    }

    .fact-strip article:nth-child(n + 3) {
      border-top: 1px solid var(--strip-line);
    }
  }

  @media (max-width: 460px) {
    .fact-strip {
      grid-template-columns: minmax(0, 1fr);
    }

    .fact-strip article + article {
      border-left: 0;
      border-top: 1px solid var(--strip-line);
    }
  }
</style>
