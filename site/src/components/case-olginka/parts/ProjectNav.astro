---
/**
 * Навигация объекта, пересобранная нативно: логотип-адрес слева, разделы
 * посередине, телефон справа. На живом сайте она прозрачная над hero и
 * уплотняется при скролле — в кейсе показываем оба состояния: прозрачное
 * в сцене 1, плотное — в сцене 6, где интерфейс разобран на части.
 */
interface Props {
  state?: 'transparent' | 'scrolled';
  phone?: string;
  /** Узкая колонка сцены интерфейса: тот же состав, но плотнее набор. */
  compact?: boolean;
}

const { state = 'transparent', phone = '+7 911 966-51-99', compact = false } = Astro.props;

const links = ['Объект', 'Документы', 'Локация', 'Галерея'];
---

<div class:list={['p-nav', `is-${state}`, compact && 'is-compact']} aria-hidden="true">
  <span class="p-nav__brand">Приморская&nbsp;22А</span>
  <nav class="p-nav__links">
    {links.map((link) => <span>{link}</span>)}
  </nav>
  <span class="p-nav__phone">{phone}</span>
</div>

<style>
  .p-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    box-sizing: border-box;
    width: 100%;
    padding: 20px clamp(20px, 4vw, 44px);
    color: var(--p-paper);
    font-family: var(--font-project);
  }

  .is-scrolled {
    background: rgb(12 9 16 / 0.9);
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 30px rgb(8 6 12 / 0.35);
  }

  .p-nav__brand {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .p-nav__links {
    display: flex;
    gap: clamp(18px, 2.4vw, 34px);
    color: rgb(244 238 227 / 0.72);
    font-size: 14px;
  }

  .p-nav__phone {
    color: rgb(244 238 227 / 0.9);
    font-size: 14px;
    white-space: nowrap;
  }

  /* Полоса стоит в правой колонке сцены интерфейса и обязана поместиться в неё
     целиком: обрезанный телефон справа читается как сломанная вёрстка. */
  .is-compact {
    gap: 16px;
    padding: 14px 18px;
  }

  .is-compact .p-nav__brand {
    font-size: 13px;
  }

  .is-compact .p-nav__links {
    gap: clamp(12px, 1.4vw, 20px);
    font-size: 12px;
  }

  .is-compact .p-nav__phone {
    font-size: 12px;
  }

  @media (max-width: 860px) {
    .p-nav__links {
      display: none;
    }
  }
</style>
