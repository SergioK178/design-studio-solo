---
/**
 * Глифы кейса «Ольгинка» — контурная линия в один вес, как на `9.png`
 * из поставки владельца.
 *
 * Остальные восемь исходников пришли неоновыми рендерами: свечение впечено в
 * штрих, яркость заливки внутри фигуры равна яркости самого контура, и ни один
 * порог не отделяет одно от другого — на 24 px они превращались в пятно.
 * Поэтому те же сюжеты нарисованы вектором: значок остаётся резким на любом
 * кегле, красится currentColor и ничего не весит.
 *
 * Если владелец переэкспортирует плоские PNG, вернуть растр можно точечно —
 * разметка принимает имя, а не путь.
 */
interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['p-icon', className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  {name === 'self' && (
    <>
      <circle cx="12" cy="8" r="4.2" />
      <path d="M5 20.5a7 7 0 0 1 14 0" />
    </>
  )}

  {name === 'owner' && (
    <>
      <circle cx="12" cy="8" r="4.2" />
      <path d="M4.6 20.5a7.4 7.4 0 0 1 14.8 0Z" />
    </>
  )}

  {name === 'chart' && (
    <>
      <path d="M3.5 20.5h17" />
      <path d="M6 20.5v-4a1.2 1.2 0 0 1 1.2-1.2h.6A1.2 1.2 0 0 1 9 16.5v4" />
      <path d="M11.4 20.5v-6.6a1.2 1.2 0 0 1 1.2-1.2h.6a1.2 1.2 0 0 1 1.2 1.2v6.6" />
      <path d="M16.8 20.5v-9.6a1.2 1.2 0 0 1 1.2-1.2h.6a1.2 1.2 0 0 1 1.2 1.2v9.6" />
      <path d="M4 12.6c4.6-.9 9.6-3.9 12.9-8.6" />
      <path d="M12.6 3.6h4.6v4.6" />
    </>
  )}

  {name === 'area' && (
    <>
      <rect x="3.5" y="8" width="12" height="11.5" rx="2.4" />
      <path d="M3.5 4.2h12" />
      <path d="M3.5 2.8v2.8M15.5 2.8v2.8" />
      <path d="M20.2 8v11.5" />
      <path d="M18.8 8h2.8M18.8 19.5h2.8" />
    </>
  )}

  {name === 'view' && (
    <>
      <circle cx="17.2" cy="6.6" r="2.6" />
      <path d="M2.6 17.4h18.8" />
      <path d="M3.6 17.4 9.4 9.6l4 5.2" />
      <path d="M12.2 15.4 15.6 11l5.8 6.4" />
      <path d="M7.4 20.2h9.2" />
    </>
  )}

  {name === 'pin' && (
    <>
      <path d="M12 21.4c4.3-4.6 6.6-8.1 6.6-11a6.6 6.6 0 1 0-13.2 0c0 2.9 2.3 6.4 6.6 11Z" />
      <circle cx="12" cy="10.2" r="2.5" />
    </>
  )}

  {name === 'rooms' && (
    <>
      <path d="M4.6 4.4 12.6 2.6v18.8L4.6 19.6Z" />
      <path d="M12.6 5.4h6.6v13.2h-6.6" />
      <path d="M19.2 18.6v2.8" />
      <circle cx="10.4" cy="12" r="0.95" fill="currentColor" stroke="none" />
    </>
  )}

  {name === 'lock' && (
    <>
      <rect x="4.8" y="10" width="14.4" height="11" rx="3" />
      <path d="M8.4 10V7.4a3.6 3.6 0 0 1 7.2 0V10" />
      <circle cx="12" cy="14.4" r="1.7" />
      <path d="M12 16.1v2.4" />
    </>
  )}

  {name === 'list' && (
    <>
      <circle cx="5" cy="6.6" r="1.5" />
      <circle cx="5" cy="12" r="1.5" />
      <circle cx="5" cy="17.4" r="1.5" />
      <path d="M9.6 6.6h9.4M9.6 12h9.4M9.6 17.4h9.4" />
    </>
  )}

  {name === 'phone' && (
    <path d="M8.1 3.6 9.9 8 8.1 9.9a12 12 0 0 0 6 6l1.9-1.8 4.4 1.8v3.3a1.8 1.8 0 0 1-2 1.8C10.3 20.4 3.6 13.7 2.8 5.6a1.8 1.8 0 0 1 1.8-2Z" />
  )}

  {name === 'search' && (
    <>
      <circle cx="10.6" cy="10.6" r="6.8" />
      <path d="M15.6 15.6 21 21" />
    </>
  )}

  {name === 'send' && (
    <>
      <path d="M21 3 2.8 10.4l7.6 3.2L21 3Z" />
      <path d="M21 3 10.4 13.6l3.2 7.6L21 3Z" />
    </>
  )}

  {name === 'shield' && (
    <>
      <path d="M12 2.6 4.6 5.6v6.1c0 4.4 3 8.2 7.4 9.7 4.4-1.5 7.4-5.3 7.4-9.7V5.6Z" />
      <path d="m8.9 11.9 2.2 2.3 4-4.4" />
    </>
  )}
</svg>
