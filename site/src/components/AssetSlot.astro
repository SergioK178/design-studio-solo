---
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';
import { assetManifestById } from '../data/asset-manifest';

interface Props {
  /** Ключ ассета — id в site/src/data/asset-manifest.ts, используется и как диагностическая метка. */
  label: string;
  src?: string;
  /** Содержательный alt для реального изображения. Обязателен, когда передан src. */
  alt?: string;
  tone?: 'light' | 'dark';
  ratio?: string;
  /** Browser/device frame contract (design-system.md §4): browser chrome, slim device strap, или без рамки для full-bleed медиа. */
  frame?: 'browser' | 'mobile' | 'telegram' | 'plain';
  caption?: string;
  /** Домен в адресной строке browser-рамки. Без него полоса остаётся пустой. */
  url?: string;
  /** Нейтральный preview для editorial-кейса до поставки реального ассета. */
  schematic?: boolean;
  /** Ассет первого экрана: грузим сразу, без lazy. */
  priority?: boolean;
}

const PUBLIC_ASSETS = fileURLToPath(new URL('../../public/assets/', import.meta.url));
const ASSET_EXTENSIONS = ['avif', 'webp', 'png', 'jpg'];
const resolvedCache = new Map<string, string | undefined>();

/**
 * Ищет реальный файл по ключу ассета в public/assets. Пока файла нет — слот показывает
 * «asset pending»; как только файл положили, он появляется сам, без правок разметки.
 *
 * Ищем только ключи из манифеста: под works/<slug>/ лежат и ассеты слотов, и мелкие иконки
 * meta-полосы с совпадающими именами (works/car-rental/hero.webp — иконка 240px, а не hero).
 * Манифест здесь и есть контракт, что ключ — полноразмерный ассет слота.
 */
function resolveAsset(key: string): string | undefined {
  if (resolvedCache.has(key)) return resolvedCache.get(key);
  const declared = Boolean(assetManifestById[key]);
  const found = declared
    ? ASSET_EXTENSIONS.map((ext) => `${key}.${ext}`).find((name) => fs.existsSync(`${PUBLIC_ASSETS}${name}`))
    : undefined;
  const url = found ? `/assets/${found}` : undefined;
  resolvedCache.set(key, url);
  return url;
}

const { label, src, alt, tone = 'light', ratio, frame = 'browser', caption, url, schematic = false, priority = false } = Astro.props;
const manifestEntry = assetManifestById[label];
const resolvedRatio = ratio ?? manifestEntry?.ratio ?? '16 / 10';
const resolvedSrc = src || resolveAsset(label) || '';
const resolvedAlt = alt ?? caption ?? label;
// Посетителю не показываем «asset pending» и сырые ключи: без файла слот исчезает.
// В dev заглушка остаётся как диагностика.
const hidden = !resolvedSrc && !schematic && !import.meta.env.DEV;

if (import.meta.env.DEV && src && !alt) {
  console.warn(`[AssetSlot] "${label}": передан src без содержательного alt.`);
}
---

{!hidden && <figure class="asset-slot-figure">
  <div class:list={['asset-slot', `tone-${tone}`, `frame-${frame}`, resolvedSrc && 'has-src', schematic && 'is-schematic']} style={`--asset-ratio: ${resolvedRatio}`}>
    {/* Шапка браузера — разметкой, а не псевдоэлементом: в ней живёт адресная
        строка, и три точки в пустой полосе перестают быть единственным
        признаком окна. */}
    {frame === 'browser' && (
      <div class="chrome" aria-hidden="true">
        <span class="chrome-dots"><i></i><i></i><i></i></span>
        <span class="chrome-bar">{url}</span>
      </div>
    )}
    {resolvedSrc ?<img src={resolvedSrc} alt={resolvedAlt} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} /> : (
      <div class="pending" aria-label={schematic ? label : `${label}: asset pending`}>
        {schematic ? <div class="schematic" aria-hidden="true"><i></i><i></i><i></i><i></i></div> : <><span class="mono">asset pending</span><strong>{label}</strong></>}
      </div>
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>}

<style>
  .asset-slot-figure {
    margin: 0;
  }

  .asset-slot {
    position: relative;
    aspect-ratio: var(--asset-ratio);
    overflow: hidden;
    border: 1px solid rgb(23 21 15 / 0.16);
    background: white;
    --chrome-h: 34px;
  }

  /* Окно чуть отделено от бумаги: мягкая тень вместо толстой рамки. */
  .frame-browser {
    box-shadow: 0 16px 36px rgb(23 21 15 / 0.08);
  }

  .frame-plain {
    --chrome-h: 0px;
  }

  .frame-mobile,
  .frame-telegram {
    --chrome-h: 18px;
  }

  /* Шапка окна: точки слева, адресная строка по центру-слева. Пропорции сняты
     с настоящего браузера — точка 8px, пилюля на 4px ниже полосы. */
  .chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    box-sizing: border-box;
    height: var(--chrome-h);
    border-bottom: 1px solid rgb(23 21 15 / 0.14);
    padding-inline: 12px;
    background: linear-gradient(180deg, #fff 0%, color-mix(in srgb, var(--color-paper) 88%, white) 100%);
  }

  .chrome-dots {
    display: flex;
    flex: none;
    gap: 6px;
  }

  .chrome-dots i {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgb(23 21 15 / 0.16);
  }

  .chrome-dots i:first-child {
    background: rgb(23 21 15 / 0.24);
  }

  .chrome-dots i:last-child {
    background: rgb(23 21 15 / 0.11);
  }

  .chrome-bar {
    box-sizing: border-box;
    flex: 1;
    max-width: 44%;
    min-width: 0;
    overflow: hidden;
    border-radius: 999px;
    padding: 4px 12px;
    background: rgb(23 21 15 / 0.055);
    color: rgb(23 21 15 / 0.46);
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: calc(var(--chrome-h) - 16px);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .asset-slot.frame-mobile::before,
  .asset-slot.frame-telegram::before {
    content: '';
    display: block;
    height: var(--chrome-h);
    border-bottom: 1.5px solid rgb(23 21 15 / 0.18);
    background: var(--color-paper);
  }

  .asset-slot.frame-mobile::after,
  .asset-slot.frame-telegram::after {
    content: '';
    position: absolute;
    top: 6px;
    left: 50%;
    width: 34px;
    height: 4px;
    transform: translateX(-50%);
    background: rgb(23 21 15 / 0.22);
  }

  .tone-dark {
    border-color: rgb(244 242 236 / 0.24);
    background: var(--color-ink-soft);
    color: var(--color-paper);
  }

  .tone-dark .chrome {
    border-bottom-color: rgb(244 242 236 / 0.14);
    background: linear-gradient(180deg, var(--color-ink-soft) 0%, var(--color-ink) 100%);
  }

  .tone-dark .chrome-dots i {
    background: rgb(244 242 236 / 0.26);
  }

  .tone-dark .chrome-dots i:first-child {
    background: rgb(244 242 236 / 0.38);
  }

  .tone-dark .chrome-dots i:last-child {
    background: rgb(244 242 236 / 0.16);
  }

  .tone-dark .chrome-bar {
    background: rgb(244 242 236 / 0.08);
    color: rgb(244 242 236 / 0.5);
  }

  .tone-dark.frame-mobile::before,
  .tone-dark.frame-telegram::before {
    border-bottom-color: rgb(244 242 236 / 0.18);
    background: var(--color-ink);
  }

  .tone-dark.frame-mobile::after,
  .tone-dark.frame-telegram::after {
    background: rgb(244 242 236 / 0.3);
  }

  img,
  .pending {
    width: 100%;
    height: calc(100% - var(--chrome-h));
  }

  img {
    display: block;
    object-fit: cover;
  }

  .pending {
    display: grid;
    place-content: center;
    gap: 10px;
    padding: 24px;
    box-sizing: border-box;
    text-align: center;
    background:
      linear-gradient(135deg, rgb(229 164 59 / 0.16) 25%, transparent 25%) 0 0 / 18px 18px,
      linear-gradient(135deg, transparent 75%, rgb(39 67 224 / 0.1) 75%) 0 0 / 18px 18px,
      color-mix(in srgb, var(--color-paper) 86%, white);
  }

  .tone-dark .pending {
    background:
      linear-gradient(135deg, rgb(229 164 59 / 0.18) 25%, transparent 25%) 0 0 / 18px 18px,
      linear-gradient(135deg, transparent 75%, rgb(244 242 236 / 0.07) 75%) 0 0 / 18px 18px,
      var(--color-ink-soft);
  }

  .pending .mono {
    color: var(--color-blue-legacy);
    font-size: 10px;
  }

  .tone-dark .pending .mono {
    color: var(--color-gold);
  }

  .pending strong {
    max-width: 24ch;
    color: currentColor;
    font-family: var(--font-display);
    font-size: clamp(16px, 2vw, 22px);
    line-height: 1.2;
  }

  .is-schematic .pending {
    place-content: stretch;
    padding: clamp(16px, 3vw, 36px);
    background: color-mix(in srgb, var(--color-paper) 88%, white);
  }

  .schematic {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    grid-template-rows: 0.15fr 1fr 0.18fr;
    gap: clamp(10px, 1.8vw, 22px);
    width: 100%;
    height: 100%;
  }

  .schematic i {
    display: block;
    background: rgb(23 21 15 / 0.08);
  }

  .schematic i:nth-child(1) { grid-column: 1 / -1; background: rgb(23 21 15 / 0.14); }
  .schematic i:nth-child(2) { background: linear-gradient(180deg, rgb(23 21 15 / 0.12) 0 24%, transparent 24% 42%, rgb(23 21 15 / 0.08) 42% 55%, transparent 55%); }
  .schematic i:nth-child(3) { background: linear-gradient(145deg, rgb(23 21 15 / 0.15), rgb(23 21 15 / 0.04)); }
  .schematic i:nth-child(4) { grid-column: 1 / -1; }

  .frame-mobile .schematic { grid-template-columns: 1fr; grid-template-rows: 0.14fr 1fr 0.2fr; }
  .frame-mobile .schematic i:nth-child(3) { display: none; }

  figcaption {
    margin-top: 10px;
    color: rgb(23 21 15 / 0.62);
    font-size: 13.5px;
    line-height: 1.5;
  }
</style>
